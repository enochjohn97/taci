{# Base Layout Template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="TACI Petroleum - Fuel Station Management System">
    
    <title>{% block title %}TACI Petroleum - Management System{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    {% block styles %}{% endblock %}
</head>
<body>
    <!-- Navigation Bar -->
    {% include 'components/navbar.html.twig' %}
    
    <div class="d-flex">
        <!-- Sidebar -->
        {% include 'components/sidebar.html.twig' %}
        
        <!-- Main Content -->
        <main class="flex-grow-1" id="main-content">
            <!-- Alerts -->
            {% include 'components/alerts.html.twig' %}
            
            <!-- Page Content -->
            {% block content %}{% endblock %}
        </main>
    </div>
    
    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2026 TACI Petroleum Company Limited. All Rights Reserved.</p>
        <p class="text-muted"><small>Built for Excellence.</small></p>
    </footer>
    
    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script src="{{ asset('js/app.js') }}"></script>
    
    {% block scripts %}{% endblock %}
</body>
</html>
