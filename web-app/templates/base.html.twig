{# Base Layout Template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="TACI Petroleum - Fuel Station Management System">
    <meta name="theme-color" content="#1f2937">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="TACI Petroleum">
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/icon-192x192.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/icon-192x192.png') }}">
    
    <title>{% block title %}TACI Petroleum - Management System{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    {% block styles %}{% endblock %}
</head>
<body>
    {% if app.user %}
        <!-- Navigation Bar -->
        {% include 'includes/navbar.html.twig' %}
        
        <div class="d-flex">
            <!-- Sidebar -->
            {% include 'includes/sidebar.html.twig' %}
            
            <!-- Main Content -->
            <main class="flex-grow-1" id="main-content">
                <!-- Alerts -->
                {% include 'includes/alerts.html.twig' %}
                
                <!-- Page Content -->
                {% block content %}{% endblock %}
            </main>
        </div>
    {% else %}
        <main class="flex-grow-1" id="main-content">
            {% include 'includes/alerts.html.twig' %}
            {% block content %}{% endblock %}
        </main>
    {% endif %}
    
    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2026 TACI Petroleum Company Limited. All Rights Reserved.</p>
        <p class="text-muted"><small>Built for Excellence.</small></p>
    </footer>
    
    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- User Context (for PWA) -->
    {% if app.user %}
    <script>
        window.userRoles = {{ app.user.roles|json_encode|raw }};
    </script>
    {% endif %}
    
    <!-- Custom JS -->
    <script src="{{ asset('js/app.js') }}"></script>
    
    <!-- PWA Initialization (Admin/SubAdmin only) -->
    {% if app.user and ('ROLE_SUPER_ADMIN' in app.user.roles or 'ROLE_SUB_ADMIN' in app.user.roles) %}
    <script src="{{ asset('js/pwa-init.js') }}"></script>
    {% endif %}
    
    {% block scripts %}{% endblock %}
</body>
</html>
