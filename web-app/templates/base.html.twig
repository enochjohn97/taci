{# Base Layout Template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ app_name }} - Fuel Station Management System">
    <meta name="theme-color" content="#1f2937">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/icon-192x192.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/icon-192x192.png') }}">
    
    <title>{% block title %}{{ app_name }} - Management System{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Tailwind (CDN for rapid prototyping) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js for UI interactivity -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Design System CSS -->
    <style>
        :root {
            /* === Sidebar === */
            --sidebar-width: 280px;
            --sidebar-collapsed-width: 80px;

            /* === Typography === */
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;

            /* === Brand Colors === */
            --primary: #0d9488;
            --primary-dark: #0f766e;
            --accent: #F5A623;

            /* === Backgrounds === */
            --bg-page: #F8FAFE;
            --bg-card: #ffffff;
            --bg-dark: #f6f9fc;
            --card-bg: #ffffff;

            /* === Text === */
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-light: #94a3b8;

            /* === Border & Shadow === */
            --border-color: #e2e8f0;
            --shadow-card: 0 4px 24px rgba(15,23,42,0.07);
            --shadow-hover: 0 8px 32px rgba(15,23,42,0.13);

            /* === Radius === */
            --radius-card: 1.25rem;
            --radius-sm: 0.75rem;

            /* === Spacing === */
            --spacing-page: 1.75rem;

            /* === Status Colors === */
            --color-success: #10b981;
            --color-warning: #f59e0b;
            --color-danger:  #ef4444;
            --color-info:    #3b82f6;

            /* === Fuel Type Colors === */
            --fuel-premium: #F5A623;
            --fuel-diesel:  #0D9488;
            --fuel-regular: #3B82F6;

            /* === Default Sidebar (fallback) === */
            --sidebar-bg: #0A192F;
            --sidebar-text: rgba(255,255,255,0.75);
            --sidebar-active-bg: rgba(255,255,255,0.12);
            --sidebar-active-text: #ffffff;
            --sidebar-accent: #0d9488;
        }

        /* Dark mode overrides */
        [data-theme="dark"] {
            --bg-page:    #0f172a;
            --bg-card:    #1e293b;
            --card-bg:    #1e293b;
            --text-main:  #f1f5f9;
            --text-muted: #94a3b8;
            --text-light: #64748b;
            --border-color: #334155;
            --shadow-card: 0 4px 24px rgba(0,0,0,0.3);
        }

        /* === Role-based sidebar colors === */
        body.role-super-admin {
            --primary: #0d9488; --primary-dark: #0f766e;
            --sidebar-bg: #0A192F;
            --sidebar-text: rgba(255,255,255,0.75);
            --sidebar-active-bg: rgba(255,255,255,0.12);
            --sidebar-active-text: #ffffff;
            --sidebar-accent: #0d9488;
        }
        body.role-sub-admin {
            --primary: #1d4ed8; --primary-dark: #1e40af;
            --sidebar-bg: #D0E8FF;
            --sidebar-text: rgba(10,25,47,0.70);
            --sidebar-active-bg: rgba(10,25,47,0.10);
            --sidebar-active-text: #0A192F;
            --sidebar-accent: #1d4ed8;
        }
        body.role-manager {
            --primary: #047857; --primary-dark: #064e3b;
            --bg-page: #ecfdf5;
            --sidebar-bg: #022c22;
            --sidebar-text: rgba(255,255,255,0.8);
            --sidebar-active-bg: rgba(255,255,255,0.15);
            --sidebar-active-text: #ffffff;
            --sidebar-accent: #10b981;
        }
        body.role-staff {
            --primary: #6B2E4A; --primary-dark: #5a2740;
            --sidebar-bg: #6B2E4A;
            --sidebar-text: rgba(255,255,255,0.75);
            --sidebar-active-bg: rgba(255,255,255,0.12);
            --sidebar-active-text: #ffffff;
            --sidebar-accent: #fda4af;
        }
        
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-page);
            color: var(--text-main);
            transition: background-color 0.3s ease, color 0.3s ease;
            margin: 0;
        }

        /* Fix for Tailwind CSS overriding Bootstrap collapse visibility */
        .collapse.show {
            visibility: visible !important;
        }

        /* ============================================================
           APP SHELL LAYOUT
           ============================================================ */
        .app-shell {
            display: flex;
            min-height: 100vh;
        }

        #main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            min-width: 0;
            overflow: hidden;
        }

        #main-content {
            flex: 1;
            padding: var(--spacing-page);
            overflow-x: hidden;
            /* reserve space for footer */
            padding-bottom: calc(var(--spacing-page) + 64px);
        }

        /* Footer positioned at bottom of main area, spans remaining width after sidebar */
        .app-footer {
            position: fixed;
            bottom: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-card);
            border-top: 1px solid var(--border-color);
            padding: 0 1.25rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            z-index: 5;
        }

        /* when sidebar is collapsed, shift footer left accordingly */
        #main-wrapper.sidebar-is-collapsed ~ .app-footer, .app-footer {
            left: var(--sidebar-width);
        }

        #main-wrapper.sidebar-is-collapsed .app-footer, .sidebar-is-collapsed .app-footer {
            left: var(--sidebar-collapsed-width);
        }

        @media (max-width: 768px) {
            .app-footer { left: 0; }
        }

        /* ============================================================
           APP SIDEBAR BASE
           ============================================================ */
        .app-sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            position: fixed;
            left: 0; top: 0; bottom: 0;
            z-index: 300;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            background: var(--sidebar-bg, #0A192F);
        }

        .app-sidebar.collapsed { width: var(--sidebar-collapsed-width); }

        .card {
            background: var(--card-bg);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
            color: var(--text-main);
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-2px);
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
        }

        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border-color);
            padding: 1.125rem 1.5rem;
            border-radius: var(--radius-card) var(--radius-card) 0 0 !important;
            font-weight: 600;
        }

        .card-body { padding: 1.5rem; }

        /* KPI Cards */
        .kpi-card {
            border-radius: var(--radius-card);
            border: none;
            position: relative;
            overflow: hidden;
        }

        .kpi-card .kpi-strip {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            border-radius: 0 0 var(--radius-card) var(--radius-card);
        }

        .kpi-card .kpi-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .kpi-card .kpi-value {
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.1;
        }

        .kpi-card .kpi-label {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .kpi-card .kpi-change {
            font-size: 0.78rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 99px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .kpi-change.up   { background: rgba(16,185,129,0.12); color: #059669; }
        .kpi-change.down { background: rgba(239,68,68,0.12);  color: #dc2626; }

        .sparkline-wrap { height: 44px; margin-top: 0.5rem; }
        .sparkline-wrap canvas { width: 100% !important; height: 44px !important; }

        /* ============================================================
           PULSE DOT
           ============================================================ */
        .pulse-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--color-success);
            position: relative;
        }

        .pulse-dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid var(--color-success);
            animation: pulse-ring 1.6s ease-out infinite;
            opacity: 0;
        }

        @keyframes pulse-ring {
            0%   { transform: scale(0.7); opacity: 0.8; }
            100% { transform: scale(1.8); opacity: 0; }
        }

        /* ============================================================
           PUMP STATUS
           ============================================================ */
        .pump-card {
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--border-color);
            background: var(--bg-card);
            padding: 0.9rem 1rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .pump-card.fueling {
            border-color: var(--color-success);
            box-shadow: 0 0 0 3px rgba(16,185,129,0.12);
        }

        .pump-card.blocked {
            border-color: var(--color-danger);
            box-shadow: 0 0 0 3px rgba(239,68,68,0.1);
        }

        .pump-status-badge {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            padding: 3px 10px;
            border-radius: 99px;
            text-transform: uppercase;
        }

        .pump-status-badge.idle     { background: #f1f5f9; color: #64748b; }
        .pump-status-badge.fueling  { background: rgba(16,185,129,0.15); color: #059669; }
        .pump-status-badge.blocked  { background: rgba(239,68,68,0.12);  color: #dc2626; }

        .fueling-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--color-success);
            margin-right: 4px;
            animation: pump-pulse 1.2s ease-in-out infinite;
        }

        @keyframes pump-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.4; transform: scale(0.7); }
        }

        /* ============================================================
           TASK LIST
           ============================================================ */
        .task-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.875rem;
        }

        .task-item:last-child { border-bottom: none; }
        .task-item.done { text-decoration: line-through; color: var(--text-muted); }

        /* ============================================================
           STICKY NOTES
           ============================================================ */
        .sticky-note {
            background: #fffde7;
            border-left: 4px solid var(--fuel-premium);
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
            color: #5d4037;
            margin-bottom: 0.75rem;
            box-shadow: 2px 3px 8px rgba(0,0,0,0.07);
        }

        .sticky-note.hot {
            border-left-color: var(--color-danger);
            background: #fff3f3;
            color: #7f1d1d;
        }

        [data-theme="dark"] .sticky-note     { background: #2a2500; color: #fde68a; }
        [data-theme="dark"] .sticky-note.hot { background: #3b0d0d; color: #fca5a5; }

        /* ============================================================
           SHIFT CHAT LOG
           ============================================================ */
        .chat-log {
            max-height: 220px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            padding: 0.5rem 0;
        }

        .chat-bubble {
            max-width: 80%;
            padding: 0.55rem 0.9rem;
            border-radius: 1rem;
            font-size: 0.83rem;
            line-height: 1.4;
        }

        .chat-bubble.manager {
            background: #e0f2fe;
            color: #0c4a6e;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }

        .chat-bubble.staff {
            background: #dcfce7;
            color: #14532d;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }

        [data-theme="dark"] .chat-bubble.manager { background: #1e3a4e; color: #bae6fd; }
        [data-theme="dark"] .chat-bubble.staff   { background: #1a3a24; color: #bbf7d0; }

        /* ============================================================
           ALERT BANNERS
           ============================================================ */
        .alert-sensor-offline {
            background: rgba(239,68,68,0.08);
            border: 1.5px solid rgba(239,68,68,0.3);
            border-radius: var(--radius-sm);
            color: #dc2626;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        /* ============================================================
           STARS & ZONE TABLE
           ============================================================ */
        .star-rating { color: var(--fuel-premium); font-size: 0.85rem; letter-spacing: 1px; }

        .zone-table td, .zone-table th {
            padding: 0.6rem 0.75rem;
            font-size: 0.875rem;
            vertical-align: middle;
            border-color: var(--border-color);
        }

        .zone-bar {
            height: 6px;
            border-radius: 99px;
            background: var(--border-color);
            overflow: hidden;
        }

        .zone-bar-fill {
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, var(--fuel-diesel), var(--fuel-premium));
        }

        /* ============================================================
           PROGRESS / BADGES / BUTTONS
           ============================================================ */
        .progress { border-radius: 99px; background: var(--border-color); }
        .progress-bar { border-radius: 99px; }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .text-muted  { color: var(--text-muted) !important; }
        .badge { font-weight: 600; letter-spacing: 0.02em; }

        .btn {
            font-weight: 500;
            border-radius: 0.6rem;
            transition: all 0.18s ease;
        }
        .btn:hover  { transform: translateY(-1px); }
        .btn:active { transform: none; }

        /* ============================================================
           TOP NAVBAR
           ============================================================ */
        .top-navbar {
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0 var(--spacing-page);
            position: sticky;
            top: 0;
            z-index: 200;
            backdrop-filter: blur(8px);
            background: rgba(255,255,255,0.88);
            border-bottom: 1px solid var(--border-color);
        }

        [data-theme="dark"] .top-navbar {
            background: rgba(22,27,34,0.92);
        }

        /* ============================================================
           SIDEBAR OVERLAY (mobile)
           ============================================================ */
        #sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 299;
            backdrop-filter: blur(2px);
        }

        /* ============================================================
           SCROLLBAR
           ============================================================ */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-light); }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 768px) {
            #main-wrapper { margin-left: 0 !important; }

            #app-sidebar {
                position: fixed;
                left: 0; top: 0; bottom: 0;
                z-index: 300;
                transform: translateX(-100%);
                width: var(--sidebar-width) !important;
            }

            #app-sidebar.mobile-open { transform: translateX(0); }
            #sidebar-overlay.active  { display: block; }
            #main-content { padding: 1rem; }
        }

        @media (min-width: 769px) {
            #app-sidebar.collapsed { width: var(--sidebar-collapsed-width) !important; }
            #main-wrapper.sidebar-is-collapsed { margin-left: var(--sidebar-collapsed-width); }
        }
    </style>

{% block extra_scripts %}{% endblock %}

<script>
// Real-time subscription via Mercure (if hub is configured)
{% if app.user %}
(function(){
    const mercureUrl = '{{ mercure_public_url|default("") }}';
    if (!mercureUrl) return; // Skip if Mercure not configured
    const userTopic = 'notifications/{{ app.user.id }}';
    try {
        const url = new URL(mercureUrl);
        url.searchParams.append('topic', userTopic);
        const es = new EventSource(url.toString(), { withCredentials: false });

        es.onmessage = function(e) {
            try {
                const payload = JSON.parse(e.data);

                // If it's a read-acknowledgement, just decrement badge
                if (payload.action === 'marked_read') {
                    const badge = document.querySelector('.nb-badge');
                    if (badge) {
                        const current = Math.max(0, (parseInt(badge.textContent) || 1) - 1);
                        badge.textContent = current > 0 ? current.toString() : '';
                        if (current === 0) badge.style.display = 'none';
                    }
                    return;
                }

                // Increment badge
                const badgeContainer = document.getElementById('nav-notification-badge-container');
                if (badgeContainer) {
                    let badge = badgeContainer.querySelector('.nb-badge');
                    if (!badge) {
                        badge = document.createElement('span');
                        badge.className = 'nb-badge';
                        badgeContainer.appendChild(badge);
                    }
                    const current = parseInt(badge.textContent) || 0;
                    badge.textContent = current + 1;
                }

                // Pick icon + type based on notification type
                const typeMap = {
                    'payment_received':   { icon: '💳', toastType: 'success' },
                    'transfer_completed': { icon: '🏦', toastType: 'success' },
                    'memo_received':      { icon: '✉️',  toastType: 'info'    },
                    'memo_approved':      { icon: '✅',  toastType: 'success' },
                    'memo_declined':      { icon: '❌',  toastType: 'error'   },
                    'low_stock':          { icon: '⚠️',  toastType: 'warning' },
                    'user_activity':      { icon: '👤',  toastType: 'info'    },
                    'inventory_restocked':{ icon: '📦',  toastType: 'success' },
                };
                const meta = typeMap[payload.type] || { icon: '🔔', toastType: 'info' };
                const message = (meta.icon + ' ' + (payload.message || 'New notification')).trim();

                if (typeof toast !== 'undefined') {
                    toast.show(message, meta.toastType, 6000);
                }

                // If notification has a link, make toast clickable via Swal
                if (payload.link && typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: meta.toastType === 'error' ? 'error' : meta.toastType,
                        title: message,
                        html: '<a href="' + payload.link + '" style="color:#fff;text-decoration:underline;font-size:0.8rem;">View →</a>',
                        showConfirmButton: false,
                        timer: 7000,
                        timerProgressBar: true,
                        background: meta.toastType === 'success' ? '#10b981' : meta.toastType === 'error' ? '#ef4444' : meta.toastType === 'warning' ? '#f59e0b' : '#3b82f6',
                        color: '#ffffff',
                        iconColor: '#ffffff',
                        customClass: { popup: 'colored-toast' }
                    });
                    return;
                }

            } catch(err) { console.error('Mercure message parse failed', err); }
        };

        es.onerror = function() {
            console.warn('Mercure EventSource disconnected. Real-time updates paused.');
        };

    } catch(e) { console.warn('Mercure init failed:', e.message); }
})();
{% endif %}
</script>
    
    {% block styles %}{% endblock %}
</head>

{% set bodyRoleClass = '' %}
{% if app.user %}
    {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
        {% set bodyRoleClass = 'role-super-admin' %}
    {% elseif 'ROLE_SUB_ADMIN' in app.user.roles %}
        {% set bodyRoleClass = 'role-sub-admin' %}
    {% elseif 'ROLE_MANAGER' in app.user.roles %}
        {% set bodyRoleClass = 'role-manager' %}
    {% elseif 'ROLE_STAFF' in app.user.roles %}
        {% set bodyRoleClass = 'role-staff' %}
    {% endif %}
{% endif %}

<body class="{{ bodyRoleClass }}">

    {% if app.user %}
        <div id="sidebar-overlay"></div>

        <div class="app-shell">
            {% include 'includes/_sidebar.html.twig' %}

            <div id="main-wrapper">
                {% include 'includes/navbar.html.twig' %}

                <main id="main-content">
                    {% include 'includes/alerts.html.twig' %}
                    {% block content %}{% endblock %}
                </main>

                <footer class="app-footer">
                    <span>&copy; 2026 {{ app_name }} Company Limited. All rights reserved.</span>
                    <span>Powered by <strong>TACI</strong> &middot; v2.0</span>
                </footer>
            </div>
        </div>

    {% else %}
        <main>
            <div class="container py-5">
                {% include 'includes/alerts.html.twig' %}
                {{ block('content') }}
            </div>
        </main>
    {% endif %}
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ asset('js/table-export.js') }}"></script>
    
    <script>
        // Global interceptor for confirm() in onsubmit and onclick attributes
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const onsubmitAttr = form.getAttribute('onsubmit');
            if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
                e.preventDefault();
                const match = onsubmitAttr.match(/confirm\(['"`](.*?)['"`]\)/);
                const msg = match ? match[1] : 'Are you sure?';
                
                Swal.fire({
                    title: 'Are you sure?',
                    text: msg,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#0d9488',
                    cancelButtonColor: '#ef4444',
                    confirmButtonText: 'Yes, proceed!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.removeAttribute('onsubmit');
                        form.submit();
                    }
                });
            }
        });

        document.addEventListener('click', function(e) {
            let el = e.target.closest('[onclick*="confirm("]');
            if (el) {
                e.preventDefault();
                e.stopImmediatePropagation();
                const onclickAttr = el.getAttribute('onclick');
                const match = onclickAttr.match(/confirm\(['"`](.*?)['"`]\)/);
                const msg = match ? match[1] : 'Are you sure?';
                
                Swal.fire({
                    title: 'Are you sure?',
                    text: msg,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#0d9488',
                    cancelButtonColor: '#ef4444',
                    confirmButtonText: 'Yes, proceed!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        el.removeAttribute('onclick');
                        el.click();
                    }
                });
            }
        }, true);

        class ToastNotification {
            show(msg, type = 'info', duration = 5000) {
                const bgColors = {
                    success: '#10b981',
                    error:   '#ef4444',
                    warning: '#f59e0b',
                    info:    '#3b82f6'
                };
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: type === 'error' ? 'error' : type,
                    title: msg,
                    showConfirmButton: false,
                    timer: duration,
                    timerProgressBar: true,
                    background: bgColors[type] || bgColors.info,
                    color: '#ffffff',
                    iconColor: '#ffffff',
                    customClass: {
                        popup: 'colored-toast'
                    }
                });
            }

            success(msg, d = 5000) { this.show(msg, 'success', d); }
            error(msg, d = 5000)   { this.show(msg, 'error',   d); }
            warning(msg, d = 5000) { this.show(msg, 'warning', d); }
            info(msg, d = 5000)    { this.show(msg, 'info',    d); }
        }

        const toast = new ToastNotification();
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('{{ app_name }} - Interface Loaded');
            
            // Auto-hide alerts after 5 seconds and convert to toasts
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                // Get alert type from Bootstrap class
                let type = 'info';
                if (alert.classList.contains('alert-success')) type = 'success';
                else if (alert.classList.contains('alert-danger')) type = 'error';
                else if (alert.classList.contains('alert-warning')) type = 'warning';
                
                // Get the message text
                const message = alert.textContent.trim();
                
                // Show as toast
                toast.show(message, type, 5000);
                
                // Hide the alert element
                alert.style.display = 'none';
            });

            // Offline transaction queue sync
            // IndexedDB helper
            function idbOpen() {
                return new Promise((resolve, reject) => {
                    if (!('indexedDB' in window)) return resolve(null);
                    const req = indexedDB.open('taci_offline', 1);
                    req.onupgradeneeded = function(e) {
                        const db = e.target.result;
                        if (!db.objectStoreNames.contains('transactions')) {
                            db.createObjectStore('transactions', { autoIncrement: true });
                        }
                    };
                    req.onsuccess = () => resolve(req.result);
                    req.onerror = () => resolve(null);
                });
            }

            async function idbAddTx(tx) {
                const db = await idbOpen();
                if (!db) return false;
                return new Promise((resolve) => {
                    const txn = db.transaction('transactions', 'readwrite');
                    const store = txn.objectStore('transactions');
                    store.add(tx);
                    txn.oncomplete = () => { db.close(); resolve(true); };
                    txn.onerror = () => { db.close(); resolve(false); };
                });
            }

            async function idbGetAll() {
                const db = await idbOpen();
                if (!db) return [];
                return new Promise((resolve) => {
                    const txn = db.transaction('transactions', 'readonly');
                    const store = txn.objectStore('transactions');
                    const req = store.getAll();
                    req.onsuccess = () => { db.close(); resolve(req.result || []); };
                    req.onerror = () => { db.close(); resolve([]); };
                });
            }

            async function idbClear() {
                const db = await idbOpen();
                if (!db) return false;
                return new Promise((resolve) => {
                    const txn = db.transaction('transactions', 'readwrite');
                    txn.objectStore('transactions').clear();
                    txn.oncomplete = () => { db.close(); resolve(true); };
                    txn.onerror = () => { db.close(); resolve(false); };
                });
            }

            function getOfflineQueue() {
                try {
                    const raw = localStorage.getItem('offline_tx_queue');
                    return raw ? JSON.parse(raw) : [];
                } catch (e) { return []; }
            }

            function setOfflineQueue(q) { localStorage.setItem('offline_tx_queue', JSON.stringify(q)); }

            async function trySyncQueue() {
                const localQ = getOfflineQueue();
                const idbQ = await idbGetAll();
                const q = [].concat(localQ, idbQ);
                if (!q.length) return;
                try {
                    const res = await fetch('/api/sync', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ transactions: q })
                    });
                    if (res.ok) {
                        const json = await res.json();
                        setOfflineQueue([]);
                        await idbClear();

                        const results = json.results || [];
                        const applied = results.filter(r => r.status === 'applied').length;
                        const conflicts = results.filter(r => r.status === 'conflict');
                        const failed = results.filter(r => r.status === 'failed').length;
                        const dup = results.filter(r => r.status === 'duplicate').length;

                        toast.success(`Sync complete: ${applied} applied, ${conflicts.length} conflicts, ${failed} failed, ${dup} duplicates`);

                        if (conflicts.length > 0) {
                            console.warn('Sync conflicts', conflicts);
                            const preview = conflicts.slice(0,5).map(c => `• ${c.offlineId || 'n/a'}: ${c.message || 'conflict'}`).join('<br>');
                            Swal.fire({
                                title: '⚠️ Sync Conflicts Detected',
                                html: preview + (conflicts.length > 5 ? '<br><em>...and more. See console for details.</em>' : ''),
                                icon: 'warning',
                                confirmButtonColor: '#f59e0b',
                                confirmButtonText: 'OK'
                            });
                        }
                    } else {
                        const txt = await res.text();
                        toast.error('Sync failed: ' + res.status);
                        console.warn('Sync response', res.status, txt);
                    }
                } catch (err) {
                    console.warn('Sync error', err);
                }
            }

            window.queueOfflineTransaction = async function(tx) {
                const added = await idbAddTx(tx);
                if (!added) {
                    const q = getOfflineQueue();
                    q.push(tx);
                    setOfflineQueue(q);
                }
                toast.info('Transaction queued for sync (offline)');

                // attempt to register background sync if available
                if ('serviceWorker' in navigator && navigator.serviceWorker.ready) {
                    try {
                        const reg = await navigator.serviceWorker.ready;
                        if (reg && reg.sync) {
                            await reg.sync.register('sync-offline-taci');
                            console.log('Registered background sync: sync-offline-taci');
                        }
                    } catch (err) {
                        console.warn('Background sync registration failed', err);
                    }
                }
            };

            window.addEventListener('online', function() { trySyncQueue(); });

            // Try once on load
            if (navigator.onLine) trySyncQueue();
        });
    </script>
    
    <!-- PWA Initialization (Admin/SubAdmin only) -->
    {% if app.user and ('ROLE_SUPER_ADMIN' in app.user.roles or 'ROLE_SUB_ADMIN' in app.user.roles) %}
    <script src="{{ asset('js/pwa-init.js') }}"></script>
    {% endif %}
    
    {% block scripts %}{% endblock %}
</body>
</html>
