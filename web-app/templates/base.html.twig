{# Base Layout Template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ app_name }} - Fuel Station Management System">
    <meta name="theme-color" content="#1f2937">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('images/icon-192x192.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/icon-192x192.png') }}">
    
    <title>{% block title %}{{ app_name }} - Management System{% endblock %}</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Custom CSS -->
    <!-- Custom CSS (Inlined to fix missing app.css) -->
    <style>
        :root {
            --primary: #0d9488;
            --primary-dark: #0f766e;
            --accent: #F5A623;
            --bg-dark: #f6f9fc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
        }
        
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            transition: background-color 0.3s ease;
        }

        body.role-super-admin { --primary: #0d9488; --primary-dark: #0f766e; }
        body.role-sub-admin { --primary: #7f1d1d; --primary-dark: #5f1515; }
        body.role-manager { --primary: #14532d; --primary-dark: #0f3f23; }
        body.role-staff { --primary: #1e3a8a; --primary-dark: #162c68; }

        .sidebar {
            background: var(--primary) !important;
            backdrop-filter: blur(10px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card {
            background: var(--card-bg);
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
            color: var(--text-main);
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-2px);
        }

        .nav-link {
            color: #e2e8f0 !important;
        }

        .nav-link.active {
            color: #ffffff !important;
            background: var(--primary) !important;
        }

        .badge-success {
            background-color: #10b981;
        }

        /* Lightning-fast, distraction-free interface tweaks */
        #main-content {
            padding: 2rem;
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
    
    {% block styles %}{% endblock %}
</head>
{% set bodyRoleClass = '' %}
{% if app.user %}
    {% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
        {% set bodyRoleClass = 'role-super-admin' %}
    {% elseif 'ROLE_SUB_ADMIN' in app.user.roles %}
        {% set bodyRoleClass = 'role-sub-admin' %}
    {% elseif 'ROLE_MANAGER' in app.user.roles %}
        {% set bodyRoleClass = 'role-manager' %}
    {% elseif 'ROLE_STAFF' in app.user.roles %}
        {% set bodyRoleClass = 'role-staff' %}
    {% endif %}
{% endif %}
<body class="{{ bodyRoleClass }}">
    {% if app.user %}
        <!-- Navigation Bar -->
        {% include 'includes/navbar.html.twig' %}
    {% endif %}

    <div class="{% if app.user %}d-flex{% endif %}">
        {% if app.user %}
            <!-- Sidebar -->
            {% include 'includes/sidebar.html.twig' %}
        {% endif %}
        
        <!-- Main Content -->
        <main class="flex-grow-1" id="main-content">
            <div class="{% if not app.user %}container py-5{% endif %}">
                <!-- Alerts -->
                {% include 'includes/alerts.html.twig' %}
                
                <!-- Page Content -->
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
    
    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5 border-top border-secondary">
        <div class="container">
            <p class="mb-1">&copy; 2026 {{ app_name }} Company Limited. All Rights Reserved.</p>
            <p class="text-muted small">Bold discovery, refined for your desktop.</p>
        </div>
    </footer>
    
    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="{{ asset('js/table-export.js') }}"></script>
    
    <!-- Custom JS (Inlined to fix missing app.js) -->
    <script>
        // Toast notification system
        class ToastNotification {
            constructor() {
                this.container = this.createContainer();
            }
            
            createContainer() {
                let container = document.querySelector('.toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.className = 'toast-container';
                    Object.assign(container.style, {
                        position: 'fixed',
                        top: '20px',
                        right: '20px',
                        zIndex: '1050'
                    });
                    document.body.appendChild(container);
                }
                return container;
            }
            
            show(message, type = 'info', duration = 5000) {
                const toastDiv = document.createElement('div');
                Object.assign(toastDiv.style, {
                    minWidth: '300px',
                    borderRadius: '8px',
                    boxShadow: '0 4px 12px rgba(0, 0, 0, 0.15)',
                    marginBottom: '10px'
                });
                
                const typeColors = {
                    success: { bg: '#d4edda', border: '#c3e6cb', text: '#155724' },
                    error: { bg: '#f8d7da', border: '#f5c6cb', text: '#721c24' },
                    warning: { bg: '#fff3cd', border: '#ffeaa7', text: '#856404' },
                    info: { bg: '#d1ecf1', border: '#bee5eb', text: '#0c5460' }
                };
                
                const colors = typeColors[type] || typeColors.info;
                Object.assign(toastDiv.style, {
                    backgroundColor: colors.bg,
                    border: `1px solid ${colors.border}`,
                    color: colors.text
                });
                
                toastDiv.innerHTML = `
                    <div style="padding: 12px 16px; display: flex; justify-content: space-between; align-items: center;">
                        <span>${message}</span>
                        <button class="toast-close" aria-label="Close" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; opacity: 0.7; color: inherit;">×</button>
                    </div>
                `;
                
                this.container.appendChild(toastDiv);
                
                const closeBtn = toastDiv.querySelector('.toast-close');
                closeBtn.addEventListener('click', () => toastDiv.remove());
                closeBtn.addEventListener('mouseover', () => closeBtn.style.opacity = '1');
                closeBtn.addEventListener('mouseout', () => closeBtn.style.opacity = '0.7');
                
                if (duration > 0) {
                    setTimeout(() => toastDiv.remove(), duration);
                }
            }
            
            success(message, duration = 5000) {
                this.show(message, 'success', duration);
            }
            
            error(message, duration = 5000) {
                this.show(message, 'error', duration);
            }
            
            warning(message, duration = 5000) {
                this.show(message, 'warning', duration);
            }
            
            info(message, duration = 5000) {
                this.show(message, 'info', duration);
            }
        }
        
        const toast = new ToastNotification();
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('{{ app_name }} - Interface Loaded');
            
            // Auto-hide alerts after 5 seconds and convert to toasts
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                // Get alert type from Bootstrap class
                let type = 'info';
                if (alert.classList.contains('alert-success')) type = 'success';
                else if (alert.classList.contains('alert-danger')) type = 'error';
                else if (alert.classList.contains('alert-warning')) type = 'warning';
                
                // Get the message text
                const message = alert.textContent.trim();
                
                // Show as toast
                toast.show(message, type, 5000);
                
                // Hide the alert element
                alert.style.display = 'none';
            });
        });
    </script>
    
    <!-- PWA Initialization (Admin/SubAdmin only) -->
    {% if app.user and ('ROLE_SUPER_ADMIN' in app.user.roles or 'ROLE_SUB_ADMIN' in app.user.roles) %}
    <script src="{{ asset('js/pwa-init.js') }}"></script>
    {% endif %}
    
    {% block scripts %}{% endblock %}
</body>
</html>
