{# templates/components/modals.html.twig #}

{# Add Item Modal (Inventory) - posts to existing inventory product endpoint #}
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius: 1rem; border: none;">
      <div class="modal-header" style="background: rgba(13,148,136,0.05); border-bottom: 1px solid var(--border-color); border-radius: 1rem 1rem 0 0;">
        <h5 class="modal-title fw-bold" id="addItemModalLabel"><i class="fa-solid fa-box-seam me-2"></i>Add Inventory Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addItemForm" action="{{ path('app_inventory_product_new') }}" method="post" enctype="multipart/form-data" class="modal-body p-4">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small text-muted">Item Name</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Engine Oil 20W-50">
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Category</label>
            <input type="text" name="category" class="form-control" required placeholder="e.g. Lubricants">
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Barcode</label>
            <input type="text" name="barcode" class="form-control" required placeholder="Scan or enter barcode">
          </div>
          <div class="col-md-6">
            <label class="form-label small text-muted">Unit Price</label>
            <input type="number" step="0.01" name="unitPrice" class="form-control" required placeholder="0.00">
          </div>
          <div class="col-md-4">
            <label class="form-label small text-muted">Quantity</label>
            <input type="number" name="stockQuantity" class="form-control" value="0" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small text-muted">Reorder Level</label>
            <input type="number" name="reorderLevel" class="form-control" value="10" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small text-muted">Supplier (optional)</label>
              <select name="supplierId" class="form-select">
              <option value="">Select supplier...</option>
              {% if suppliers is defined and suppliers is iterable %}
                {% for s in suppliers %}
                  <option value="{{ s.id }}">{{ s.name }}</option>
                {% endfor %}
              {% endif %}
            </select>
          </div>
          <div class="col-12">
            <label class="form-label small text-muted">Image (optional)</label>
            <input type="file" id="addItemImage" name="image" accept="image/*" class="form-control">
            <div class="mt-2">
              <img id="addItemImagePreview" src="" alt="" style="max-height:120px; display:none; border-radius:6px; border:1px solid rgba(0,0,0,0.06);">
            </div>
            <div class="form-text">Max 5MB. JPEG/PNG/WEBP only.</div>
          </div>
        </div>
      </form>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" form="addItemForm" class="btn btn-primary">Save Item</button>
      </div>
    </div>
  </div>
</div>


{# ── 1. SHIFT CREATION MODAL (Manager) ── #}
<div class="modal fade" id="shiftModal" tabindex="-1" aria-labelledby="shiftModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius: 1rem; border: none;">
      <div class="modal-header" style="background: rgba(15,76,58,0.05); border-bottom: 1px solid var(--border-color); border-radius: 1rem 1rem 0 0;">
        <h5 class="modal-title fw-bold" id="shiftModalLabel" style="color: #0F4C3A;"><i class="fa-solid fa-calendar-plus me-2"></i>Create New Shift</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form id="createShiftForm">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">Shift Period</label>
                    <select class="form-select" required>
                        <option value="Morning">Morning (06:00 - 14:00)</option>
                        <option value="Noon">Noon (14:00 - 22:00)</option>
                        <option value="Evening">Evening (22:00 - 06:00)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Start Time</label>
                    <input type="time" class="form-control" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">End Time</label>
                    <input type="time" class="form-control" required>
                </div>
            </div>
            
            <hr class="my-4">
            <h6 class="fw-bold mb-3">Staff Assignment</h6>
            
            <div id="staffRowsContainer">
                <div class="row g-2 mb-2 staff-row align-items-center">
                    <div class="col-md-5">
                        <select class="form-select" required>
                            <option value="">Select Staff...</option>
                                     </select>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select" required>
                            <option value="">Assign Role...</option>
                            <option value="Cashier">Cashier</option>
                            <option value="Pump Attendant">Pump Attendant</option>
                            <option value="Supervisor">Supervisor</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-staff-btn" disabled><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            </div>
            
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-light fw-bold text-primary" id="addStaffRowBtn">
                    <i class="fa-solid fa-plus me-1"></i> Add Another Staff
                </button>
            </div>
            
            <div class="mt-4 form-check">
                <input class="form-check-input" type="checkbox" value="" id="sendMemoCheck" checked>
                <label class="form-check-label text-muted small" for="sendMemoCheck">
                    Automatically send Memo to assigned staff and Super Admin
                </label>
            </div>
        </form>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn" style="background: #0F4C3A; color: white;" onclick="alert('Shift created and Memo sent!'); bootstrap.Modal.getInstance(document.getElementById('shiftModal')).hide();">Create Shift</button>
      </div>
    </div>
  </div>
</div>

{# ── 2. LEAVE MANAGEMENT MODAL (Manager) ── #}
<div class="modal fade" id="leaveModal" tabindex="-1" aria-labelledby="leaveModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 1rem; border: none;">
      <div class="modal-header" style="background: rgba(15,76,58,0.05); border-bottom: 1px solid var(--border-color); border-radius: 1rem 1rem 0 0;">
        <h5 class="modal-title fw-bold" id="leaveModalLabel" style="color: #0F4C3A;"><i class="fa-solid fa-plane-departure me-2"></i>Log Leave Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Staff Name</label>
                <select class="form-select" required>
                    <option value="">Select Staff...</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Category</label>
                <select class="form-select" required>
                    <option value="Sick">Sick Leave</option>
                    <option value="Maternity">Maternity/Paternity</option>
                    <option value="Paid">Paid Time Off (PTO)</option>
                    <option value="Unpaid">Unpaid Leave</option>
                    <option value="Bereavement">Bereavement</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label text-muted small fw-bold">Start Date</label>
                    <input type="date" class="form-control" required>
                </div>
                <div class="col-6">
                    <label class="form-label text-muted small fw-bold">End Date</label>
                    <input type="date" class="form-control" required>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Reason</label>
                <textarea class="form-control" rows="3" placeholder="Brief reason for leave..." required></textarea>
            </div>
        </form>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn" style="background: #0F4C3A; color: white;" onclick="alert('Leave request logged!'); bootstrap.Modal.getInstance(document.getElementById('leaveModal')).hide();">Submit Request</button>
      </div>
    </div>
  </div>
</div>

{# ── 3. INCIDENT REPORTING MODAL (Staff/Manager) ── #}
<div class="modal fade" id="incidentModal" tabindex="-1" aria-labelledby="incidentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 1rem; border: none;">
      <div class="modal-header" style="background: rgba(239,68,68,0.05); border-bottom: 1px solid var(--border-color); border-radius: 1rem 1rem 0 0;">
        <h5 class="modal-title fw-bold" id="incidentModalLabel" style="color: #dc2626;"><i class="fa-solid fa-triangle-exclamation me-2"></i>Report Incident</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Incident Type</label>
                <select class="form-select" required>
                    <option value="Spill">Fuel Spill</option>
                    <option value="Breakdown">Equipment Breakdown</option>
                    <option value="Customer">Customer Dispute</option>
                    <option value="Safety">Safety Hazard</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Description</label>
                <textarea class="form-control" rows="3" placeholder="Describe what happened..." required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">Upload Photo (Optional)</label>
                <input type="file" class="form-control" accept="image/*">
                <div class="form-text">Upload a picture of the spill or breakdown.</div>
            </div>
        </form>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" onclick="alert('Incident reported successfully!'); bootstrap.Modal.getInstance(document.getElementById('incidentModal')).hide();">Submit Report</button>
      </div>
    </div>
  </div>
</div>

{# ── 4. CLOCK-IN MODAL (Staff) ── #}
<div class="modal fade" id="clockInModal" tabindex="-1" aria-labelledby="clockInModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="border-radius: 1rem; border: none;">
      <div class="modal-body p-4 text-center">
        <div class="mb-3 text-success">
            <i class="fa-solid fa-fingerprint fa-3x"></i>
        </div>
        <h5 class="fw-bold mb-3">Clock In</h5>
        <p class="text-muted small mb-4">Please enter your Biometric ID or PIN to securely clock in.</p>
        <div class="mb-3">
            <input type="password" class="form-control text-center fw-bold" placeholder="****" style="letter-spacing: 0.5em; font-size: 1.5rem;" maxlength="4">
        </div>
        <div class="mb-2 text-muted small">
            <i class="fa-solid fa-location-dot me-1"></i> Location: Station {{ app.user.stationId ?? 'N/A' }}
        </div>
        <button type="button" class="btn btn-success w-100 mt-2 fw-bold" onclick="alert('Clock-in successful at ' + new Date().toLocaleTimeString()); bootstrap.Modal.getInstance(document.getElementById('clockInModal')).hide(); document.getElementById('clockInBtn').classList.replace('btn-success', 'btn-outline-danger'); document.getElementById('clockInBtn').innerHTML = '<i class=\'fa-solid fa-right-from-bracket me-1\'></i> Clock Out';">
            Confirm Clock-In
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Dynamic staff row logic
    const addBtn = document.getElementById('addStaffRowBtn');
    if (addBtn) {
        addBtn.addEventListener('click', function() {
            const container = document.getElementById('staffRowsContainer');
            const newRow = container.children[0].cloneNode(true);
            newRow.querySelector('.remove-staff-btn').disabled = false;
            // Clear selections
            newRow.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
            container.appendChild(newRow);
        });
    }

    // Delegate event for dynamic remove buttons
    document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-staff-btn')) {
            const row = e.target.closest('.staff-row');
            if (document.querySelectorAll('.staff-row').length > 1) {
                row.remove();
            }
        }
    });

    // Clock in trigger
    const clockInBtn = document.getElementById('clockInBtn');
    if (clockInBtn) {
        clockInBtn.addEventListener('click', function() {
            if (this.innerText.includes('Clock Out')) {
                if(confirm('Are you sure you want to clock out?')) {
                    alert('Clocked out successfully at ' + new Date().toLocaleTimeString());
                    this.classList.replace('btn-outline-danger', 'btn-success');
                    this.innerHTML = '<i class="fa-solid fa-clock me-1"></i> Clock In';
                }
            } else {
                new bootstrap.Modal(document.getElementById('clockInModal')).show();
            }
        });
    }

    // Add Item image preview and validation
    const addImageInput = document.getElementById('addItemImage');
    const addImagePreview = document.getElementById('addItemImagePreview');
    if (addImageInput) {
        addImageInput.addEventListener('change', function(e) {
            const file = this.files && this.files[0];
            if (!file) return;
            const maxBytes = 5 * 1024 * 1024;
            const allowed = ['image/jpeg','image/png','image/webp'];
            if (file.size > maxBytes) {
                alert('Selected image exceeds 5MB');
                this.value = '';
                addImagePreview.style.display = 'none';
                return;
            }
            if (!allowed.includes(file.type)) {
                alert('Invalid image type. Only JPEG, PNG and WEBP are allowed.');
                this.value = '';
                addImagePreview.style.display = 'none';
                return;
            }
            const reader = new FileReader();
            reader.onload = function(ev) {
                addImagePreview.src = ev.target.result;
                addImagePreview.style.display = 'inline-block';
            };
            reader.readAsDataURL(file);
        });
    }

    // Populate supplier dropdown if an API exists (non-fatal)
    const supplierSelect = document.querySelector('select[name="supplierId"]');
    if (supplierSelect) {
        fetch('/inventory/suppliers').then(r => {
            if (!r.ok) throw new Error('no');
            return r.json();
        }).then(list => {
            list.forEach(s => {
                const o = document.createElement('option');
                o.value = s.id || s.name;
                o.textContent = s.name || s;
                supplierSelect.appendChild(o);
            });
        }).catch(()=>{/* ignore – endpoint may not exist yet */});
    }

    // Populate staff selects (shift/leave modals)
    fetch('/api/staff').then(r => {
        if (!r.ok) throw new Error('no');
        return r.json();
    }).then(list => {
        // staff selectors inside shift modal
        document.querySelectorAll('#staffRowsContainer select').forEach(sel => {
            // remove existing placeholder options but keep first "Select Staff..."
            const first = sel.querySelector('option');
            sel.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select Staff...';
            sel.appendChild(placeholder);

            list.forEach(u => {
                const o = document.createElement('option');
                o.value = u.id;
                o.textContent = u.username;
                sel.appendChild(o);
            });
        });

        // leave modal staff select
        const leaveSel = document.querySelector('#leaveModal select');
        if (leaveSel) {
            leaveSel.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select Staff...';
            leaveSel.appendChild(placeholder);
            list.forEach(u => {
                const o = document.createElement('option');
                o.value = u.id;
                o.textContent = u.username;
                leaveSel.appendChild(o);
            });
        }
    }).catch(()=>{/* ignore if unauthenticated */});
});
</script>
