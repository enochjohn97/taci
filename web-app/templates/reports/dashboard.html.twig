{% extends "base.html.twig" %}

{% block title %}Reports Dashboard – {{ app_name }}{% endblock %}

{% block content %}
<div class="page-header d-print-none">
	<div class="container-xl">
		<div class="row align-items-center">
			<div class="col">
				<h2 class="page-title mt-4">
					<i class="bi bi-bar-chart-line me-2"></i>Reports &amp; Analytics
				</h2>
				<p class="text-muted small mb-0">Overview of key performance metrics</p>
			</div>
			<div class="col-auto d-flex gap-2">
				<form method="GET" class="d-flex gap-2 align-items-center">
					<input type="date" name="startDate" class="form-control form-control-sm"
					       value="{{ start_date|date('Y-m-d') }}">
					<span class="text-muted small">to</span>
					<input type="date" name="endDate" class="form-control form-control-sm"
					       value="{{ end_date|date('Y-m-d') }}">
					<button type="submit" class="btn btn-sm btn-primary">
						<i class="bi bi-funnel me-1"></i>Filter
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

<div class="page-wrapper mt-4">
	<div class="container-xl">

		{# ── KPI Cards ─────────────────────────────────────────── #}
		<div class="row g-3 mb-4">
			<div class="col-sm-6 col-lg-4">
				<div class="card kpi-card shadow-sm border-0">
					<div class="card-body d-flex align-items-center gap-3 py-3">
						<div class="kpi-icon bg-success bg-opacity-10 text-success">
							<i class="bi bi-currency-dollar"></i>
						</div>
						<div>
							<div class="kpi-label">Total Revenue</div>
							<div class="kpi-value">₦{{ total_revenue|number_format(2) }}</div>
						</div>
					</div>
					<div class="kpi-strip bg-success"></div>
				</div>
			</div>
			<div class="col-sm-6 col-lg-4">
				<div class="card kpi-card shadow-sm border-0">
					<div class="card-body d-flex align-items-center gap-3 py-3">
						<div class="kpi-icon bg-primary bg-opacity-10 text-primary">
							<i class="bi bi-receipt"></i>
						</div>
						<div>
							<div class="kpi-label">Total Transactions</div>
							<div class="kpi-value">{{ total_transactions }}</div>
						</div>
					</div>
					<div class="kpi-strip bg-primary"></div>
				</div>
			</div>
			<div class="col-sm-6 col-lg-4">
				<div class="card kpi-card shadow-sm border-0">
					<div class="card-body d-flex align-items-center gap-3 py-3">
						<div class="kpi-icon bg-warning bg-opacity-10 text-warning">
							<i class="bi bi-graph-up-arrow"></i>
						</div>
						<div>
							<div class="kpi-label">Avg Transaction</div>
							<div class="kpi-value">₦{{ average_transaction|number_format(2) }}</div>
						</div>
					</div>
					<div class="kpi-strip bg-warning"></div>
				</div>
			</div>
		</div>

		{# ── Quick nav ─────────────────────────────────────────── #}
		<div class="row g-3 mb-4">
			<div class="col-md-4">
				<a href="{{ path('app_reports_sales') }}" class="card text-decoration-none border-0 shadow-sm h-100">
					<div class="card-body d-flex align-items-center gap-3">
						<div class="kpi-icon bg-info bg-opacity-10 text-info" style="width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;">
							<i class="bi bi-graph-up"></i>
						</div>
						<div>
							<div class="fw-semibold">Sales Report</div>
							<div class="text-muted small">Daily / weekly / monthly breakdown</div>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-4">
				<a href="{{ path('app_reports_inventory') }}" class="card text-decoration-none border-0 shadow-sm h-100">
					<div class="card-body d-flex align-items-center gap-3">
						<div class="kpi-icon bg-warning bg-opacity-10 text-warning" style="width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;">
							<i class="bi bi-boxes"></i>
						</div>
						<div>
							<div class="fw-semibold">Inventory Report</div>
							<div class="text-muted small">Stock valuation &amp; low stock alerts</div>
						</div>
					</div>
				</a>
			</div>
			<div class="col-md-4">
				<a href="{{ path('app_reports_profit_loss') }}" class="card text-decoration-none border-0 shadow-sm h-100">
					<div class="card-body d-flex align-items-center gap-3">
						<div class="kpi-icon bg-success bg-opacity-10 text-success" style="width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;">
							<i class="bi bi-piggy-bank"></i>
						</div>
						<div>
							<div class="fw-semibold">Profit &amp; Loss</div>
							<div class="text-muted small">Revenue, COGS &amp; net margin</div>
						</div>
					</div>
				</a>
			</div>
		</div>

		{# ── Revenue chart ─────────────────────────────────────── #}
		<div class="card border-0 shadow-sm mb-4">
			<div class="card-header d-flex align-items-center justify-content-between">
				<span class="fw-semibold"><i class="bi bi-bar-chart me-2"></i>Revenue by Date</span>
				<a href="{{ path('app_reports_export_sales_excel') }}" class="btn btn-sm btn-outline-success">
					<i class="bi bi-file-earmark-excel me-1"></i>Export Excel
				</a>
			</div>
			<div class="card-body" style="min-height:280px;">
				<canvas id="revenueChart" height="100"></canvas>
			</div>
		</div>

		{# ── Recent sales table ────────────────────────────────── #}
		{% if sales is defined and sales|length > 0 %}
		<div class="card border-0 shadow-sm">
			<div class="card-header">
				<span class="fw-semibold"><i class="bi bi-table me-2"></i>Recent Transactions</span>
			</div>
			<div class="table-responsive">
				<table class="table table-hover mb-0" style="font-size:.875rem;">
					<thead class="table-light">
						<tr>
							<th>#</th>
							<th>Date</th>
							<th>Cashier</th>
							<th class="text-end">Amount</th>
							<th>Payment</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						{% for sale in sales %}
						<tr>
							<td class="text-muted">{{ sale.id }}</td>
							<td>{{ sale.createdAt|date('d M Y H:i') }}</td>
							<td>{{ sale.cashier ? sale.cashier.username : '—' }}</td>
							<td class="text-end fw-semibold">₦{{ sale.totalAmount|number_format(2) }}</td>
							<td>{{ sale.paymentMethod|capitalize }}</td>
							<td>
								<span class="badge rounded-pill
									{% if sale.status == 'completed' %}bg-success
									{% elseif sale.status == 'pending' %}bg-warning text-dark
									{% else %}bg-secondary{% endif %}">
									{{ sale.status|capitalize }}
								</span>
							</td>
						</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
		{% endif %}

	</div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
	const salesByDate = {{ sales_by_date|default('{}') }};
	const labels = Object.keys(salesByDate);
	const values = Object.values(salesByDate);
	const ctx = document.getElementById('revenueChart');
	if (ctx && labels.length > 0) {
		new Chart(ctx, {
			type: 'bar',
			data: {
				labels,
				datasets: [{
					label: 'Revenue (₦)',
					data: values,
					backgroundColor: 'rgba(13,148,136,0.7)',
					borderColor: 'rgba(13,148,136,1)',
					borderWidth: 1,
					borderRadius: 4,
				}]
			},
			options: {
				responsive: true,
				plugins: { legend: { display: false } },
				scales: { y: { beginAtZero: true, ticks: { callback: v => '₦' + Number(v).toLocaleString() } } }
			}
		});
	} else if (ctx) {
		ctx.parentElement.innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-bar-chart" style="font-size:2rem;"></i><br>No data available for selected period.</div>';
	}
});
</script>
{% endblock %}
