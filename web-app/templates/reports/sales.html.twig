{% extends "base.html.twig" %}

{% block title %}Sales Report – {{ app_name }}{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1" style="font-size:0.8rem;">
                        <li class="breadcrumb-item"><a href="{{ path('app_reports_dashboard') }}">Reports</a></li>
                        <li class="breadcrumb-item active">Sales</li>
                    </ol>
                </nav>
                <h2 class="page-title mt-1">
                    <i class="bi bi-graph-up me-2"></i>Sales Report
                </h2>
            </div>
            <div class="col-auto">
                <form method="GET" class="d-flex gap-2 align-items-center">
                    <select name="period" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="daily" {% if period == 'daily' %}selected{% endif %}>Daily</option>
                        <option value="weekly" {% if period == 'weekly' %}selected{% endif %}>Weekly</option>
                        <option value="monthly" {% if period == 'monthly' %}selected{% endif %}>Monthly</option>
                        <option value="yearly" {% if period == 'yearly' %}selected{% endif %}>Yearly</option>
                    </select>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card kpi-card shadow-sm border-0 p-4">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Amount</div>
                    <div class="h2 mb-0 text-primary">₦{{ total_amount|number_format(2) }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card kpi-card shadow-sm border-0 p-4">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Discounts</div>
                    <div class="h2 mb-0 text-warning">₦{{ total_discount|number_format(2) }}</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Period</th>
                            <th>Transactions</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for key, g in grouped_sales %}
                        <tr>
                            <td class="fw-semibold">{{ key }}</td>
                            <td>{{ g.count }}</td>
                            <td class="text-end text-danger">₦{{ g.discount|number_format(2) }}</td>
                            <td class="text-end text-success fw-bold">₦{{ g.amount|number_format(2) }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No sales data found for the selected period.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
