{% extends "base.html.twig" %}

{% block title %}Forward Memo – {{ app_name }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

		.memo-watermark { position: relative; background: linear-gradient(160deg,#ffffff 0%,#f7fafc 100%); }
		.memo-watermark::before {
			content: "";
			position: absolute;
			inset: 0;
			background-image: url('{{ asset('images/tacilogo.png') }}');
			background-repeat: no-repeat;
			background-position: center;
			background-size: 50%;
			opacity: 0.055;
			z-index: 0;
			pointer-events: none;
			border-radius: inherit;
		}
		.memo-watermark > * { position: relative; z-index: 1; }

		/* ── Card header ────────────────────────────────────────── */
		.memo-card-header-fwd {
			background: linear-gradient(135deg, #0e7c7b 0%, #0a5f5e 100%);
			padding: 1.25rem 1.75rem;
			color: white;
			display: flex;
			align-items: center;
			gap: 0.875rem;
		}
		.memo-header-logo-sm {
			height: 30px;
			width: 30px;
			object-fit: contain;
			border-radius: 6px;
			background: rgba(255,255,255,0.15);
			padding: 3px;
			flex-shrink: 0;
		}
		.memo-header-company-fwd  { font-size:0.95rem; font-weight:700; color:#fff; line-height:1.2; }
		.memo-header-sub-fwd      { font-size:0.72rem; color:rgba(255,255,255,0.6); margin-top:2px; }
		.memo-header-badge-fwd {
			margin-left: auto;
			background: rgba(255,255,255,0.15);
			border: 1px solid rgba(255,255,255,0.25);
			border-radius: 100px;
			padding: 0.2rem 0.75rem;
			font-size: 0.72rem;
			font-weight: 600;
			color: rgba(255,255,255,0.9);
		}

		/* ── Locked sender fields ───────────────────────────────── */
		.sender-field {
			background: #f7fafc;
			border: 1.5px solid #e2e8f0;
			border-radius: 8px;
			padding: 0.55rem 0.875rem;
			font-size: 0.875rem;
			font-weight: 600;
			color: #718096;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			cursor: not-allowed;
			user-select: none;
			min-height: 40px;
		}
		.role-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			background: rgba(14,124,123,0.08);
			border: 1px solid rgba(14,124,123,0.2);
			color: #0e7c7b;
			border-radius: 100px;
			padding: 0.2rem 0.75rem;
			font-size: 0.78rem;
			font-weight: 700;
			cursor: not-allowed;
			user-select: none;
		}

		/* ── Recipient dropdown ─────────────────────────────────── */
		.dropdown-menu.w-100 { width: 100%; min-width: 100%; border-radius:10px; border:1.5px solid #e2e8f0; }
		.recipient-search {
			width: 100%;
			border: 1px solid #e2e8f0;
			border-radius: 6px;
			padding: 0.5rem 0.75rem;
			font-size: 0.825rem;
			outline: none;
			background: #f7fafc;
			transition: border-color .18s;
			margin-bottom: 0.375rem;
		}
		.recipient-search:focus { border-color: #0e7c7b; background: #fff; }

		/* ── Chips ──────────────────────────────────────────────── */
		.chips-container {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem;
			min-height: 28px;
			margin-top: 0.5rem;
			padding: 0.3rem 0;
		}
		.recipient-chip {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			background: #0e7c7b;
			color: #fff;
			border-radius: 999px;
			padding: 0.18rem 0.6rem 0.18rem 0.5rem;
			font-size: 0.76rem;
			font-weight: 500;
			animation: chipIn 0.15s ease;
		}
		@keyframes chipIn { from{opacity:0;transform:scale(0.8)} to{opacity:1;transform:scale(1)} }
		.chip-x { cursor:pointer; opacity:.7; margin-left:2px; font-size:.8rem; line-height:1; }
		.chip-x:hover { opacity:1; }
		.chips-empty { color:#94a3b8; font-size:.8rem; font-style:italic; display:flex; align-items:center; gap:.35rem; }

		.section-divider { border:none; border-top:1px solid #edf2f7; margin:1.5rem 0; }
		.original-preview {
			background: #f6f9fc;
			border-left: 3px solid #0e7c7b;
			border-radius: 0 8px 8px 0;
			font-size: 0.83rem;
			color: #718096;
			padding: 0.75rem 1rem;
			max-height: 100px;
			overflow: hidden;
			position: relative;
		}
		.original-preview::after {
			content: '';
			position: absolute;
			bottom:0; left:0; right:0;
			height: 30px;
			background: linear-gradient(transparent, #f6f9fc);
		}
		.form-label.required::after { content: " *"; color: #f56565; font-size: 0.7em; }
		.form-label {
			font-weight:600; color:#4a5568; font-size:0.78rem;
			text-transform:uppercase; letter-spacing:0.055em;
			display:flex; align-items:center; gap:0.375rem; margin-bottom:0.5rem;
		}
		.form-control, .form-select {
			border:1.5px solid #e2e8f0; border-radius:8px; padding:.6rem .875rem;
			font-size:.9rem; transition:border-color .18s, box-shadow .18s;
		}
		.form-control:focus, .form-select:focus {
			border-color:#0e7c7b; box-shadow:0 0 0 3px rgba(14,124,123,.12); outline:none;
		}
	</style>
{% endblock %}

{% block content %}

<div class="page-header d-print-none">
	<div class="container-xl">
		<div class="row align-items-center">
			<div class="col">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb mb-1" style="font-size:0.8rem;">
						<li class="breadcrumb-item"><a href="{{ path('app_memo_dashboard') }}">Memos</a></li>
						<li class="breadcrumb-item"><a href="{{ path('app_memo_view', {id: memo.id}) }}">{{ memo.subject|slice(0,40) }}{% if memo.subject|length > 40 %}…{% endif %}</a></li>
						<li class="breadcrumb-item active">Forward</li>
					</ol>
				</nav>
				<h2 class="page-title mt-1">
					<i class="bi bi-forward me-2"></i>Forward Memo
				</h2>
			</div>
			<div class="col-auto">
				<a href="{{ path('app_memo_view', {id: memo.id}) }}" class="btn btn-sm btn-outline-secondary">
					<i class="bi bi-arrow-left me-1"></i>Back to Memo
				</a>
			</div>
		</div>
	</div>
</div>

<div class="page-wrapper mt-3">
	<div class="container-xl">
		<div class="row justify-content-center">
			<div class="col-lg-8">

				{# Original memo preview #}
				<div class="card mb-3 border-0 shadow-sm">
					<div class="card-body py-3">
						<div class="d-flex align-items-center gap-2 mb-2">
							<i class="bi bi-envelope-open text-muted"></i>
							<span class="fw-semibold small">Forwarding:</span>
							<span class="text-muted small">{{ memo.subject }}</span>
						</div>
						<div class="original-preview">{{ memo.body }}</div>
					</div>
				</div>

				{# Compose card #}
				<div class="card shadow-lg border-0 memo-watermark" style="border-radius:16px;overflow:hidden;">
					<div class="memo-card-header-fwd">
						<img src="{{ asset('images/tacilogo.png') }}"
						     alt="TACI Petroleum"
						     class="memo-header-logo-sm">
						<div>
							<div class="memo-header-company-fwd">TACI_Petroleum</div>
							<div class="memo-header-sub-fwd">Forward Internal Memo</div>
						</div>
						<span class="memo-header-badge-fwd">
							<i class="bi bi-forward-fill me-1"></i>Forward
						</span>
					</div>

					<div class="card-body px-4 py-4">
						<form action="{{ path('app_memo_forward', {id: memo.id}) }}"
						      method="POST" id="fwdForm" novalidate>

							{# ── 1. Sender meta (locked) ────────────────────────── #}
							<div class="mb-4">
								<div class="row g-2">
									<div class="col-md-6">
										<label class="form-label">
											<i class="bi bi-person-circle" style="color:#0e7c7b;"></i>Forwarding As
										</label>
										<div class="sender-field">
											<i class="bi bi-lock-fill" style="font-size:.75rem;opacity:.6;"></i>
											{{ app.user.username }}
										</div>
									</div>
									<div class="col-md-6">
										<label class="form-label">
											<i class="bi bi-shield-check" style="color:#0e7c7b;"></i>By Role
										</label>
										{% set rawRole = app.user.role.value|replace({'ROLE_': ''})|replace({'_': ''}) %}
										{% set displayRole = rawRole == 'SUPERADMIN' ? 'Superadmin'
											: rawRole == 'SUBADMIN' ? 'Subadmin'
											: rawRole == 'MANAGER' ? 'Manager'
											: rawRole|capitalize %}
										<div class="sender-field" tabindex="-1" aria-disabled="true">
											<i class="bi bi-shield-fill-check" style="font-size:.8rem;color:#0e7c7b;"></i>
											<span class="role-badge">{{ displayRole|upper }}</span>
											<i class="bi bi-lock-fill ms-auto" style="font-size:.7rem;opacity:.5;"></i>
										</div>
									</div>
								</div>
							</div>

							<hr class="section-divider">

							{# ── 2. Recipients ──────────────────────────────────── #}
							<div class="mb-4">
								<label class="form-label required">
									<i class="bi bi-people" style="color:#0e7c7b;"></i>Forward To
								</label>

								<div class="dropdown w-100">
									<button class="form-select text-start d-flex align-items-center justify-content-between bg-white"
									        type="button"
									        id="recipientsDropdownBtn"
									        data-bs-toggle="dropdown"
									        aria-expanded="false"
									        data-bs-auto-close="outside"
									        style="border:1.5px solid #e2e8f0;border-radius:8px;">
										<span id="recipientsBtnLabel" class="text-muted" style="font-size:.875rem;">Select recipients…</span>
										<i class="bi bi-chevron-down ms-2 small" style="color:#a0aec0;"></i>
									</button>

									<div class="dropdown-menu p-2 w-100 bg-white"
									     aria-labelledby="recipientsDropdownBtn"
									     style="max-height:280px;overflow-y:auto;border-radius:10px;border:1.5px solid #e2e8f0;">

										<div class="px-1 pt-1">
											<input type="text" class="recipient-search" id="recipientSearch"
											       placeholder="Search users…" autocomplete="off">
										</div>

										<div class="form-check px-3 py-2 border-bottom mb-1 all-option-row">
											<input class="form-check-input" type="checkbox"
											       id="selectAllRecipients" data-select-all>
											<label class="form-check-label fw-bold text-primary" for="selectAllRecipients">
												<i class="bi bi-people-fill me-1"></i>All Recipients
											</label>
										</div>

										{% if users is empty %}
											<div class="px-3 py-2 text-muted small fst-italic">
												No eligible recipients found.
											</div>
										{% else %}
											{% for user in users %}
												<div class="form-check px-3 py-1 recipient-row" data-username="{{ user.username }}">
													<input class="form-check-input recipient-checkbox"
													       type="checkbox"
													       name="recipientIds[]"
													       value="{{ user.id }}"
													       id="rcpt_{{ user.id }}"
													       data-name="{{ user.username }}"
													       data-role="{{ user.role.value }}">
													<label class="form-check-label d-flex justify-content-between align-items-center w-100"
													       for="rcpt_{{ user.id }}">
														<span>{{ user.username }}</span>
														<span class="badge ms-2"
														      style="background:rgba(13,148,136,0.12);color:var(--primary);font-size:0.7rem;">
															{{ user.role.value|replace({'ROLE_': ''})|replace({'_': ' '})|capitalize }}
														</span>
													</label>
												</div>
											{% endfor %}
											<div class="no-results-msg px-3 py-2" id="noResults" style="display:none;">
												<i class="bi bi-search me-1"></i>No match found.
											</div>
										{% endif %}
									</div>
								</div>

								<div id="roleInputsContainer"></div>
								<div class="chips-container" id="recipientChips">
									<span class="chips-empty">
										<i class="bi bi-info-circle"></i>No recipients selected yet
									</span>
								</div>
							</div>

							<hr class="section-divider">

							{# ── 3. Forward note ───────────────────────────────── #}
							<div class="mb-4">
								<label class="form-label required" for="fwdBody">
									<i class="bi bi-body-text" style="color:#0e7c7b;"></i>Your Message
								</label>
								<textarea name="body" id="fwdBody" class="form-control"
								          rows="5" required
								          placeholder="Add context or notes before the forwarded content…"
								          style="resize:vertical;min-height:140px;"></textarea>
							</div>

							{# ── Action buttons ──────────────────────────────────── #}
							<div class="d-flex justify-content-between align-items-center pt-3 border-top">
								<a href="{{ path('app_memo_view', {id: memo.id}) }}"
								   class="text-decoration-none"
								   style="background:transparent;color:#718096;border:1.5px solid #e2e8f0;border-radius:8px;padding:.6rem 1.25rem;font-size:.875rem;font-weight:500;font-family:'Inter',sans-serif;transition:border-color .18s,color .18s;display:inline-flex;align-items:center;gap:.35rem;">
									<i class="bi bi-x-lg"></i>Cancel
								</a>
								<button type="submit" id="fwdBtn"
								        style="background:linear-gradient(135deg,#0e7c7b 0%,#0a5f5e 100%);color:#fff;border:none;border-radius:8px;padding:.625rem 1.5rem;font-size:.875rem;font-weight:600;font-family:'Inter',sans-serif;box-shadow:0 4px 12px rgba(14,124,123,.3);transition:opacity .18s,transform .15s;">
									<i class="bi bi-forward me-1"></i>Forward Memo
								</button>
							</div>

						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {

	const selectAllCb    = document.getElementById('selectAllRecipients');
	const recipientCbs   = document.querySelectorAll('.recipient-checkbox');
	const dropdownBtn    = document.getElementById('recipientsDropdownBtn');
	const btnLabel       = document.getElementById('recipientsBtnLabel');
	const chipsContainer = document.getElementById('recipientChips');
	const roleInputsCont = document.getElementById('roleInputsContainer');
	const searchInput    = document.getElementById('recipientSearch');
	const noResults      = document.getElementById('noResults');
	const fwdForm        = document.getElementById('fwdForm');
	const allowedRoles   = {{ roles|json_encode|raw }};

	function renderChips() {
		const checked = Array.from(recipientCbs).filter(c => c.checked);
		chipsContainer.innerHTML = '';
		if (checked.length === 0) {
			chipsContainer.innerHTML =
				'<span class="chips-empty"><i class="bi bi-info-circle"></i>No recipients selected yet</span>';
			return;
		}
		checked.forEach(cb => {
			const chip = document.createElement('span');
			chip.className = 'recipient-chip';
			chip.innerHTML =
				`<i class="bi bi-person-circle"></i>${cb.dataset.name}
				 <span class="chip-x" data-id="${cb.value}" title="Remove">×</span>`;
			chipsContainer.appendChild(chip);
		});
		chipsContainer.querySelectorAll('.chip-x').forEach(x => {
			x.addEventListener('click', function () {
				const cb = document.getElementById('rcpt_' + this.dataset.id);
				if (cb) { cb.checked = false; syncSelectAll(); renderChips(); updateLabel(); syncRoles(); }
			});
		});
	}

	function updateLabel() {
		const n = Array.from(recipientCbs).filter(c => c.checked).length;
		btnLabel.textContent = n === 0
			? 'Select recipients…'
			: n + ' recipient' + (n > 1 ? 's' : '') + ' selected';
		btnLabel.classList.toggle('text-muted', n === 0);
	}

	function syncSelectAll() {
		const vis  = Array.from(recipientCbs).filter(c => c.closest('.recipient-row') &&
		                          c.closest('.recipient-row').style.display !== 'none');
		const done = vis.filter(c => c.checked);
		selectAllCb.checked       = vis.length > 0 && done.length === vis.length;
		selectAllCb.indeterminate = done.length > 0 && done.length < vis.length;
	}

	function syncRoles() {
		roleInputsCont.innerHTML = '';
		if (Array.from(recipientCbs).every(c => c.checked) && recipientCbs.length > 0) {
			allowedRoles.forEach(role => {
				const inp = document.createElement('input');
				inp.type = 'hidden'; inp.name = 'recipientRoles[]'; inp.value = role;
				roleInputsCont.appendChild(inp);
			});
		}
	}

	selectAllCb.addEventListener('change', function () {
		recipientCbs.forEach(cb => {
			const row = cb.closest('.recipient-row');
			if (!row || row.style.display !== 'none') cb.checked = this.checked;
		});
		renderChips(); updateLabel(); syncRoles();
	});

	recipientCbs.forEach(cb => {
		cb.addEventListener('change', () => { syncSelectAll(); renderChips(); updateLabel(); syncRoles(); });
	});

	if (searchInput) {
		searchInput.addEventListener('input', function () {
			const q = this.value.toLowerCase().trim();
			let any = false;
			document.querySelectorAll('.recipient-row').forEach(row => {
				const show = !q || (row.dataset.username || '').toLowerCase().includes(q);
				row.style.display = show ? '' : 'none';
				if (show) any = true;
			});
			if (noResults) noResults.style.display = any ? 'none' : 'block';
			syncSelectAll();
		});
	}

	fwdForm.addEventListener('submit', function (e) {
		const hasInd  = Array.from(recipientCbs).some(c => c.checked);
		const hasRole = roleInputsCont.querySelectorAll('input').length > 0;
		if (!hasInd && !hasRole) {
			e.preventDefault();
			if (typeof Swal !== 'undefined') {
				Swal.fire({ title: 'No recipient selected', text: 'Please select at least one recipient.',
					icon: 'warning', confirmButtonColor: 'var(--primary)' });
			} else { toast.warning('Please select at least one recipient.'); }
		}
	});

	renderChips(); updateLabel();
});
</script>
{% endblock %}
