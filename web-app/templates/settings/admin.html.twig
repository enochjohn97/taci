{% extends 'base.html.twig' %}

{% block title %}Admin Panel{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-shield-lock me-2 text-primary"></i>Admin Panel</h2>
            <p class="text-muted mb-0">Global application settings and overview</p>
        </div>
        <div class="col-auto">
            <form action="{{ path('app_settings_database_backup') }}" method="POST" class="d-inline">
                <button type="submit" class="btn btn-outline-primary shadow-sm rounded-pill px-4">
                    <i class="bi bi-hdd-network me-2"></i>Backup Database
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-gradient-primary text-white shadow border-0 rounded-4 h-100 p-4" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                <h5 class="fw-bold text-white-50">Total Users</h5>
                <h1 class="display-4 fw-bold mb-0">{{ users|length }}</h1>
                <div class="mt-3"><a href="{{ path('app_settings_admin_users') }}" class="text-white text-decoration-none">Manage Users <i class="bi bi-arrow-right"></i></a></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-gradient-success text-white shadow border-0 rounded-4 h-100 p-4" style="background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);">
                <h5 class="fw-bold text-white-50">Recent Audit Logs</h5>
                <h1 class="display-4 fw-bold mb-0">{{ audit_logs|length }}</h1>
                <div class="mt-3"><a href="{{ path('app_settings_audit_log') }}" class="text-white text-decoration-none">View All Logs <i class="bi bi-arrow-right"></i></a></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-gradient-info text-white shadow border-0 rounded-4 h-100 p-4" style="background: linear-gradient(135deg, #36b9cc 0%, #258391 100%);">
                <h5 class="fw-bold text-white-50">System Health</h5>
                <h1 class="display-4 fw-bold mb-0">Good</h1>
                <div class="mt-3"><a href="{{ path('app_settings_system_info') }}" class="text-white text-decoration-none">System Info <i class="bi bi-arrow-right"></i></a></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
