{% extends 'base.html.twig' %}

{% block title %}Admin Panel – {{ app_name }}{% endblock %}

{% block content %}
<div class="container-xl py-4">

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-shield-lock me-2"></i>Admin Panel</h2>
            <p class="text-muted mb-0">Manage users, system settings, and administrative tools.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_settings_sub_admin_create') }}" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> New Sub-Admin
            </a>
            <form method="POST" action="{{ path('app_settings_database_backup') }}" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary" onclick="return confirm('Initiate database backup?')">
                    <i class="bi bi-cloud-arrow-down me-1"></i> Backup DB
                </button>
            </form>
        </div>
    </div>

    {# Quick stats #}
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded p-2">
                        <i class="bi bi-people-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="h4 mb-0">{{ users|length }}</div>
                        <div class="small text-muted">Total Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 rounded p-2">
                        <i class="bi bi-person-check-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="h4 mb-0">{{ users|filter(u => u.status == 'active')|length }}</div>
                        <div class="small text-muted">Active Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 rounded p-2">
                        <i class="bi bi-journal-text text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="h4 mb-0">{{ audit_logs|length }}</div>
                        <div class="small text-muted">Recent Logs</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-info bg-opacity-10 rounded p-2">
                        <i class="bi bi-person-x-fill text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="h4 mb-0">{{ users|filter(u => u.status != 'active')|length }}</div>
                        <div class="small text-muted">Inactive Users</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Users table #}
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">User Management</h5>
            <a href="{{ path('app_settings_admin_users') }}" class="btn btn-sm btn-outline-primary">
                View All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users|slice(0, 10) %}
                        <tr>
                            <td class="fw-semibold">{{ u.username }}</td>
                            <td class="text-muted">{{ u.email }}</td>
                            <td>
                                <span class="badge bg-{{ u.role.value == 'ROLE_SUPER_ADMIN' ? 'danger' : (u.role.value == 'ROLE_SUB_ADMIN' ? 'warning text-dark' : (u.role.value == 'ROLE_MANAGER' ? 'primary' : 'secondary')) }}">
                                    {{ u.role.value|replace({'ROLE_': ''})|replace({'_': ' '})|capitalize }}
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-{{ u.status == 'active' ? 'success' : (u.status == 'suspended' ? 'danger' : 'secondary') }}">
                                    {{ u.status|capitalize }}
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" onclick="toggleStatus({{ u.id }}, '{{ u.status }}')">
                                    <i class="bi bi-{{ u.status == 'active' ? 'pause' : 'play' }}"></i>
                                    {{ u.status == 'active' ? 'Suspend' : 'Activate' }}
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Recent Audit Log #}
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Recent Activity Log</h5>
            <a href="{{ path('app_settings_audit_log') }}" class="btn btn-sm btn-outline-primary">
                Full Log <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in audit_logs|slice(0, 15) %}
                        <tr>
                            <td class="text-muted small">{{ log.timestamp|date('M d, H:i') }}</td>
                            <td class="fw-semibold">{{ log.user ? log.user.username : 'System' }}</td>
                            <td>{{ log.action }}</td>
                            <td><span class="badge bg-light text-dark">{{ log.module }}</span></td>
                            <td class="text-muted small">{{ log.ipAddress }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No audit log entries found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
async function toggleStatus(userId, currentStatus) {
    const newStatus = currentStatus === 'active' ? 'suspended' : 'active';
    if (!confirm(`Change user status to ${newStatus}?`)) return;
    try {
        const res = await fetch(`/settings/admin/user/${userId}/status`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({status: newStatus})
        });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert('Failed: ' + (data.error || 'Unknown error'));
    } catch (err) {
        alert('Network error.');
    }
}
</script>
{% endblock %}
