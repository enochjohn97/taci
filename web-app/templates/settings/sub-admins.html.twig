{# templates/settings/sub-admins.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Manage Sub Admins - TACI Petroleum{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h2">
                <i class="fas fa-user-shield me-2"></i>Sub Admin Management
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_settings_sub_admin_create') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Sub Admin
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>{{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endfor %}

    <div class="card shadow">
        <div class="table-responsive">
            {% if sub_admins|length > 0 %}
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for subAdmin in sub_admins %}
                    <tr>
                        <td>
                            <strong>{{ subAdmin.username }}</strong>
                        </td>
                        <td>{{ subAdmin.email }}</td>
                        <td>
                            {% if subAdmin.status == 'active' %}
                                <span class="badge bg-success">Active</span>
                            {% elseif subAdmin.status == 'inactive' %}
                                <span class="badge bg-secondary">Inactive</span>
                            {% else %}
                                <span class="badge bg-danger">Suspended</span>
                            {% endif %}
                        </td>
                        <td>{{ subAdmin.createdAt.format('M d, Y H:i') }}</td>
                        <td>
                            {% if subAdmin.lastLogin %}
                                {{ subAdmin.lastLogin.format('M d, Y H:i') }}
                            {% else %}
                                <em class="text-muted">Never</em>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete({{ subAdmin.id }}, '{{ subAdmin.username }}')">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="p-5 text-center">
                <i class="fas fa-user-shield fa-3x text-muted mb-3" style="display: block;"></i>
                <p class="text-muted mb-0">No Sub Admins have been created yet.</p>
                <a href="{{ path('app_settings_sub_admin_create') }}" class="btn btn-primary btn-sm mt-3">
                    Create First Sub Admin
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-danger">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the sub-admin <strong id="subAdminName"></strong>?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id, username) {
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        document.getElementById('subAdminName').textContent = username;
        const deleteForm = document.getElementById('deleteForm');
        deleteForm.action = '{{ path('app_settings_sub_admin_delete', {'id': 'ID'}) }}'.replace('ID', id);
        modal.show();
    }
</script>
{% endblock %}
