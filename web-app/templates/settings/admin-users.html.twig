{% extends 'base.html.twig' %}

{% block title %}Manage Users{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>Manage Users</h2>
            <p class="text-muted mb-0">View and manage system users and their statuses</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">User</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Role</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Email</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Status</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="px-4 py-3 fw-bold">{{ user.username }}</td>
                                <td class="px-4 py-3"><span class="badge bg-secondary rounded-pill px-3">{{ user.role.value }}</span></td>
                                <td class="px-4 py-3 text-muted">{{ user.email }}</td>
                                <td class="px-4 py-3">
                                    <select class="form-select form-select-sm w-auto rounded-pill border-0 bg-light status-select" data-user-id="{{ user.id }}">
                                        <option value="active" {% if user.status == 'active' %}selected{% endif %}>Active</option>
                                        <option value="inactive" {% if user.status == 'inactive' %}selected{% endif %}>Inactive</option>
                                        <option value="suspended" {% if user.status == 'suspended' %}selected{% endif %}>Suspended</option>
                                    </select>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('.status-select').forEach(select => {
    select.addEventListener('change', function() {
        const userId = this.getAttribute('data-user-id');
        const status = this.value;
        
        fetch(`/settings/admin/user/${userId}/status`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ status: status })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // optional success toast
            } else {
                alert('Failed to update status');
            }
        });
    });
});
</script>
{% endblock %}
