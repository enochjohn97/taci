{% extends 'base.html.twig' %}

{% block title %}System Info{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>System Information</h2>
            <p class="text-muted">Technical overview of the TACI Petroleum platform</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="fw-bold mb-0">Software Versions</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-bold">PHP Version</span>
                            <span class="badge bg-light text-dark rounded-pill border">{{ php_version }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-bold">Symfony Framework</span>
                            <span class="badge bg-light text-dark rounded-pill border">{{ symfony_version }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="fw-bold mb-0">Database Statistics</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-bold">Total Users</span>
                            <span class="badge bg-primary rounded-pill">{{ user_count }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-bold">Total Sales Records</span>
                            <span class="badge bg-success rounded-pill">{{ sale_count }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                            <span class="text-muted fw-bold">Total Products</span>
                            <span class="badge bg-info rounded-pill">{{ product_count }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
