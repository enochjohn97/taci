                                    <form action="{{ path('app_memo_decline', {id: memo.id}) }}" method="POST" class="d-inline"><button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-circle"></i> Decline</button></form>
                                {% endif %}
