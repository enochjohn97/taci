                                    <td class="fw-semibold text-success">₦{{ sale.totalAmount|number_format(2) }}</td>
                                    <td><span class="badge bg-secondary text-capitalize">{{ sale.paymentMethod }}</span></td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted py-4">No transactions today.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {# ============================= #}
        {# --- REPORTS VIEWS --- #}
        {# ============================= #}
        {% elseif view_mode == 'reports_dashboard' %}
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm text-center">
                        <div class="h2 text-success mb-1">₦{{ total_revenue|default(0)|number_format(2) }}</div>
