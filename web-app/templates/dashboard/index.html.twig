                    <a href="{{ path('app_reports_export_inventory_csv') }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i> Export CSV</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Product</th><th>Category</th><th>Stock</th><th>Unit Price</th><th>Value</th><th>Margin %</th></tr></thead>
                        <tbody>
                            {% for row in inventory|default([]) %}
                                <tr>
                                    <td class="fw-semibold">{{ row.product.name }}</td>
                                    <td><span class="badge bg-light text-dark border">{{ row.product.category }}</span></td>
