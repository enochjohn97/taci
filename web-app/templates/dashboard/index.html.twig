                        <div class="card-header border-0 pt-4 px-4" style="background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%); color: #fff;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="opacity-75 small text-uppercase letter-spacing-1">{{ app_name }} — Official Memo</div>
                                    <h3 class="mb-0 mt-1 text-white">{{ memo.subject }}</h3>
                                </div>
                                <span class="badge bg-white text-dark">{{ memo.status|upper }}</span>
                            </div>
                        </div>
