                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <script>TaciTableExport.init('engagementTable',{selectAllId:'selectAll_engagementTable',checkboxClass:'row-checkbox-engagementTable',exportBtnId:'exportCsv_engagementTable',filename:'top-customers.csv',addSelectColumn:false,columns:[{key:'customer',label:'Customer'},{key:'tier',label:'Tier'},{key:'points',label:'Points'},{key:'spend',label:'Spend'}]});</script>

