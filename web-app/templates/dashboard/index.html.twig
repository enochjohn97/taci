{# templates/dashboard/index.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Dashboard - TACI Petroleum{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper">
    <div class="container-xl">
        <!-- Key Metrics -->
        <div class="row row-deck row-cards">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-truncate">
                            <h3 class="card-title">Today's Sales</h3>
                            <div class="h2">₦{{ total_sales_amount|number_format(2) }}</div>
                            <div class="text-muted">
                                {{ total_transactions }} transactions
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-truncate">
                            <h3 class="card-title">Low Stock Items</h3>
                            <div class="h2">{{ low_stock_products|length }}</div>
                            <div class="text-muted">
                                Items below reorder level
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-truncate">
                            <h3 class="card-title">Notifications</h3>
                            <div class="h2">{{ unread_notifications_count }}</div>
                            <div class="text-muted">
                                Unread messages
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-truncate">
                            <h3 class="card-title">System Status</h3>
                            <div class="h2"><span class="badge bg-success">Online</span></div>
                            <div class="text-muted">
                                All systems operational
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock Alert -->
        {% if low_stock_products %}
            <div class="row row-deck row-cards mt-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-exclamation-triangle"></i> Low Stock Alert</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover card-table">
                                <thead>
                                    <tr>
                                        <th>Product Name</th>
                                        <th>Category</th>
                                        <th>Current Stock</th>
                                        <th>Reorder Level</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in low_stock_products %}
                                        <tr>
                                            <td>{{ product.name }}</td>
                                            <td>{{ product.category }}</td>
                                            <td>{{ product.stockQuantity }}</td>
                                            <td>{{ product.reorderLevel }}</td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-primary">Restock</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Analytics Chart -->
        <div class="row row-deck row-cards mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-graph-up"></i> Sales Analytics</h3>
                        <div class="card-options">
                            <a href="{{ path('app_analytics') }}" class="btn btn-primary btn-sm">View Full Analytics</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="salesChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Chart.js setup - sample data
    const ctx = document.getElementById('salesChart')?.getContext('2d');
    if (ctx) {
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Daily Sales (₦)',
                    data: [12000, 19000, 3000, 5000, 2000, 3000, 15000],
                    borderColor: '#0066cc',
                    backgroundColor: 'rgba(0, 102, 204, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }
</script>
{% endblock %}
