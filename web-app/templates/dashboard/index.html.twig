            {% endif %}

            <div class="card shadow-sm">
                <div class="card-header"><h5 class="mb-0">Today's Transactions</h5></div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Time</th><th>Cashier</th><th>Items</th><th>Discount</th><th>Total</th><th>Method</th></tr></thead>
