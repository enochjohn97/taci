{# templates/dashboard/index.html.twig #}
{% extends "base.html.twig" %}

{% set view_mode = view_mode|default('dashboard') %}

{% block title %}
    {% if view_mode == 'inventory_dashboard' %}Inventory - TACI Petroleum
    {% elseif view_mode == 'fuel_dashboard' %}Fuel - TACI Petroleum
    {% elseif view_mode == 'memo_dashboard' %}Memos - TACI Petroleum
    {% elseif view_mode == 'pos_dashboard' %}POS - TACI Petroleum
    {% elseif view_mode == 'reports_dashboard' %}Reports - TACI Petroleum
    {% else %}Dashboard - TACI Petroleum
    {% endif %}
{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    {% if view_mode == 'dashboard' %}<i class="bi bi-speedometer2"></i> Dashboard
                    {% elseif view_mode starts with 'inventory' %}<i class="bi bi-box-seam"></i> Inventory Management
                    {% elseif view_mode starts with 'fuel' %}<i class="bi bi-fuel-pump"></i> Fuel Management
                    {% elseif view_mode starts with 'memo' %}<i class="bi bi-envelope-paper"></i> Internal Memos
                    {% elseif view_mode starts with 'pos' %}<i class="bi bi-cart4"></i> Point of Sale
                    {% elseif view_mode starts with 'reports' %}<i class="bi bi-graph-up"></i> Business Intelligence
                    {% elseif view_mode starts with 'loyalty' %}<i class="bi bi-star"></i> Loyalty Program
                    {% elseif view_mode starts with 'notifications' %}<i class="bi bi-bell"></i> Notifications
                    {% else %}<i class="bi bi-grid"></i> System Module
                    {% endif %}
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        
        {# --- DASHBOARD VIEW --- #}
        {% if view_mode starts with 'dashboard_' %}
            <div class="row mb-4 align-items-center">
                <div class="col">
                    <h2 class="fw-bold text-dark"><i class="bi bi-speedometer2 me-2 text-primary"></i>
                        {% if view_mode == 'dashboard_super_admin' %}Super Admin Dashboard
                        {% elseif view_mode == 'dashboard_sub_admin' %}Sub Admin Dashboard
                        {% else %}Manager Dashboard{% endif %}
                    </h2>
                    <p class="text-muted mb-0">System overview and quick metrics</p>
                </div>
            </div>
            
            <div class="row g-4 mb-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3"><i class="bi bi-cash-stack fs-4"></i></div>
                            <h5 class="fw-bold mb-0 text-white-50">Today's Sales</h5>
                        </div>
                        <h2 class="display-5 fw-bold mb-0">₦{{ total_sales_amount|default(0)|number_format(2) }}</h2>
                        <div class="mt-2 text-white-50 small">{{ total_transactions|default(0) }} transactions</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-warning text-dark">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-dark bg-opacity-10 rounded-circle p-2 me-3"><i class="bi bi-exclamation-triangle fs-4"></i></div>
                            <h5 class="fw-bold mb-0 opacity-75">Low Stock</h5>
                        </div>
                        <h2 class="display-5 fw-bold mb-0">{{ low_stock_products|default([])|length }}</h2>
                        <div class="mt-2 opacity-75 small">Items requiring restock</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-info text-white">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3"><i class="bi bi-bell-fill fs-4"></i></div>
                            <h5 class="fw-bold mb-0 text-white-50">Alerts</h5>
                        </div>
                        <h2 class="display-5 fw-bold mb-0">{{ unread_notifications_count|default(0) }}</h2>
                        <div class="mt-2 text-white-50 small">Unread notifications</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-success text-white">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3"><i class="bi bi-check-circle fs-4"></i></div>
                            <h5 class="fw-bold mb-0 text-white-50">System</h5>
                        </div>
                        <h2 class="display-5 fw-bold mb-0">Online</h2>
                        <div class="mt-2 text-white-50 small">All services operational</div>
                    </div>
                </div>
            </div>

            {% if low_stock_products|default([]) %}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Low Stock Alert</h5>
                    </div>
                    <div class="card-body p-0 mt-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Product</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Stock</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Reorder Level</th>
                                        <th class="px-4 py-3 text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in low_stock_products %}
                                        <tr>
                                            <td class="px-4 py-3 fw-bold">{{ product.name }}</td>
                                            <td class="px-4 py-3 text-danger fw-bold">{{ product.stockQuantity }}</td>
                                            <td class="px-4 py-3 text-muted">{{ product.reorderLevel }}</td>
                                            <td class="px-4 py-3 text-end">
                                                <a href="{{ path('app_inventory_product_view', {'id': product.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

        {# --- INVENTORY VIEWS --- #}
        {% elseif view_mode == 'inventory_dashboard' %}
            <div class="row row-cards">
                <div class="col-md-4">
                    <div class="card p-4">
                        <h3>Total Products: {{ total_products }}</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-4">
                        <h3 class="text-warning">Low Stock: {{ low_stock_count }}</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-4">
                        <h3>Stock Value: ₦{{ total_stock_value|number_format(2) }}</h3>
                    </div>
                </div>
            </div>
            <!-- Inventory Table Placeholder -->
            <div class="card mt-4">
                <div class="card-body text-center py-5">
                    <p class="text-muted">Detailed inventory listing is being optimized for your desktop.</p>
                    <a href="{{ path('app_inventory_products') }}" class="btn btn-primary">View All Products</a>
                </div>
            </div>

        {# --- FUEL VIEWS --- #}
        {% elseif view_mode starts with 'fuel_' %}
            {% if view_mode == 'fuel_dashboard' %}
                <div class="row mb-4 align-items-center">
                    <div class="col">
                        <h2 class="fw-bold text-dark"><i class="bi bi-fuel-pump me-2 text-primary"></i>Fuel Management</h2>
                        <p class="text-muted mb-0">Overview of fuel logistics and quotas</p>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('app_fuel_entry_new') }}" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-plus me-2"></i>Log New Entry</a>
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                            <h5 class="fw-bold text-white-50">Total Fuel Received</h5>
                            <h2 class="display-5 fw-bold mb-0">{{ total_fuel_received|default(0)|number_format }} L</h2>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0">Recent Entries</h5>
                                <a href="{{ path('app_fuel_price_history') }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
                            </div>
                            <div class="card-body p-0 mt-3">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Date</th>
                                                <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Quantity</th>
                                                <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Unit Price</th>
                                                <th class="px-4 py-3 text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for entry in entries|default([])|slice(0, 5) %}
                                                <tr>
                                                    <td class="px-4 py-3 text-muted small">{{ entry.createdAt|date('Y-m-d H:i') }}</td>
                                                    <td class="px-4 py-3 fw-bold text-primary">{{ entry.literQuantity|number_format }} L</td>
                                                    <td class="px-4 py-3 text-success fw-bold">${{ entry.unitPrice|number_format(2) }}</td>
                                                    <td class="px-4 py-3 text-end">
                                                        <button class="btn btn-sm btn-light rounded-circle" onclick="computeQuota({{ entry.id }})"><i class="bi bi-calculator"></i></button>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% elseif view_mode == 'fuel_entry' %}
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Log New Fuel Entry</h5>
                            </div>
                            <div class="card-body">
                                <form id="fuelEntryForm">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Quantity (Liters)</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" step="0.01" class="form-control bg-light border-0" id="fuelLiters" required>
                                            <span class="input-group-text bg-light border-0 text-muted">L</span>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Unit Price</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text bg-light border-0 text-muted">$</span>
                                            <input type="number" step="0.01" class="form-control bg-light border-0" id="fuelPrice">
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Submit Entry</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <script>
                document.getElementById('fuelEntryForm')?.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const liters = document.getElementById('fuelLiters').value;
                    const price = document.getElementById('fuelPrice').value;
                    fetch('{{ path("app_fuel_entry_new") }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({liters: liters, unitPrice: price})
                    }).then(r => r.json()).then(data => {
                        if(data.success) window.location.href = '{{ path("app_fuel_dashboard") }}';
                        else alert('Error: ' + data.error);
                    });
                });
                </script>
            {% elseif view_mode == 'fuel_quota_view' %}
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Quota Report #{{ report.id }}</h5>
                        <div>
                            <a href="{{ path('app_fuel_quota_download_pdf', {'id': report.id}) }}" class="btn btn-outline-danger rounded-pill px-3 me-2"><i class="bi bi-file-pdf me-2"></i>PDF</a>
                            <a href="{{ path('app_fuel_quota_download_excel', {'id': report.id}) }}" class="btn btn-outline-success rounded-pill px-3"><i class="bi bi-file-excel me-2"></i>Excel</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Daily Quota</div>
                                <div class="fs-4 fw-bold text-primary">{{ report.dailyQuotaLiters|number_format }} L</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Good Day Expected</div>
                                <div class="fs-4 fw-bold text-success">{{ report.expectedSalesGoodDay|number_format }} L</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Bad Day Expected</div>
                                <div class="fs-4 fw-bold text-warning">{{ report.expectedSalesBadDay|number_format }} L</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Forecasted Revenue</div>
                                <div class="fs-4 fw-bold text-info">${{ report.forecastedRevenue|number_format(2) }}</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Profit Margin</div>
                                <div class="fs-4 fw-bold text-dark">${{ report.profitMargin|number_format(2) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {% elseif view_mode == 'fuel_price_history' %}
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0">Fuel Price & Entry History</h5>
                    </div>
                    <div class="card-body p-0 mt-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Date</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Quantity</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Unit Price</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Entered By</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for entry in entries|default([]) %}
                                        <tr>
                                            <td class="px-4 py-3 text-muted small">{{ entry.createdAt|date('M d, Y H:i') }}</td>
                                            <td class="px-4 py-3 fw-bold text-primary">{{ entry.literQuantity|number_format }} L</td>
                                            <td class="px-4 py-3 text-success fw-bold">${{ entry.unitPrice|number_format(2) }}</td>
                                            <td class="px-4 py-3">{{ entry.enteredBy.username }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
            <script>
            function computeQuota(entryId) {
                fetch('{{ path("app_fuel_quota_compute") }}', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({entryId: entryId})
                }).then(r => r.json()).then(data => {
                    if(data.success) window.location.href = '/fuel/quota/' + data.reportId;
                    else alert('Error computing quota');
                });
            }
            </script>

        {# --- MEMO VIEWS --- #}
        {% elseif view_mode == 'memo_dashboard' %}
            <div class="row">
                <div class="col-md-3">
                    <div class="list-group mb-4">
                        <a href="{{ path('app_memo_dashboard') }}" class="list-group-item list-group-item-action active">
                            <i class="bi bi-inbox me-2"></i> Inbox ({{ unread_count }})
                        </a>
                        <a href="{{ path('app_memo_new') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-pencil-square me-2"></i> New Memo
                        </a>
                    </div>
                    
                    <div class="card bg-dark border-secondary">
                        <div class="card-body p-3">
                            <h6 class="text-uppercase text-muted small mb-3">Folders</h6>
                            <ul class="nav nav-pills flex-column">
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-1 px-0"><i class="bi bi-send me-2"></i> Sent</a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-1 px-0"><i class="bi bi-file-earmark me-2"></i> Drafts</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Recent Memos</h5>
                            <a href="{{ path('app_memo_new') }}" class="btn btn-sm btn-primary">Create New</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sender</th>
                                        <th>Subject</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in inbox %}
                                        <tr class="{% if not item.isRead %}fw-bold{% endif %}">
                                            <td>{{ item.memo.sender.username }}</td>
                                            <td>{{ item.memo.subject }}</td>
                                            <td>{{ item.memo.createdAt|date('M d, H:i') }}</td>
                                            <td>
                                                <span class="badge bg-{{ item.memo.status == 'approved' ? 'success' : (item.memo.status == 'declined' ? 'danger' : 'info') }}">
                                                    {{ item.memo.status|capitalize }}
                                                </span>
                                            </td>
                                            <td>
                                                <a href="{{ path('app_memo_view', {'id': item.memo.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">Your inbox is empty.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        {% elseif view_mode == 'memo_view' %}
            <div class="row">
                <div class="col-md-8 mx-auto">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <div>
                                <a href="{{ path('app_memo_dashboard') }}" class="btn btn-sm btn-outline-secondary me-2">
                                    <i class="bi bi-arrow-left"></i>
                                </a>
                                <h5 class="d-inline mb-0">View Memo</h5>
                            </div>
                            <div class="badge bg-{{ memo.status == 'approved' ? 'success' : (memo.status == 'declined' ? 'danger' : 'info') }} p-2">
                                {{ memo.status|upper }}
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                                <div>
                                    <h3 class="mb-1">{{ memo.subject }}</h3>
                                    <div class="text-muted small">
                                        From: <strong>{{ memo.sender.username }}</strong> 
                                        &bull; {{ memo.createdAt|date('F d, Y H:i') }}
                                    </div>
                                </div>
                            </div>
                            
                            <div class="memo-content py-3" style="white-space: pre-wrap;">
                                {{ memo.body }}
                            </div>

                            {% if memo.attachments|length > 0 %}
                                <div class="mt-4 border-top pt-3">
                                    <h6>Attachments</h6>
                                    <div class="list-group list-group-flush">
                                        {% for attachment in memo.attachments %}
                                            <a href="{{ attachment.filePath }}" class="list-group-item list-group-item-action py-2 px-0 border-0" target="_blank">
                                                <i class="bi bi-paperclip me-2"></i> {{ attachment.fileName }} 
                                                <span class="text-muted small">({{ (attachment.fileSize / 1024)|number_format(0) }} KB)</span>
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="card-footer bg-light d-flex justify-content-between">
                            <div>
                                {% if is_granted('ROLE_SUPER_ADMIN') and memo.status == 'sent' %}
                                    <form action="{{ path('app_memo_approve', {'id': memo.id}) }}" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-success me-2">
                                            <i class="bi bi-check-circle"></i> Approve
                                        </button>
                                    </form>
                                    <form action="{{ path('app_memo_decline', {'id': memo.id}) }}" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-x-circle"></i> Decline
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                            <button class="btn btn-primary" data-bs-toggle="collapse" href="#replyForm">
                                <i class="bi bi-reply"></i> Reply
                            </button>
                        </div>
                    </div>

                    <div class="collapse mb-4" id="replyForm">
                        <div class="card shadow-sm border-primary">
                            <div class="card-body">
                                <form action="{{ path('app_memo_reply', {'id': memo.id}) }}" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label">Your Reply</label>
                                        <textarea name="body" class="form-control" rows="4" required placeholder="Type your message here..."></textarea>
                                    </div>
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary">Send Reply</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    {% if replies|length > 0 %}
                        <h6 class="text-muted mb-3">Conversation History</h6>
                        {% for reply in replies %}
                            <div class="card shadow-sm mb-3 {% if reply.sender == app.user %}ms-5 bg-light{% else %}me-5{% endif %}">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <strong class="small">{{ reply.sender.username }}</strong>
                                        <span class="text-muted smallest">{{ reply.createdAt|date('M d, H:i') }}</span>
                                    </div>
                                    <div class="small">{{ reply.body }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

        {% elseif view_mode == 'memo_form' %}
            <div class="row">
                <div class="col-md-8 mx-auto">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Create Internal Memo</h5>
                        </div>
                        <div class="card-body">
                            <form action="{{ path('app_memo_new') }}" method="POST" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label class="form-label">Recipients (Select Multiple)</label>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="small text-muted">Specific Users</label>
                                            <select name="recipientIds[]" class="form-select" multiple size="5">
                                                {% for user in users %}
                                                    {% if user != app.user %}
                                                        <option value="{{ user.id }}">{{ user.username }} ({{ user.role.value }})</option>
                                                    {% endif %}
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="small text-muted">By Role</label>
                                            <select name="recipientRoles[]" class="form-select" multiple size="5">
                                                {% for role in roles %}
                                                    <option value="{{ role }}">{{ role|replace({'ROLE_': ''})|capitalize }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-text">Hold Ctrl/Cmd to select multiple.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Subject</label>
                                    <input type="text" name="subject" class="form-control" required placeholder="e.g. Request for Stock Replenishment">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Message Body</label>
                                    <textarea name="body" class="form-control" rows="8" required></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Attachments (Optional)</label>
                                    <input type="file" name="attachments[]" class="form-control" multiple>
                                    <div class="form-text">Max 10MB per file.</div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <a href="{{ path('app_memo_dashboard') }}" class="btn btn-outline-secondary">Cancel</a>
                                    <div>
                                        <button type="submit" name="status" value="draft" class="btn btn-outline-primary me-2">Save Draft</button>
                                        <button type="submit" name="status" value="sent" class="btn btn-primary px-4">Send Memo</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        {# --- POS VIEWS --- #}
        {% elseif view_mode starts with 'pos_' %}
            {% if view_mode == 'pos_dashboard' or view_mode == 'pos_register' %}
                <div class="row g-4 h-100">
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0">Product Lookup</h5>
                                <div class="input-group w-50">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control bg-light border-0" id="posSearch" placeholder="Search products or scan barcode...">
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row g-3" id="posProductGrid">
                                    {% for product in products|default([]) %}
                                        <div class="col-md-4 col-lg-3 product-card" data-name="{{ product.name|lower }}" data-barcode="{{ product.barcode }}">
                                            <div class="card h-100 border rounded-3 hover-shadow cursor-pointer" onclick="addToCart({{ product.id }}, '{{ product.name|escape('js') }}', {{ product.unitPrice }})">
                                                <div class="card-body text-center p-3">
                                                    <h6 class="fw-bold text-dark mb-1 text-truncate">{{ product.name }}</h6>
                                                    <h5 class="text-success fw-bold mb-0">${{ product.unitPrice|number_format(2) }}</h5>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-light d-flex flex-column">
                            <div class="card-header bg-white border-0 pt-4 pb-3">
                                <h5 class="fw-bold mb-0">Current Order</h5>
                            </div>
                            <div class="card-body flex-grow-1 overflow-auto p-0" id="cartContainer">
                                <div class="text-center text-muted mt-5" id="emptyCartMsg">
                                    <i class="bi bi-cart display-1 d-block mb-3 opacity-25"></i>
                                    Cart is empty
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 pb-4 pt-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted fw-bold">Subtotal</span>
                                    <span class="fw-bold" id="cartSubtotal">$0.00</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted fw-bold">Discount</span>
                                    <span class="text-danger fw-bold" id="cartDiscount">-$0.00</span>
                                </div>
                                <div class="d-flex justify-content-between mb-4 border-top pt-2 mt-2">
                                    <span class="text-dark fw-bold fs-5">Total</span>
                                    <span class="text-success fw-bold fs-4" id="cartTotal">$0.00</span>
                                </div>
                                <button class="btn btn-primary btn-lg w-100 rounded-pill fw-bold" onclick="checkout()">Checkout</button>
                            </div>
                        </div>
                    </div>
                </div>
                <script>
                let cart = {};
                function addToCart(id, name, price) {
                    if(cart[id]) cart[id].qty++;
                    else cart[id] = {name: name, price: price, qty: 1};
                    renderCart();
                }
                function renderCart() {
                    let html = '<ul class="list-group list-group-flush">';
                    let total = 0;
                    for(let id in cart) {
                        let item = cart[id];
                        let subtotal = item.price * item.qty;
                        total += subtotal;
                        html += `
                        <li class="list-group-item bg-transparent px-4 py-3 border-0 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0 fw-bold">${item.name}</h6>
                                    <small class="text-muted">$${item.price.toFixed(2)} x ${item.qty}</small>
                                </div>
                                <div class="fw-bold">$${subtotal.toFixed(2)}</div>
                            </div>
                        </li>`;
                    }
                    html += '</ul>';
                    document.getElementById('cartContainer').innerHTML = Object.keys(cart).length ? html : '<div class="text-center text-muted mt-5"><i class="bi bi-cart display-1 d-block mb-3 opacity-25"></i>Cart is empty</div>';
                    document.getElementById('cartSubtotal').textContent = '$' + total.toFixed(2);
                    document.getElementById('cartTotal').textContent = '$' + total.toFixed(2);
                }
                function checkout() {
                    if(!Object.keys(cart).length) return alert('Cart is empty');
                    let items = [];
                    for(let id in cart) items.push({productId: id, quantity: cart[id].qty});
                    
                    fetch('/store/checkout', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({items: items, paymentMethod: 'cash', discountAmount: 0})
                    }).then(r => r.json()).then(data => {
                        if(data.success) {
                            alert('Checkout successful! Sale ID: ' + data.saleId);
                            cart = {}; renderCart();
                        } else alert('Error: ' + data.error);
                    });
                }
                document.getElementById('posSearch')?.addEventListener('keyup', function(e) {
                    let term = e.target.value.toLowerCase();
                    document.querySelectorAll('.product-card').forEach(card => {
                        if(card.dataset.name.includes(term) || card.dataset.barcode.includes(term)) card.style.display = '';
                        else card.style.display = 'none';
                    });
                });
                </script>
            {% elseif view_mode == 'pos_daily_summary' %}
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0">Daily POS Summary</h5>
                    </div>
                    <div class="card-body text-center py-5">
                        <i class="bi bi-receipt display-1 text-primary opacity-50 mb-3 d-block"></i>
                        <h3 class="fw-bold">Total Revenue: $4,520.00</h3>
                        <p class="text-muted">Today's register summary will be displayed here in detail.</p>
                    </div>
                </div>
            {% endif %}

        {# --- ANALYTICS/REPORTS --- #}
        {% elseif view_mode starts with 'reports_' %}
            <div class="row mb-4 align-items-center">
                <div class="col">
                    <h2 class="fw-bold text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>Business Intelligence</h2>
                    <p class="text-muted mb-0">System reporting and analytics</p>
                </div>
                <div class="col-auto">
                    <div class="btn-group shadow-sm rounded-pill">
                        <a href="{{ path('app_reports_dashboard') }}" class="btn btn-{% if view_mode == 'reports_dashboard' %}primary{% else %}light{% endif %} rounded-start-pill px-4">Overview</a>
                        <a href="{{ path('app_reports_sales') }}" class="btn btn-{% if view_mode == 'reports_sales' %}primary{% else %}light{% endif %} px-4">Sales</a>
                        <a href="{{ path('app_reports_inventory') }}" class="btn btn-{% if view_mode == 'reports_inventory' %}primary{% else %}light{% endif %} px-4">Inventory</a>
                        <a href="{{ path('app_reports_profit_loss') }}" class="btn btn-{% if view_mode == 'reports_profit_loss' %}primary{% else %}light{% endif %} rounded-end-pill px-4">Profit/Loss</a>
                    </div>
                </div>
            </div>
            
            {% if view_mode == 'reports_dashboard' %}
                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-0">
                                <h5 class="fw-bold mb-0">Revenue Trends</h5>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 300px;">
                                <div class="text-center text-muted">
                                    <i class="bi bi-bar-chart display-1 opacity-25 mb-3 d-block"></i>
                                    <p>Interactive chart visualization component loading...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                            <div class="card-body p-4 d-flex flex-column justify-content-center text-center">
                                <h5 class="fw-bold text-white-50 mb-3">Total Revenue YTD</h5>
                                <h1 class="display-4 fw-bold mb-4">₦14.2M</h1>
                                <div class="bg-white bg-opacity-10 rounded-4 p-3 text-start">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-white-50">vs Last Year</span>
                                        <span class="text-white fw-bold"><i class="bi bi-arrow-up text-success me-1"></i> 12%</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-white-50">Profit Margin</span>
                                        <span class="text-white fw-bold">24.5%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">{{ view_mode|replace({'reports_': ''})|replace({'_': ' '})|title }} Report</h5>
                        <button class="btn btn-outline-secondary rounded-pill btn-sm px-3"><i class="bi bi-download me-2"></i>Export CSV</button>
                    </div>
                    <div class="card-body p-0 mt-3">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Period</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Metric 1</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Metric 2</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Metric 3</th>
                                        <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="px-4 py-3 text-muted small">Q1 2024</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3 fw-bold text-success">$10,234.00</td>
                                    </tr>
                                    <tr>
                                        <td class="px-4 py-3 text-muted small">Q2 2024</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3">Data...</td>
                                        <td class="px-4 py-3 fw-bold text-success">$12,450.00</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

        {# --- LOYALTY VIEWS --- #}
        {% elseif view_mode starts with 'loyalty_' %}
            <div class="row mb-4 align-items-center">
                <div class="col">
                    <h2 class="fw-bold text-dark"><i class="bi bi-star me-2 text-primary"></i>Loyalty Program</h2>
                    <p class="text-muted mb-0">Customer points and rewards management</p>
                </div>
            </div>
            {% if view_mode == 'loyalty_my_points' %}
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                            <i class="bi bi-award display-1 mb-3 text-white-50"></i>
                            <h4 class="fw-bold mb-1">Your Points Balance</h4>
                            <h1 class="display-3 fw-bold mb-4">{{ points|default(0) }} pts</h1>
                            <p class="text-white-50 mb-0">You are currently a <strong class="text-white">{{ tier|default('Standard') }}</strong> member.</p>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="fw-bold mb-0">Loyalty Management: {{ view_mode|replace({'loyalty_': ''})|replace({'_': ' '})|title }}</h5>
                    </div>
                    <div class="card-body text-center py-5">
                        <i class="bi bi-gift display-1 text-primary opacity-50 mb-3 d-block"></i>
                        <p class="text-muted mb-0">The {{ view_mode|replace({'loyalty_': ''}) }} module interface is being updated.</p>
                    </div>
                </div>
            {% endif %}

        {# --- AUTH RECOVERY VIEWS --- #}
        {% elseif view_mode == 'auth_password_recovery' %}
            <div class="card p-5 mx-auto" style="max-width: 500px;">
                <h3 class="text-center mb-4">Recover Password</h3>
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="email" class="form-control" required placeholder="Enter your registered email">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Send Recovery Link</button>
                </form>
            </div>

        {% elseif view_mode == 'auth_password_reset' %}
            <div class="card p-5 mx-auto" style="max-width: 500px;">
                <h3 class="text-center mb-4">Reset Password</h3>
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirm_password" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Update Password</button>
                </form>
            </div>

        {# --- FALLBACK --- #}
        {% else %}
            <div class="card p-5 text-center">
                <h2 class="text-warning">Module Incomplete</h2>
                <p>The <strong>{{ view_mode }}</strong> module is currently being refined for the distraction-free interface.</p>
                <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary mt-3">Return to Dashboard</a>
            </div>
        {% endif %}
        
    </div>
</div>
{% endblock %}
