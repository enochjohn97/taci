                                {% for p in ['daily','weekly','monthly','yearly'] %}
                                    <option value="{{ p }}" {{ period|default('daily') == p ? 'selected' : '' }}>{{ p|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">From</label>
                            <input type="date" name="startDate" class="form-control" value="{{ start_date|default('')|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">To</label>
                            <input type="date" name="endDate" class="form-control" value="{{ end_date|default('')|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Apply Filter</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm text-center">
                        <div class="h2 text-success mb-1">₦{{ total_amount|default(0)|number_format(2) }}</div>
                        <div class="text-muted">Total Sales Amount</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm text-center">
                        <div class="h2 text-danger mb-1">₦{{ total_discount|default(0)|number_format(2) }}</div>
                        <div class="text-muted">Total Discounts Given</div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h5 class="mb-0">Sales Trend</h5></div>
                <div class="card-body"><canvas id="salesTrendChart" height="80"></canvas></div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="mb-0">Sales by {{ period|default('day')|capitalize }}</h5>
                    <div class="d-flex gap-2">
                        <button type="button" id="exportCsv_salesTable" class="btn btn-sm btn-outline-success"><i class="bi bi-download me-1"></i> Export CSV</button>
                        <a href="{{ path('app_reports_export_sales_excel') }}" class="btn btn-sm btn-outline-success"><i class="bi bi-file-excel me-1"></i> Excel</a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="salesTable">
                        <thead class="table-light"><tr>
                            <th><input type="checkbox" id="selectAll_salesTable"></th>
                            <th>Period</th><th>Transactions</th><th>Revenue</th><th>Discounts</th>
                        </tr></thead>
                        <tbody>
                            {% for period_key, group in grouped_sales|default({}) %}
                                <tr data-period="{{ period_key }}" data-count="{{ group.count }}" data-revenue="{{ group.amount }}" data-discount="{{ group.discount }}">
                                    <td><input type="checkbox" class="row-checkbox-salesTable"></td>
                                    <td class="fw-semibold">{{ period_key }}</td>
                                    <td>{{ group.count }}</td>
                                    <td class="text-success">₦{{ group.amount|number_format(2) }}</td>
                                    <td class="text-danger">₦{{ group.discount|number_format(2) }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted py-4">No sales data for the selected period.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <script>
                (function(){
                    const labels = [], amounts = [];
                    document.querySelectorAll('#salesTable tbody tr[data-period]').forEach(r => {
                        labels.push(r.dataset.period);
                        amounts.push(parseFloat(r.dataset.revenue) || 0);
                    });
                    if (labels.length && document.getElementById('salesTrendChart')) {
                        new Chart(document.getElementById('salesTrendChart'), {
                            type: 'line',
                            data: { labels, datasets: [{ label: 'Revenue ₦', data: amounts, borderColor: '#0d9488', fill: true, backgroundColor: 'rgba(13,148,136,0.15)' }] },
                            options: { responsive: true }
                        });
                    }
                    TaciTableExport.init('salesTable', {
                        selectAllId: 'selectAll_salesTable', checkboxClass: 'row-checkbox-salesTable',
                        exportBtnId: 'exportCsv_salesTable', filename: 'sales-report.csv', addSelectColumn: false,
                        columns: [{key:'period',label:'Period'},{key:'count',label:'Transactions'},{key:'revenue',label:'Revenue'},{key:'discount',label:'Discounts'}]
                    });
                })();
            </script>

        {% elseif view_mode == 'reports_inventory' %}
