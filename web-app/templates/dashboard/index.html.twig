                        <div class="progress flex-grow-1" style="height:20px;">
                            <div class="progress-bar bg-success" style="width:100%">₦{{ total_revenue|default(0)|number_format(0) }}</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="fw-semibold" style="width:180px;">Cost of Goods</div>
