                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="small text-muted">Specific Users</label>
                                            <select name="recipientIds[]" class="form-select" multiple size="5">
                                                {% for user in users %}{% if user != app.user %}<option value="{{ user.id }}">{{ user.username }} ({{ user.role.value }})</option>{% endif %}{% endfor %}
                                            </select>
