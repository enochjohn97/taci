        {# --- NOTIFICATIONS VIEW --- #}
        {# ============================= #}
        {% elseif view_mode == 'notifications' or view_mode == 'notifications_index' %}
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">All Notifications</h5>
                    {% if notifications|default([])|length > 0 %}
                        <button id="markAllReadBtn" class="btn btn-sm btn-outline-secondary">Mark All Read</button>
                    {% endif %}
                </div>
                <div class="list-group list-group-flush">
                    {% for notification in notifications|default([]) %}
                        <a href="{{ notification.link ?: '#' }}" class="list-group-item list-group-item-action d-flex align-items-start gap-3 {{ not notification.isRead ? 'bg-primary bg-opacity-5' : '' }}">
                            <div class="bg-{{ notification.type == 'low_stock' ? 'warning' : 'info' }} bg-opacity-15 rounded p-2 mt-1">
                                <i class="bi bi-{{ notification.type == 'low_stock' ? 'exclamation-triangle text-warning' : 'bell text-info' }}"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-{{ not notification.isRead ? 'bold' : 'normal' }}">{{ notification.message }}</div>
                                <div class="small text-muted">{{ notification.createdAt|date('M d, Y H:i') }}</div>
                            </div>
                            {% if not notification.isRead %}
                                <span class="badge bg-primary rounded-pill">New</span>
                            {% endif %}
                        </a>
                    {% else %}
                        <div class="list-group-item text-center text-muted py-5">
                            <i class="bi bi-bell-slash fs-1 mb-2 d-block"></i>
                            No notifications yet.
                        </div>
                    {% endfor %}
                </div>
            </div>
            <script>
                const markAllReadBtn = document.getElementById('markAllReadBtn');
                if (markAllReadBtn) {
                    markAllReadBtn.addEventListener('click', async () => {
                        const response = await fetch('{{ path('app_notifications_mark_all_read') }}', { method: 'POST' });
                        const data = await response.json();
                        if (data.success) {
                            location.reload();
                        }
                    });
                }
            </script>

