        {% elseif view_mode == 'pos_dashboard' or view_mode == 'pos_register' %}
            <div class="row g-3">
                {# Product Panel #}
                <div class="col-lg-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input type="text" id="posSearch" class="form-control" placeholder="Search product or scan barcode…">
                            </div>
                        </div>
                        <div class="card-body p-2">
                            <div class="row g-2" id="productGrid">
                                {% for product in products %}
                                    <div class="col-6 col-md-4 product-tile"
                                         data-name="{{ product.name|lower }}"
                                         data-id="{{ product.id }}"
                                         data-price="{{ product.unitPrice }}"
                                         data-stock="{{ product.stockQuantity }}">
                                        <div class="card h-100 p-2 text-center border {{ product.stockQuantity <= 0 ? 'opacity-50' : '' }}"
                                             style="cursor: {{ product.stockQuantity > 0 ? 'pointer' : 'not-allowed' }};"
                                             onclick="{{ product.stockQuantity > 0 ? 'addToCart(' ~ product.id ~ ', \'' ~ product.name|e('js') ~ '\', ' ~ product.unitPrice ~ ')' : '' }}">
                                            <div class="bg-primary bg-opacity-10 rounded mb-2 py-2">
                                                <i class="bi bi-box text-primary fs-4"></i>
                                            </div>
                                            <div class="small fw-semibold mb-1">{{ product.name }}</div>
                                            <div class="text-primary fw-bold">₦{{ product.unitPrice|number_format(2) }}</div>
                                            <div class="badge bg-{{ product.stockQuantity <= product.reorderLevel ? 'danger' : 'success' }} mt-1">
                                                {{ product.stockQuantity }} in stock
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="col-12 text-center text-muted py-5">No products available.</div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Cart Panel #}
                <div class="col-lg-5">
                    <div class="card shadow-sm h-100 d-flex flex-column">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-cart3 me-2"></i>Current Transaction</h5>
                        </div>
                        <div class="card-body p-0 flex-grow-1 overflow-auto" style="max-height: 340px;">
                            <table class="table table-sm mb-0" id="cartTable">
                                <thead class="table-light sticky-top">
                                    <tr><th>Item</th><th>Qty</th><th>Price</th><th></th></tr>
                                </thead>
                                <tbody id="cartBody">
                                    <tr id="emptyCart"><td colspan="4" class="text-center text-muted py-4">Cart is empty</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer">
                            <div class="mb-2">
                                <label class="small text-muted">Discount (₦)</label>
                                <input type="number" id="discountInput" class="form-control form-control-sm" value="0" min="0" oninput="updateTotals()">
                            </div>
                            <div class="mb-2">
                                <label class="small text-muted">Payment Method</label>
                                <select id="paymentMethod" class="form-select form-select-sm">
                                    <option value="cash">Cash</option>
                                    <option value="card">Card</option>
                                    <option value="transfer">Bank Transfer</option>
                                    <option value="pos">POS Terminal</option>
                                </select>
                            </div>
                            <div class="d-flex justify-content-between fw-bold fs-5 mb-3 pt-2 border-top">
                                <span>TOTAL:</span>
                                <span class="text-primary" id="cartTotal">₦0.00</span>
                            </div>
                            <div id="posAlert"></div>
                            <button class="btn btn-success w-100 btn-lg" id="checkoutBtn" onclick="checkout()" disabled>
                                <i class="bi bi-check2-circle me-2"></i> Checkout
                            </button>
                            <button class="btn btn-outline-danger w-100 mt-2" onclick="clearCart()">
                                <i class="bi bi-trash me-1"></i> Clear Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {# Receipt Modal #}
            <div class="modal fade" id="receiptModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Transaction Complete</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body" id="receiptBody"></div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print</button>
                            <button class="btn btn-primary" data-bs-dismiss="modal" onclick="clearCart()">New Transaction</button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
            let cart = {};
            function addToCart(id, name, price) {
                if (cart[id]) { cart[id].qty++; }
                else { cart[id] = {id, name, price, qty: 1}; }
                renderCart();
            }
            function removeFromCart(id) { delete cart[id]; renderCart(); }
            function changeQty(id, delta) {
                if (!cart[id]) return;
                cart[id].qty += delta;
                if (cart[id].qty <= 0) delete cart[id];
                renderCart();
            }
            function clearCart() { cart = {}; renderCart(); }
            function renderCart() {
                const body = document.getElementById('cartBody');
                const empty = document.getElementById('emptyCart');
                const keys = Object.keys(cart);
                if (keys.length === 0) {
                    body.innerHTML = '<tr id="emptyCart"><td colspan="4" class="text-center text-muted py-4">Cart is empty</td></tr>';
                    document.getElementById('checkoutBtn').disabled = true;
                    document.getElementById('cartTotal').textContent = '₦0.00';
                    return;
                }
                body.innerHTML = keys.map(id => {
                    const item = cart[id];
                    return `<tr>
                        <td class="small fw-semibold">${item.name}</td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-1" onclick="changeQty(${id},-1)">-</button>
                                <span>${item.qty}</span>
                                <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-1" onclick="changeQty(${id},1)">+</button>
                            </div>
                        </td>
                        <td class="small">₦${(item.price * item.qty).toLocaleString('en-NG',{minimumFractionDigits:2})}</td>
                        <td><button class="btn btn-xs btn-outline-danger btn-sm py-0 px-1" onclick="removeFromCart(${id})"><i class="bi bi-x"></i></button></td>
                    </tr>`;
                }).join('');
                document.getElementById('checkoutBtn').disabled = false;
                updateTotals();
            }
            function updateTotals() {
                const subtotal = Object.values(cart).reduce((s, i) => s + i.price * i.qty, 0);
                const discount = parseFloat(document.getElementById('discountInput').value) || 0;
                const total = Math.max(0, subtotal - discount);
                document.getElementById('cartTotal').textContent = '₦' + total.toLocaleString('en-NG', {minimumFractionDigits:2});
            }
            async function checkout() {
                const btn = document.getElementById('checkoutBtn');
                btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing…';
                const items = Object.values(cart).map(i => ({productId: i.id, quantity: i.qty}));
                const discount = parseFloat(document.getElementById('discountInput').value) || 0;
                const paymentMethod = document.getElementById('paymentMethod').value;
                try {
                    const res = await fetch('{{ path('app_pos_create_transaction') }}', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({items, discountAmount: discount, paymentMethod})
                    });
                    const data = await res.json();
                    if (data.success) {
                        const rows = data.items.map(i => `<tr><td>${i.name}</td><td>${i.quantity}</td><td>₦${parseFloat(i.subtotal).toLocaleString('en-NG',{minimumFractionDigits:2})}</td></tr>`).join('');
                        document.getElementById('receiptBody').innerHTML = `
                            <p class="text-muted small mb-3">Sale ID: #${data.saleId} &bull; ${data.timestamp}</p>
                            <table class="table table-sm"><thead class="table-light"><tr><th>Item</th><th>Qty</th><th>Amount</th></tr></thead><tbody>${rows}</tbody></table>
                            <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2 mt-2">
                                <span>TOTAL PAID (${data.paymentMethod.toUpperCase()}):</span>
                                <span class="text-success">₦${parseFloat(data.totalAmount).toLocaleString('en-NG',{minimumFractionDigits:2})}</span>
                            </div>`;
                        new bootstrap.Modal(document.getElementById('receiptModal')).show();
                    } else {
                        document.getElementById('posAlert').innerHTML = `<div class="alert alert-danger alert-sm">${data.error || 'Transaction failed.'}</div>`;
                    }
                } catch(e) {
                    document.getElementById('posAlert').innerHTML = '<div class="alert alert-danger">Network error.</div>';
                }
                btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle me-2"></i> Checkout';
            }
            document.getElementById('posSearch').addEventListener('input', function() {
                const q = this.value.toLowerCase();
                document.querySelectorAll('.product-tile').forEach(el => {
                    el.style.display = el.dataset.name.includes(q) ? '' : 'none';
                });
            });
            </script>

        {% elseif view_mode == 'pos_daily_summary' %}
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm text-center">
