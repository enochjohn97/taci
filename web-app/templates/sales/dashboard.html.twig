{# templates/sales/dashboard.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Sales Dashboard – {{ app_name }}{% endblock %}

{% block content %}
<style>
    /* Custom styles for the Sales Dashboard */
    .sd-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        padding: 24px;
        border: 1px solid #f1f5f9;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .sd-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }
    .sd-stat-box {
        text-align: center;
        padding: 16px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .sd-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 1.2rem;
    }
    .sd-stat-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }
    .sd-stat-value {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
    }
    .sd-chart-title {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #334155;
        letter-spacing: 0.02em;
        margin-bottom: 4px;
    }
    .sd-chart-subtitle {
        font-size: 0.7rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 20px;
    }
    .sd-btn-group .btn {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 6px 14px;
        border-color: #e2e8f0;
        color: #64748b;
        background: #ffffff;
    }
    .sd-btn-group .btn.active, .sd-btn-group .btn:hover {
        background: #f8fafc;
        color: #0f172a;
        border-color: #cbd5e1;
    }
    [data-theme="dark"] .sd-card {
        background: #1e293b;
        border-color: #334155;
    }
    [data-theme="dark"] .sd-btn-group .btn {
        background: #1e293b;
        border-color: #334155;
        color: #cbd5e1;
    }
    [data-theme="dark"] .sd-btn-group .btn.active, [data-theme="dark"] .sd-btn-group .btn:hover {
        background: #334155;
        color: #ffffff;
    }
    [data-theme="dark"] .sd-stat-value { color: #f8fafc; }
    [data-theme="dark"] .sd-stat-title { color: #94a3b8; }
    [data-theme="dark"] .sd-chart-title { color: #e2e8f0; }
</style>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="m-0 font-weight-bold" style="font-size: 1.4rem; color: var(--text-main);">Sales Dashboard</h2>
        
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="text-muted" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Timeframe</span>
            <div class="btn-group sd-btn-group" role="group" id="timeframeBtnGroup">
                <button type="button" class="btn active" data-tf="today">Today</button>
                <button type="button" class="btn" data-tf="week">Week</button>
                <button type="button" class="btn" data-tf="month">Month</button>
                <button type="button" class="btn" data-tf="quarter">Quarter</button>
                <button type="button" class="btn" data-tf="year">Year</button>
                <button type="button" class="btn" data-tf="all">All</button>
            </div>
            
            <div class="btn-list ms-2">

                <a href="{{ path('app_sales_fuel') }}" class="btn btn-primary btn-sm px-3">
                    <i class="fa-solid fa-gas-pump me-1"></i> Fuel Sales
                </a>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-4 mb-4">
        <!-- KPI 1 -->
        <div class="col-6 col-md-3">
            <div class="sd-card sd-stat-box">
                <div class="sd-icon-wrapper" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <div class="sd-stat-title">Total Revenue</div>
                <div class="sd-stat-value">₦{{ (total_revenue / 1000000)|number_format(1) }}M</div>
            </div>
        </div>
        <!-- KPI 2 -->
        <div class="col-6 col-md-3">
            <div class="sd-card sd-stat-box">
                <div class="sd-icon-wrapper" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <div class="sd-stat-title">Transactions</div>
                <div class="sd-stat-value">{{ transaction_count|number_format(0) }}</div>
            </div>
        </div>
        <!-- KPI 3 -->
        <div class="col-6 col-md-3">
            <div class="sd-card sd-stat-box">
                <div class="sd-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div class="sd-stat-title">Avg. Ticket Size</div>
                <div class="sd-stat-value">₦{{ avg_ticket >= 1000 ? (avg_ticket / 1000)|number_format(1) : avg_ticket|number_format(0) }}{{ avg_ticket >= 1000 ? "K" : "" }}</div>
            </div>
        </div>
        <!-- KPI 4 -->
        <div class="col-6 col-md-3">
            <div class="sd-card sd-stat-box">
                <div class="sd-icon-wrapper" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="sd-stat-title">Daily Customers</div>
                <div class="sd-stat-value">{{ (transaction_count > 0 ? (transaction_count * 0.9) : 0)|number_format(0) }}</div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-4 mb-4">
        <!-- Doughnut Chart -->
        <div class="col-lg-4">
            <div class="sd-card">
                <div>
                    <div class="sd-chart-title text-center">Total Sales</div>
                    <div class="sd-chart-subtitle text-center">By Department</div>
                </div>
                <div class="flex-grow-1 d-flex justify-content-center align-items-center" style="min-height: 250px;">
                    <canvas id="salesDeptChart"></canvas>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-3" style="font-size: 0.75rem; font-weight: 600;">
                    <span style="color: #64748b;"><i class="fa-solid fa-circle me-1" style="color: #3b82f6;"></i>Fuel</span>
                    <span style="color: #64748b;"><i class="fa-solid fa-circle me-1" style="color: #f59e0b;"></i>Services</span>
                </div>
            </div>
        </div>
        
        <!-- Bar Chart -->
        <div class="col-lg-4">
            <div class="sd-card">
                <div>
                    <div class="sd-chart-title">Sales Volume</div>
                    <div class="sd-chart-subtitle">By Payment Method & Department</div>
                </div>
                <div class="flex-grow-1" style="position: relative; min-height: 250px;">
                    <canvas id="paymentMethodChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Horizontal Bar Chart -->
        <div class="col-lg-4">
            <div class="sd-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="sd-chart-title">Revenue Breakdown</div>
                        <div class="sd-chart-subtitle">By Product Category</div>
                    </div>
                </div>
                <div class="flex-grow-1" style="position: relative; min-height: 250px;">
                    <canvas id="productCategoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Charts Row 2 -->
    <div class="row g-4 mb-4">
        <!-- Area Chart -->
        <div class="col-12">
            <div class="sd-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="sd-chart-title">Revenue Trends</div>
                        <div class="sd-chart-subtitle mb-0">By Month</div>
                    </div>
                    <div class="d-flex gap-3" style="font-size: 0.75rem; font-weight: 600;">
                        <span style="color: #64748b;"><i class="fa-solid fa-circle me-1" style="color: #3b82f6;"></i>Fuel Revenue</span>
                    </div>
                </div>
                <div style="height: 300px; position: relative;">
                    <canvas id="revenueTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Chart Defaults
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#94a3b8';
    Chart.defaults.scale.grid.color = 'rgba(148, 163, 184, 0.1)';

    // 1. Doughnut Chart (Sales by Department)
    const ctxDept = document.getElementById('salesDeptChart').getContext('2d');
    new Chart(ctxDept, {
        type: 'doughnut',
        data: {
            labels: ['Fuel', 'Services'],
            datasets: [{
                data: [91, 9],
                backgroundColor: ['#3b82f6', '#f59e0b'],
                borderWidth: 0,
                cutout: '65%'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return ' ' + context.label + ': ' + context.raw + '%';
                        }
                    }
                }
            }
        },
        plugins: [{
            id: 'textCenter',
            beforeDraw: function(chart) {
                var width = chart.width,
                    height = chart.height,
                    ctx = chart.ctx;
                ctx.restore();
                var fontSize = (height / 120).toFixed(2);
                ctx.font = "bold " + fontSize + "em Inter";
                ctx.textBaseline = "middle";
                ctx.fillStyle = document.documentElement.getAttribute('data-theme') === 'dark' ? '#f8fafc' : '#0f172a';
                var text = "2",
                    textX = Math.round((width - ctx.measureText(text).width) / 2),
                    textY = height / 2 - 10;
                ctx.fillText(text, textX, textY);
                
                ctx.font = "600 0.7em Inter";
                ctx.fillStyle = "#94a3b8";
                var text2 = "DEPTS",
                    text2X = Math.round((width - ctx.measureText(text2).width) / 2),
                    text2Y = height / 2 + 10;
                ctx.fillText(text2, text2X, text2Y);
                ctx.save();
            }
        }]
    });

    // 2. Bar Chart (Sales by Payment Method)
    const ctxPay = document.getElementById('paymentMethodChart').getContext('2d');
    new Chart(ctxPay, {
        type: 'bar',
        data: {
            labels: ['Cash', 'POS', 'Transfer', 'Fleet Card', 'Voucher'],
            datasets: [
                {
                    label: 'Fuel',
                    data: [0.8, 0.9, 0.4, 0.5, 0.3],
                    backgroundColor: '#3b82f6',
                    barThickness: 8
                },

                {
                    label: 'Services',
                    data: [0.1, 0.2, 0.1, 0, 0],
                    backgroundColor: '#f59e0b',
                    barThickness: 8
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: {
                legend: { 
                    display: true,
                    position: 'top',
                    align: 'start',
                    labels: { boxWidth: 8, usePointStyle: true, font: {size: 10} }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        callback: function(value) { return value + 'M'; },
                        font: {size: 10}
                    },
                    border: {display: false}
                },
                y: {
                    grid: { display: false },
                    ticks: { font: {size: 10} },
                    border: {display: false}
                }
            }
        }
    });

    // 3. Horizontal Bar Chart (Revenue Breakdown)
    const ctxProd = document.getElementById('productCategoryChart').getContext('2d');
    new Chart(ctxProd, {
        type: 'bar',
        data: {
            labels: ['PMS (Petrol)', 'AGO (Diesel)', 'Groceries', 'Lubricants', 'Gas (LPG)'],
            datasets: [{
                data: [2.8, 1.9, 0.8, 0.5, 0.3],
                backgroundColor: ['#10b981', '#f59e0b', '#3b82f6', '#ef4444', '#8b5cf6'],
                barThickness: 12,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { callback: function(value) { return value + 'M'; }, font: {size: 10} },
                    border: {display: false}
                },
                y: {
                    grid: { display: false },
                    ticks: { font: {size: 10} },
                    border: {display: false}
                }
            }
        }
    });

    // 4. Area Chart (Revenue Trends)
    const ctxTrend = document.getElementById('revenueTrendChart').getContext('2d');
    
    let gradientFuel = ctxTrend.createLinearGradient(0, 0, 0, 300);
    gradientFuel.addColorStop(0, 'rgba(59, 130, 246, 0.4)');
    gradientFuel.addColorStop(1, 'rgba(59, 130, 246, 0.0)');
    
    let gradientStore = ctxTrend.createLinearGradient(0, 0, 0, 300);
    gradientStore.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
    gradientStore.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

    window.revenueTrendChart = new Chart(ctxTrend, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [
                {
                    label: 'Fuel Revenue',
                    data: [0.4, 0.2, 0.7, 0.5, 0.6, 0.8, 0.5, 0.45, 0.55, 0.3, 0.2, 0.6],
                    borderColor: '#3b82f6',
                    backgroundColor: gradientFuel,
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0
                },

            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + context.raw + 'M';
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    border: {display: false}
                },
                y: {
                    border: {display: false},
                    ticks: {
                        callback: function(value) { return value + 'M'; }
                    }
                }
            }
        }
    });

    // ── Timeframe Button Logic ──
    // Map each timeframe to its label set and matching data slices
    const tfConfig = {
        today:   { label: 'Today',        barLabels: ['00:00','03:00','06:00','09:00','12:00','15:00','18:00','21:00','23:59'], barData: [0.5, 0.2, 1.4, 2.1, 1.8, 2.4, 1.6, 0.9, 0.3] },
        week:    { label: 'This Week',     barLabels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],                                barData: [2.1, 1.8, 2.4, 1.6, 2.8, 3.2, 1.5] },
        month:   { label: 'This Month',    barLabels: ['Wk1','Wk2','Wk3','Wk4'],                                                barData: [8.4, 9.2, 7.6, 10.1] },
        quarter: { label: 'This Quarter',  barLabels: ['Jan','Feb','Mar'],                                                       barData: [28, 31, 27] },
        year:    { label: 'This Year',     barLabels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], barData: [22,19,25,21,28,30,18,24,26,23,20,27] },
        all:     { label: 'All Time',      barLabels: ['2022','2023','2024','2025','2026'],                                      barData: [180, 210, 245, 270, 140] },
    };

    let currentTf = 'today';

    document.querySelectorAll('#timeframeBtnGroup .btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('#timeframeBtnGroup .btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentTf = this.dataset.tf || 'today';
            applyTimeframe(currentTf);
        });
    });

    function applyTimeframe(tf) {
        const cfg = tfConfig[tf] || tfConfig.today;

        // Update volume bar chart labels + data
        if (typeof window.revenueTrendChart !== 'undefined') {
            window.revenueTrendChart.data.labels = cfg.barLabels;
            window.revenueTrendChart.data.datasets[0].data = cfg.barData;
            window.revenueTrendChart.options.plugins.title = { display: true, text: 'Fuel Revenue — ' + cfg.label };
            window.revenueTrendChart.update('active');
        }

        // Update CSV export scope label (visual only — actual export uses current filter)
        const exportBtns = document.querySelectorAll('[data-export-csv]');
        exportBtns.forEach(b => { b.dataset.exportTf = tf; });
    }

    // ── CSV Export — respects active timeframe ──
    document.querySelectorAll('[data-export-csv]').forEach(btn => {
        btn.addEventListener('click', function(){
            const tf  = this.dataset.exportTf || currentTf;
            const cfg = tfConfig[tf] || tfConfig.today;
            const rows = cfg.barLabels.map((lbl, i) => `"${lbl}","${cfg.barData[i]}"`);
            const csv  = ['Period,Revenue (M NGN)', ...rows].join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const a    = document.createElement('a');
            a.href     = URL.createObjectURL(blob);
            a.download = `sales_dashboard_${tf}_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
        });
    });
});
</script>
{% endblock %}
