{# templates/sales/store.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Store Sales – {{ app_name }}{% endblock %}

{% block styles %}
<style>
    /* ── Page Layout ── */
    .ss-header { margin-bottom: 1.75rem; }
    .ss-page-title { font-size: 1.45rem; font-weight: 800; color: var(--text-main); letter-spacing: -0.02em; margin: 0; }
    .ss-breadcrumb { font-size: 0.78rem; color: var(--text-muted); }
    .ss-breadcrumb a { color: var(--text-muted); text-decoration: none; }
    .ss-breadcrumb a:hover { color: var(--primary); }

    /* ── KPI Cards ── */
    .ss-kpi-card {
        background: var(--bg-card);
        border-radius: 16px;
        padding: 1.35rem 1.5rem 1.2rem;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 12px rgba(15,23,42,0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        position: relative;
        overflow: hidden;
    }
    .ss-kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 28px rgba(15,23,42,0.10);
    }
    .ss-kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        border-radius: 16px 16px 0 0;
    }
    .ss-kpi-card.color-blue::before  { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .ss-kpi-card.color-green::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .ss-kpi-card.color-amber::before { background: linear-gradient(90deg, #f59e0b, #fcd34d); }
    .ss-kpi-card.color-rose::before  { background: linear-gradient(90deg, #ef4444, #f87171); }
    .ss-kpi-card.color-purple::before{ background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

    .ss-kpi-icon {
        width: 46px; height: 46px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }
    .ss-kpi-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); margin-bottom: 4px; }
    .ss-kpi-value { font-size: 1.7rem; font-weight: 800; color: var(--text-main); line-height: 1.1; letter-spacing: -0.03em; }
    .ss-kpi-sub { font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; }
    .ss-kpi-badge { font-size: 0.72rem; font-weight: 700; padding: 3px 9px; border-radius: 99px; display: inline-flex; align-items: center; gap: 3px; }
    .ss-kpi-badge.up   { background: rgba(16,185,129,0.12); color: #059669; }
    .ss-kpi-badge.down { background: rgba(239,68,68,0.12);  color: #dc2626; }
    .ss-kpi-badge.flat { background: rgba(100,116,139,0.1); color: #64748b; }

    /* ── Filter Bar ── */
    .ss-filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .ss-filter-bar .form-control,
    .ss-filter-bar .form-select {
        font-size: 0.83rem;
        border-radius: 8px;
        border-color: var(--border-color);
        background: var(--bg-page);
        color: var(--text-main);
        height: 36px;
        padding: 0 0.75rem;
    }
    .ss-filter-bar .form-control:focus,
    .ss-filter-bar .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(13,148,136,0.12);
    }
    .ss-search-box { flex: 1; min-width: 200px; position: relative; }
    .ss-search-box .form-control { padding-left: 2.25rem; }
    .ss-search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.85rem; }
    .ss-filter-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }

    /* ── Table Card ── */
    .ss-table-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(15,23,42,0.05);
        overflow: hidden;
    }
    .ss-table-card .card-header-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        gap: 1rem;
        flex-wrap: wrap;
    }
    .ss-table-card .card-header-title { font-size: 0.95rem; font-weight: 700; color: var(--text-main); }
    .ss-table-card .card-header-count { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; }

    /* ── Sortable Table ── */
    .ss-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.855rem; }
    .ss-table thead th {
        background: var(--bg-page);
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 0.8rem 1rem;
        border-bottom: 1px solid var(--border-color);
        white-space: nowrap;
        position: sticky; top: 0; z-index: 1;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s;
    }
    .ss-table thead th:hover { background: var(--border-color); }
    .ss-table thead th.sorted-asc .sort-icon::after  { content: ' ↑'; color: var(--primary); }
    .ss-table thead th.sorted-desc .sort-icon::after { content: ' ↓'; color: var(--primary); }
    .ss-table thead th:not(.sorted-asc):not(.sorted-desc) .sort-icon::after { content: ' ⇅'; opacity: 0.3; }
    .ss-table thead th.no-sort { cursor: default; }
    .ss-table thead th.no-sort:hover { background: var(--bg-page); }

    .ss-table tbody tr {
        border-bottom: 1px solid var(--border-color);
        transition: background 0.12s;
    }
    .ss-table tbody tr:last-child { border-bottom: none; }
    .ss-table tbody tr:hover { background: var(--bg-page); }
    .ss-table td { padding: 0.85rem 1rem; vertical-align: middle; color: var(--text-main); }

    .ss-product-avatar { width: 36px; height: 36px; border-radius: 10px; background: rgba(59,130,246,0.1); color: #3b82f6; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; flex-shrink: 0; }
    .ss-product-name { font-weight: 600; color: var(--text-main); line-height: 1.3; }
    .ss-product-cat  { font-size: 0.73rem; color: var(--text-muted); }
    .ss-txn-id { font-size: 0.75rem; color: var(--text-muted); font-family: monospace; }

    .ss-badge { font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 99px; }
    .ss-badge.paid    { background: rgba(16,185,129,0.12); color: #059669; }
    .ss-badge.pending { background: rgba(245,158,11,0.12);  color: #d97706; }
    .ss-badge.refund  { background: rgba(239,68,68,0.12);   color: #dc2626; }
    .ss-badge.cash    { background: rgba(59,130,246,0.1);   color: #2563eb; }
    .ss-badge.pos     { background: rgba(139,92,246,0.1);   color: #7c3aed; }
    .ss-badge.transfer{ background: rgba(245,158,11,0.1);   color: #b45309; }

    .ss-amount { font-weight: 700; color: var(--text-main); }
    .ss-amount.positive { color: #059669; }

    /* Pagination */
    .ss-pagination { display: flex; align-items: center; gap: 0.4rem; }
    .ss-page-btn {
        width: 32px; height: 32px; border-radius: 8px; font-size: 0.8rem; font-weight: 600;
        border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-muted);
        display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.15s;
    }
    .ss-page-btn:hover, .ss-page-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .ss-page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Empty state */
    .ss-empty { padding: 4rem 2rem; text-align: center; }
    .ss-empty i { font-size: 2.5rem; color: var(--border-color); margin-bottom: 1rem; }
    .ss-empty p { color: var(--text-muted); font-size: 0.9rem; }

    /* Export btn */
    .ss-export-btn { font-size: 0.78rem; font-weight: 600; border-radius: 8px; padding: 6px 14px; gap: 6px; display: inline-flex; align-items: center; }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid px-0">

    <!-- Header -->
    <div class="ss-header d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <nav class="ss-breadcrumb mb-1">
                <a href="{{ path('app_sales_dashboard') }}">Sales</a>
                <span class="mx-1">/</span>
                <span>Store Sales</span>
            </nav>
            <h1 class="ss-page-title">
                <i class="fa-solid fa-store me-2" style="color: var(--primary);"></i> Store Sales
            </h1>
            <p class="text-muted mb-0 mt-1" style="font-size: 0.85rem;">Track all in-store product transactions, payments and performance.</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap mt-1">
            <button id="ss-export-csv" class="ss-export-btn btn btn-outline-secondary">
                <i class="fa-solid fa-file-csv"></i> Export CSV
            </button>
            <a href="{{ path('staff_reception') }}" class="btn btn-primary ss-export-btn">
                <i class="fa-solid fa-cash-register"></i> New Sale
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3 col-lg-4">
            <div class="ss-kpi-card color-blue">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="ss-kpi-icon" style="background:rgba(59,130,246,0.1);color:#3b82f6;">
                        <i class="fa-solid fa-naira-sign"></i>
                    </div>
                    <span class="ss-kpi-badge up"><i class="fa-solid fa-arrow-trend-up"></i> +12.4%</span>
                </div>
                <div class="ss-kpi-label">Total Revenue (Month)</div>
                <div class="ss-kpi-value">₦{{ (total_revenue / 1000000)|number_format(1) }}M</div>
                <div class="ss-kpi-sub">vs ₦1.64M last month</div>
            </div>
        </div>
        <div class="col-6 col-xl-3 col-lg-4">
            <div class="ss-kpi-card color-green">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="ss-kpi-icon" style="background:rgba(16,185,129,0.1);color:#10b981;">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <span class="ss-kpi-badge up"><i class="fa-solid fa-arrow-trend-up"></i> +8.1%</span>
                </div>
                <div class="ss-kpi-label">Transactions (Month)</div>
                <div class="ss-kpi-value">{{ transaction_count|number_format(0) }}</div>
                <div class="ss-kpi-sub">Avg. ₦4,299 per sale</div>
            </div>
        </div>
        <div class="col-6 col-xl-3 col-lg-4">
            <div class="ss-kpi-card color-amber">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="ss-kpi-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                    <span class="ss-kpi-badge flat"><i class="fa-solid fa-minus"></i> 0.0%</span>
                </div>
                <div class="ss-kpi-label">Items Sold (Month)</div>
                <div class="ss-kpi-value">{{ total_volume|number_format(0) }}</div>
                <div class="ss-kpi-sub">Across 38 product SKUs</div>
            </div>
        </div>
        <div class="col-6 col-xl-3 col-lg-4">
            <div class="ss-kpi-card color-rose">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="ss-kpi-icon" style="background:rgba(239,68,68,0.1);color:#ef4444;">
                        <i class="fa-solid fa-rotate-left"></i>
                    </div>
                    <span class="ss-kpi-badge down"><i class="fa-solid fa-arrow-trend-down"></i> -2.0%</span>
                </div>
                <div class="ss-kpi-label">Refunds / Returns</div>
                <div class="ss-kpi-value">₦{{ avg_ticket|number_format(0) }}</div>
                <div class="ss-kpi-sub">6 transactions refunded</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="ss-filter-bar">
        <span class="ss-filter-label"><i class="fa-solid fa-filter me-1"></i> Filter:</span>
        <div class="ss-search-box">
            <i class="fa-solid fa-magnifying-glass ss-search-icon"></i>
            <input type="text" class="form-control" id="ss-search" placeholder="Search product, cashier, transaction ID…">
        </div>
        <select class="form-select" id="ss-filter-category" style="max-width: 170px;">
            <option value="">All Categories</option>
            <option value="Beverages">Beverages</option>
            <option value="Snacks">Snacks</option>
            <option value="Lubricants">Lubricants</option>
            <option value="Groceries">Groceries</option>
            <option value="Accessories">Accessories</option>
        </select>
        <select class="form-select" id="ss-filter-payment" style="max-width: 160px;">
            <option value="">All Payments</option>
            <option value="Cash">Cash</option>
            <option value="POS">POS</option>
            <option value="Transfer">Transfer</option>
        </select>
        <select class="form-select" id="ss-filter-status" style="max-width: 140px;">
            <option value="">All Statuses</option>
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
            <option value="Refund">Refund</option>
        </select>
        <select class="form-select" id="ss-filter-period" style="max-width: 140px;">
            <option value="">All Time</option>
            <option value="today">Today</option>
            <option value="week">This Week</option>
            <option value="month" selected>This Month</option>
            <option value="quarter">This Quarter</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary px-3" id="ss-clear-filters" style="font-size: 0.78rem; font-weight: 600; height: 36px; border-radius: 8px;">
            <i class="fa-solid fa-xmark me-1"></i> Clear
        </button>
    </div>

    <!-- Table Card -->
    <div class="ss-table-card">
        <div class="card-header-row">
            <div>
                <div class="card-header-title"><i class="fa-solid fa-table-list me-2" style="color: var(--primary);"></i>Store Transaction Log</div>
                <div class="card-header-count" id="ss-row-count">Showing <strong id="ss-showing">0</strong> of <strong id="ss-total">0</strong> entries</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="ss-filter-label">Per page:</span>
                <select class="form-select form-select-sm" id="ss-per-page" style="width: 70px; font-size: 0.8rem; border-radius: 8px;">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
            <table class="ss-table" id="ss-table">
                <thead>
                    <tr>
                        <th data-col="txn_id" class="sorted-asc"><span class="sort-icon">#TXN ID</span></th>
                        <th data-col="date"><span class="sort-icon">Date &amp; Time</span></th>
                        <th data-col="product"><span class="sort-icon">Product</span></th>
                        <th data-col="category"><span class="sort-icon">Category</span></th>
                        <th data-col="qty"><span class="sort-icon">Qty</span></th>
                        <th data-col="unit_price"><span class="sort-icon">Unit Price</span></th>
                        <th data-col="total"><span class="sort-icon">Total</span></th>
                        <th data-col="payment"><span class="sort-icon">Payment</span></th>
                        <th data-col="cashier"><span class="sort-icon">Cashier</span></th>
                        <th data-col="status"><span class="sort-icon">Status</span></th>
                    </tr>
                </thead>
                <tbody id="ss-tbody">
                    <!-- Rows injected by JS -->
                </tbody>
            </table>
        </div>

        <div id="ss-empty" class="ss-empty" style="display:none;">
            <i class="fa-solid fa-inbox"></i>
            <p class="mb-0">No transactions match your filters.</p>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top" style="border-color: var(--border-color)!important;">
            <div class="text-muted" style="font-size: 0.8rem;" id="ss-page-info">Page 1 of 1</div>
            <div class="ss-pagination" id="ss-pagination"></div>
        </div>
    </div>

</div>
{% endblock %}

