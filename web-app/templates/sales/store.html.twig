        const stat = statusEl.value;
        const per  = periodEl.value;
        const now  = new Date();

        filtered = STORE_DATA.filter(r => {
            if (q && !`${r.txn_id} ${r.product} ${r.cashier}`.toLowerCase().includes(q)) return false;
            if (cat  && r.category !== cat)  return false;
            if (pay  && r.payment  !== pay)  return false;
            if (stat && r.status   !== stat) return false;
            if (per) {
                const d = new Date(r.date);
                if (per === 'today')   { if (d.toDateString() !== now.toDateString()) return false; }
                if (per === 'week')    { const w = new Date(now); w.setDate(now.getDate()-7); if (d < w) return false; }
                if (per === 'month')   { if (d.getMonth() !== now.getMonth() || d.getFullYear() !== now.getFullYear()) return false; }
                if (per === 'quarter') { const q2 = new Date(now); q2.setMonth(now.getMonth()-3); if (d < q2) return false; }
            }
            return true;
        });
        sortData();
    }

    function sortData(){
        filtered.sort((a,b) => {
            let va = a[sortCol], vb = b[sortCol];
            if (typeof va === 'string') va = va.toLowerCase();
            if (typeof vb === 'string') vb = vb.toLowerCase();
            if (va < vb) return sortDir === 'asc' ? -1 : 1;
            if (va > vb) return sortDir === 'asc' ?  1 : -1;
            return 0;
        });
        page = 1;
        renderTable();
    }

    function renderTable(){
        const total   = filtered.length;
        const pages   = Math.max(1, Math.ceil(total / perPage));
        page = Math.min(page, pages);
        const start   = (page - 1) * perPage;
        const slice   = filtered.slice(start, start + perPage);

        showingEl.textContent = Math.min(start + perPage, total);
        totalEl.textContent   = total;
        pageInfoEl.textContent = `Page ${page} of ${pages}`;

        if (total === 0) {
            tbody.innerHTML = '';
            emptyEl.style.display = 'block';
        } else {
            emptyEl.style.display = 'none';
            tbody.innerHTML = slice.map(r => `
                <tr>
                    <td><span class="ss-txn-id">${r.txn_id}</span></td>
                    <td><span style="font-size:0.82rem;">${r.date}</span></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="ss-product-avatar"><i class="fa-solid fa-box"></i></div>
                            <div>
                                <div class="ss-product-name">${r.product}</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-light border text-secondary" style="font-size:0.72rem;font-weight:600;">${r.category}</span></td>
                    <td><span style="font-weight:600;">${r.qty}</span></td>
                    <td><span style="font-size:0.83rem;">${fmt(r.unit_price)}</span></td>
                    <td><span class="ss-amount">${fmt(r.total)}</span></td>
                    <td><span class="ss-badge ${payBadge[r.payment]||''}">${r.payment}</span></td>
                    <td><span style="font-size:0.82rem;">${r.cashier}</span></td>
                    <td><span class="ss-badge ${stBadge[r.status]||''}">${r.status}</span></td>
                </tr>`).join('');
        }

        renderPagination(pages);
    }

    function renderPagination(pages){
        let html = `<button class="ss-page-btn" onclick="goPage(${page-1})" ${page<=1?'disabled':''}>‹</button>`;
        for(let i=1;i<=pages;i++){
            if (pages > 7 && (i > 3 && i < pages - 2 && Math.abs(i-page) > 1)) {
                if (i === 4 || i === pages - 2) html += `<span class="ss-page-btn" style="cursor:default;">…</span>`;
                continue;
            }
            html += `<button class="ss-page-btn ${i===page?'active':''}" onclick="goPage(${i})">${i}</button>`;
        }
        html += `<button class="ss-page-btn" onclick="goPage(${page+1})" ${page>=pages?'disabled':''}>›</button>`;
        paginEl.innerHTML = html;
    }

    window.goPage = function(p){ page = p; renderTable(); };

    // Sort on header click
    document.querySelectorAll('#ss-table thead th[data-col]').forEach(th => {
        th.addEventListener('click', function(){
            const col = this.dataset.col;
            if (sortCol === col) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
            else { sortCol = col; sortDir = 'asc'; }
            document.querySelectorAll('#ss-table thead th').forEach(t => t.classList.remove('sorted-asc','sorted-desc'));
            this.classList.add(sortDir === 'asc' ? 'sorted-asc' : 'sorted-desc');
            sortData();
        });
    });

    // Filters
    [searchEl, catEl, payEl, statusEl, periodEl].forEach(el => el.addEventListener('input', filterData));
    perPageEl.addEventListener('change', () => { perPage = parseInt(perPageEl.value); page = 1; renderTable(); });
    clearBtn.addEventListener('click', () => {
        searchEl.value = ''; catEl.value = ''; payEl.value = ''; statusEl.value = ''; periodEl.value = '';
        filterData();
    });

    // CSV Export
    exportBtn.addEventListener('click', () => {
        const cols = ['txn_id','date','product','category','qty','unit_price','total','payment','cashier','status'];
        const header = ['Txn ID','Date','Product','Category','Qty','Unit Price','Total','Payment','Cashier','Status'];
        const rows = filtered.map(r => cols.map(c => `"${r[c]}"`).join(','));
        const blob = new Blob([header.join(',') + '\n' + rows.join('\n')], {type: 'text/csv'});
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'store_sales.csv'; a.click();
    });

    // Initial render
    filterData();
})();
</script>
{% endblock %}
