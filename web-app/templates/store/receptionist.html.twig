{% extends 'base.html.twig' %}

{% block title %}Receptionist Terminal – {{ app_name }}{% endblock %}

{% block styles %}
<style>
    .touch-btn { min-height: 68px; font-size: 1.05rem; }
    .calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
    .calc-grid button { min-height: 58px; font-weight: 700; }
    .reception-product { border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; }
</style>
{% endblock %}

{% block content %}
<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Receptionist Workspace</h2>
            <p class="text-muted mb-0">Touch-ready front desk, stock lookup and quick arithmetic helper.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card p-3 shadow-sm h-100">
                <h5 class="mb-3"><i class="bi bi-calculator me-2"></i>Inbuilt Calculator</h5>
                <input id="calcDisplay" class="form-control form-control-lg mb-2 text-end" value="0" readonly>
                <div class="calc-grid">
                    <button class="btn btn-outline-secondary" onclick="calcPress('7')">7</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('8')">8</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('9')">9</button>
                    <button class="btn btn-outline-primary" onclick="calcPress('/')">/</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('4')">4</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('5')">5</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('6')">6</button>
                    <button class="btn btn-outline-primary" onclick="calcPress('*')">*</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('1')">1</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('2')">2</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('3')">3</button>
                    <button class="btn btn-outline-primary" onclick="calcPress('-')">-</button>
                    <button class="btn btn-outline-danger" onclick="calcClear()">C</button>
                    <button class="btn btn-outline-secondary" onclick="calcPress('0')">0</button>
                    <button class="btn btn-outline-success" onclick="calcEqual()">=</button>
                    <button class="btn btn-outline-primary" onclick="calcPress('+')">+</button>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card p-3 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Stock Lookup (POS Synced)</h5>
                    <a class="btn btn-primary touch-btn px-4" href="{{ path('app_store_dashboard') }}">
                        <i class="bi bi-cash-stack me-1"></i> Open POS
                    </a>
                </div>
                <input id="stockSearch" class="form-control form-control-lg mb-3" placeholder="Search item name, barcode, category...">
                <div class="row g-2" id="receptionItems">
                    {% for product in products %}
                    <div class="col-md-6 reception-item" data-search="{{ (product.name ~ ' ' ~ product.barcode ~ ' ' ~ product.category)|lower }}">
                        <div class="reception-product p-2 d-flex gap-2">
                            <div>
                                {% if product.imagePath %}
                                    <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" style="width:74px;height:74px;object-fit:cover;" class="rounded border">
                                {% else %}
                                    <div class="rounded border d-flex align-items-center justify-content-center text-muted" style="width:74px;height:74px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">{{ product.name }}</div>
                                <div class="small text-muted">{{ product.category }} | {{ product.barcode }}</div>
                                <div class="d-flex justify-content-between mt-1">
                                    <span class="text-success fw-bold">₦{{ product.unitPrice|number_format(2) }}</span>
                                    <span class="badge bg-{{ product.stockQuantity > product.reorderLevel ? 'success' : 'warning text-dark' }}">{{ product.stockQuantity }} in stock</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="col-12 text-muted text-center py-3">No inventory data found.</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    let calcExpr = '';
    function calcPress(value) {
        calcExpr += value;
        document.getElementById('calcDisplay').value = calcExpr || '0';
    }
    function calcClear() {
        calcExpr = '';
        document.getElementById('calcDisplay').value = '0';
    }
    function calcEqual() {
        try {
            // eslint-disable-next-line no-eval
            calcExpr = String(eval(calcExpr));
            document.getElementById('calcDisplay').value = calcExpr;
        } catch (e) {
            toast.error('Invalid arithmetic expression');
            calcClear();
        }
    }
    document.getElementById('stockSearch').addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('.reception-item').forEach(item => {
            item.style.display = item.dataset.search.includes(q) ? '' : 'none';
        });
    });
</script>
{% endblock %}
