<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Transaction Receipt</title>
    <style>
        body { font-family: Arial, sans-serif; color: #0f172a; font-size: 12px; }
        .container { max-width: 700px; margin: 0 auto; }
        .header { margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #cbd5e1; padding: 8px; text-align: left; }
        th { background: #f8fafc; }
        .summary { margin-top: 14px; width: 280px; margin-left: auto; }
        .summary td { border: none; padding: 4px 0; }
        .summary .grand { font-weight: bold; border-top: 1px solid #cbd5e1; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2>TACI Petroleum - Receipt</h2>
        <div>Reference: {{ transaction.reference }}</div>
        <div>Staff: {{ transaction.staffUser.username }}</div>
        <div>Date: {{ transaction.createdAt|date('Y-m-d H:i:s') }}</div>
        <div>Payment: {{ transaction.paymentMethod|upper }}</div>
    </div>

    <table>
        <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Total</th>
        </tr>
        </thead>
        <tbody>
        {% for item in transaction.items %}
            <tr>
                <td>{{ item.name }}</td>
                <td>₦{{ item.price|number_format(2, '.', ',') }}</td>
                <td>{{ item.quantity }}</td>
                <td>₦{{ item.lineTotal|number_format(2, '.', ',') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="summary">
        <tr><td>Subtotal</td><td>₦{{ transaction.subtotal|number_format(2, '.', ',') }}</td></tr>
        <tr><td>Tax</td><td>₦{{ transaction.tax|number_format(2, '.', ',') }}</td></tr>
        <tr><td>Discount</td><td>₦{{ transaction.discount|number_format(2, '.', ',') }}</td></tr>
        <tr class="grand"><td>Grand Total</td><td>₦{{ transaction.total|number_format(2, '.', ',') }}</td></tr>
    </table>
</div>
</body>
</html>
