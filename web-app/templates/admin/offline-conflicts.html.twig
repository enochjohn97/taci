{% extends 'base.html.twig' %}

{% block title %}Offline Sync Conflicts{% endblock %}

{% block content %}
<div class="container py-4">
  <h3>Offline Sync Conflicts</h3>
  <p class="text-muted">Conflicts generated by offline-sync attempts. Review and resolve manually.</p>

  <div class="card mt-3">
    <div class="card-body">
      {% if conflicts|length > 0 %}
        <table class="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>When</th>
              <th>User</th>
              <th>OfflineId</th>
              <th>Reason</th>
              <th>Payload</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for c in conflicts %}
              {% set desc = c.getDescription() %}
              {% set parsed = {} %}
              {% set offlineId = '' %}
              {% set reason = '' %}
              {% set payload = '' %}
              {% if desc %}
                {% set parsed = desc|json_decode %}
                {% set offlineId = parsed.offlineId|default(parsed.offline_id|default('')) %}
                {% set reason = parsed.reason|default(parsed.error|default('')) %}
                {% set payload = parsed.payload|default(parsed) %}
              {% endif %}
              <tr>
                <td>{{ c.getId() }}</td>
                <td>{{ c.getTimestamp().format('Y-m-d H:i') }}</td>
                <td>{{ c.getUser().getUsername() }}</td>
                <td>{{ offlineId }}</td>
                <td>{{ reason }}</td>
                <td><pre style="max-height:120px;overflow:auto">{{ payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                <td>
                  <div class="d-flex gap-2">
                    <form method="post" action="{{ path('admin_offline_conflict_resolve', {'id': c.getId()}) }}">
                      <button class="btn btn-sm btn-success">Mark Resolved</button>
                    </form>
                    <form method="post" action="{{ path('admin_offline_conflict_reprocess', {'id': c.getId()}) }}">
                      <button class="btn btn-sm btn-primary">Reprocess</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="text-muted">No conflicts found.</div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}