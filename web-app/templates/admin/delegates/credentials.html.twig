{# templates/admin/delegates/credentials.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Delegate Credentials - {{ app_name }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-check-circle"></i> Delegate Account Created Successfully!</h5>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-exclamation-circle"></i>
                        <strong>Important:</strong> Copy the credentials below. This is the only time they will be displayed.
                    </div>

                    <div class="credentials-box bg-light p-4 rounded border mb-4" style="font-family: 'Courier New', monospace;">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Full Name</label>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong id="fullNameDisplay">{{ credentials.full_name }}</strong>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('fullNameDisplay')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small">Username</label>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong id="usernameDisplay">{{ credentials.username }}</strong>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('usernameDisplay')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small">Temporary Password</label>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong id="passwordDisplay" class="text-danger">{{ credentials.password }}</strong>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('passwordDisplay')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>

                        {% if credentials.email %}
                            <div class="mb-3">
                                <label class="form-label text-muted small">Email</label>
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong id="emailDisplay">{{ credentials.email }}</strong>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('emailDisplay')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <button class="btn btn-outline-primary w-100" onclick="printCredentials()">
                                <i class="fas fa-print"></i> Print
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-outline-secondary w-100" onclick="copyAllCredentials()">
                                <i class="fas fa-copy"></i> Copy All
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-warning mb-4">
                        <strong><i class="fas fa-lock"></i> Security Note:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Share credentials securely (not via email or chat)</li>
                            <li>The delegate must change password on first login</li>
                            <li>You can reset the password anytime from the delegates list</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="{{ path('app_delegates_index') }}" class="btn btn-primary btn-lg">
                            <i class="fas fa-arrow-left"></i> Back to Delegates
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        const text = element.textContent;
        navigator.clipboard.writeText(text).then(() => {
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                btn.innerHTML = originalText;
            }, 2000);
        });
    }

    function copyAllCredentials() {
        const text = `Full Name: {{ credentials.full_name }}
Username: {{ credentials.username }}
Temporary Password: {{ credentials.password }}
Email: {{ credentials.email }}`;
        navigator.clipboard.writeText(text).then(() => {
            alert('All credentials copied to clipboard!');
        });
    }

    function printCredentials() {
        window.print();
    }
</script>

<style media="print">
    body {
        background: white;
    }
    .credentials-box {
        border: 2px solid #333 !important;
        page-break-inside: avoid;
    }
</style>
{% endblock %}
