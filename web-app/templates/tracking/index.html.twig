{% extends 'base.html.twig' %}

{% block title %}Live Tracking{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-geo-alt me-2 text-primary"></i>Live Tracking Center</h2>
            <p class="text-muted mb-0">Real-time status of fuel dispatches and bulk stock shipments</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12">
            <h4 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-truck text-danger me-2"></i>Fuel Truck Dispatches</h4>
            <div class="row g-4">
                {% for truck in fuel_trucks %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                            <div class="card-header border-0 pb-0 pt-4 bg-white d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0 font-monospace">{{ truck.plate }}</h5>
                                <span class="badge rounded-pill 
                                    {% if truck.status == 'in_transit' %}bg-primary
                                    {% elseif truck.status == 'loading' %}bg-warning text-dark
                                    {% else %}bg-success{% endif %} px-3 py-2">
                                    {{ truck.status|replace({'_': ' '})|upper }}
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-light rounded-circle p-3 me-3">
                                        <i class="bi bi-person-fill text-muted fs-4"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 fw-bold">{{ truck.driver }}</p>
                                        <small class="text-muted">{{ truck.capacity }}</small>
                                    </div>
                                </div>
                                
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Progress</span>
                                        <span>{{ truck.progress }}%</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 10px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated 
                                            {% if truck.status == 'arrived' %}bg-success{% endif %}" 
                                            role="progressbar" style="width: {{ truck.progress }}%"></div>
                                    </div>
                                </div>
                                
                                <div class="row g-0 small">
                                    <div class="col-6 border-end pe-2">
                                        <div class="text-muted text-uppercase" style="font-size: 0.7rem;">Dispatch</div>
                                        <div class="fw-bold">{{ truck.dispatchTime|default('Pending') }}</div>
                                    </div>
                                    <div class="col-6 ps-3">
                                        <div class="text-muted text-uppercase" style="font-size: 0.7rem;">Est. Arrival</div>
                                        <div class="fw-bold text-primary">{{ truck.arrivalEstimate }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <h4 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-box-seam text-info me-2"></i>Bulk Stock Shipments</h4>
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Item Name</th>
                                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Carrier Plate</th>
                                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Date</th>
                                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Progress</th>
                                    <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for shipment in stock_shipments %}
                                    <tr>
                                        <td class="px-4 py-3 fw-bold">{{ shipment.itemName }}</td>
                                        <td class="px-4 py-3 font-monospace text-muted">{{ shipment.truckPlate }}</td>
                                        <td class="px-4 py-3 text-muted small">{{ shipment.date }}</td>
                                        <td class="px-4 py-3" style="width: 25%;">
                                            <div class="progress rounded-pill" style="height: 6px;">
                                                <div class="progress-bar {% if shipment.cargoStatus == 'delivered' %}bg-success{% elseif shipment.cargoStatus == 'delayed' %}bg-danger{% else %}bg-info{% endif %}" 
                                                     role="progressbar" style="width: {{ shipment.progress }}%"></div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="badge rounded-pill 
                                                {% if shipment.cargoStatus == 'delivered' %}bg-success
                                                {% elseif shipment.cargoStatus == 'delayed' %}bg-danger
                                                {% else %}bg-info{% endif %} px-3">
                                                {{ shipment.cargoStatus|upper }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
