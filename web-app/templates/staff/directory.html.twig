{# templates/staff/directory.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Staff Directory – {{ app_name|default('TACI') }}{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="bi bi-person-lines-fill me-2"></i>Staff Directory
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none mt-4">
                <div class="btn-list">
                    <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                        <i class="bi bi-plus-lg me-1"></i> Add New Staff
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Staff Members</h5>
                <div class="input-icon">
                    <span class="input-icon-addon"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search staff...">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Contact</th>
                            <th>Joined</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for staff in staffs|default([]) %}
                        <tr>
                            <td data-label="Staff Member">
                                <div class="d-flex py-1 align-items-center">
                                    <span class="avatar me-2" style="background-image: url('{{ staff.avatar|default('') }}')">{{ staff.initials|default('US') }}</span>
                                    <div class="flex-fill">
                                        <div class="font-weight-medium">{{ staff.name }}</div>
                                        <div class="text-muted"><a href="#" class="text-reset">{{ staff.email }}</a></div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Role">
                                <div>{{ staff.role|default('Staff') }}</div>
                            </td>
                            <td data-label="Status">
                                {% if staff.status == 'active' %}
                                    <span class="badge bg-success-lt">Active</span>
                                {% else %}
                                    <span class="badge bg-danger-lt">Inactive</span>
                                {% endif %}
                            </td>
                            <td data-label="Contact">
                                <div>{{ staff.phone }}</div>
                            </td>
                            <td class="text-muted" data-label="Joined">
                                {{ staff.joined_at|default('N/A') }}
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="#" class="btn btn-white btn-sm">Edit</a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No staff members found.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex align-items-center">
                <p class="m-0 text-muted">Showing <span>1</span> to <span>10</span> of <span>{{ staffs|default([])|length }}</span> entries</p>
                <ul class="pagination m-0 ms-auto">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">prev</a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">next</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

{# Add Staff Modal #}
<div class="modal modal-blur fade" id="addStaffModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Staff Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" name="name" placeholder="John Doe">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Email address</label>
                                <input type="email" class="form-control" name="email" placeholder="john@example.com">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="text" class="form-control" name="phone" placeholder="+1234567890">
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">Role</label>
                                <select class="form-select" name="role">
                                    <option value="ROLE_STAFF">Staff / Pump Attendant</option>
                                    <option value="ROLE_MANAGER">Manager</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</a>
                <a href="#" class="btn btn-primary ms-auto" data-bs-dismiss="modal">
                    <i class="bi bi-check-lg me-1"></i> Add Staff
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
