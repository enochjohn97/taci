{# templates/staff/leave_requests.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Leave Requests - TACI Petroleum{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="bi bi-calendar-check me-2"></i>Staff Leave Requests
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a href="{{ path('app_dashboard_manager') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Type</th>
                            <th>Duration</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in leave_requests %}
                            <tr>
                                <td class="fw-semibold">{{ request.staff.username }}</td>
                                <td><span class="badge bg-light text-dark border">{{ request.type }}</span></td>
                                <td>{{ request.startDate|date('M d, Y') }} - {{ request.endDate|date('M d, Y') }} ({{ request.duration }})</td>
                                <td>{{ request.reason }}</td>
                                <td>
                                    {% if request.status == 'Approved' %}
                                        <span class="badge bg-success">Approved</span>
                                    {% elseif request.status == 'Rejected' %}
                                        <span class="badge bg-danger">Rejected</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if request.status == 'Pending' %}
                                        <form method="post" action="{{ path('app_manager_staff_approve_leave_request', {id: request.id}) }}" style="display:inline-block;">
                                            <input type="hidden" name="status" value="Approved">
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        <form method="post" action="{{ path('app_manager_staff_approve_leave_request', {id: request.id}) }}" style="display:inline-block;">
                                            <input type="hidden" name="status" value="Rejected">
                                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                        </form>
                                    {% else %}
                                        <span class="text-muted small">No actions</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No leave requests found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
