{# templates/staff/payroll.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Payroll Summary – {{ app_name|default('TACI') }}{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="bi bi-wallet2 me-2"></i>Payroll Summary
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none mt-4">
                <div class="btn-list">
                    <button class="btn btn-primary d-none d-sm-inline-block">
                        <i class="bi bi-play-circle me-1"></i> Process Payroll
                    </button>
                    <button class="btn btn-outline-secondary d-none d-sm-inline-block">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Export Data
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Total Payroll (This Month)</div>
                    </div>
                    <div class="h1 mb-3 text-primary">₦{{ total_payroll|default(0) }}</div>
                    <div class="progress progress-sm">
                        <div class="progress-bar bg-primary" style="width: 75%" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" aria-label="75% Complete">
                            <span class="visually-hidden">0% Complete</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Pending Disbursals</div>
                    </div>
                    <div class="h1 mb-3 text-warning">₦{{ pending_disbursals|default() }}</div>
                    <div class="text-muted small">Awaiting manager approval</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Deductions (Advances / Penalties)</div>
                    </div>
                    <div class="h1 mb-3 text-danger">₦{{ deductions|default() }}</div>
                    <div class="text-muted small">Total deductions for current period</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Staff Payroll Details</h5>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm">
                        <option value="current">Current Month ({{ "now"|date("M Y") }})</option>
                        <option value="last">Last Month ({{ "now"|date_modify("-1 month")|date("M Y") }})</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Role</th>
                            <th>Base Pay</th>
                            <th>Overtime / Bonuses</th>
                            <th>Deductions</th>
                            <th>Net Pay</th>
                            <th>Status</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payroll in payrolls|default([]) %}
                        <tr>
                            <td>
                                <div class="d-flex py-1 align-items-center">
                                    <span class="avatar avatar-sm me-2 rounded-circle">ST</span>
                                    <div class="font-weight-medium">{{ payroll.staff }}</div>
                                </div>
                            </td>
                            <td class="text-muted">{{ payroll.role }}</td>
                            <td>₦{{ payroll.base }}</td>
                            <td class="text-success">+₦{{ payroll.bonus }}</td>
                            <td class="text-danger">-₦{{ payroll.deductions }}</td>
                            <td><strong>₦{{ payroll.net }}</strong></td>
                            <td>
                                {% if payroll.status == 'Paid' %}
                                    <span class="badge bg-success-lt">Paid</span>
                                {% else %}
                                    <span class="badge bg-warning-lt">Pending</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#">View Payslip</a></li>
                                        <li><a class="dropdown-item" href="#">Adjust Deductions</a></li>
                                        {% if payroll.status != 'Paid' %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-success" href="#">Mark as Paid</a></li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No payroll records found for this period.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex align-items-center">
                <ul class="pagination m-0 ms-auto">
                    <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">prev</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">next</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
