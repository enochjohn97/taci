{# templates/staff/dashboard.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Staff Dashboard – {{ app_name|default('TACI') }}{% endblock %}

{% block styles %}
{{ parent() }}
<style>
    .kpi-card {
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
    .kpi-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.5rem;
    }
    .kpi-value { font-weight: 700; color: #1f2937; }
    .kpi-label { font-size: 0.875rem; color: #6b7280; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
    .kpi-strip { height: 4px; border-radius: 0 0 12px 12px; position: absolute; bottom: 0; left: 0; right: 0; }
    
    .chat-bubble { font-size: 0.9rem; line-height: 1.4; }
    .task-item { transition: background-color 0.2s; padding: 6px 8px; border-radius: 6px; }
    .task-item:hover { background-color: rgba(0,0,0,0.02); }
</style>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="bi bi-speedometer2 me-2 text-primary"></i> Staff Dashboard
                </h2>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        {# ── Operational KPI Row ── #}
        <div class="row g-3 mb-4" id="op-kpi-row">
            <div class="col-6 col-md-3">
                <div class="card kpi-card p-3 position-relative h-100">
                    <div class="kpi-icon mb-2" style="background:rgba(13,148,136,0.1);color:#0d9488;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="kpi-value" style="font-size:1.8rem;">{{ staff_count }}</div>
                    <div class="kpi-label mt-1">Total Staffs</div>
                    <div class="kpi-strip" style="background:#0d9488;"></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card p-3 position-relative h-100">
                    <div class="kpi-icon mb-2" style="background:rgba(245,158,11,0.1);color:#f59e0b;">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                    <div class="kpi-value" style="font-size:1.8rem;">{{ leave_requests_count }}</div>
                    <div class="kpi-label mt-1">Pending Leaves</div>
                    <div class="kpi-strip" style="background:#f59e0b;"></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card p-3 position-relative h-100">
                    <div class="kpi-icon mb-2" style="background:rgba(59,130,246,0.1);color:#3b82f6;">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="kpi-value" style="font-size:1.8rem;">{{ attendance_count }}</div>
                    <div class="kpi-label mt-1">Attendance</div>
                    <div class="kpi-strip" style="background:#3b82f6;"></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card p-3 position-relative h-100">
                    <div class="kpi-icon mb-2" style="background:rgba(16,185,129,0.1);color:#10b981;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="kpi-value" style="font-size:1.8rem;">{{ staff_on_duty }}</div>
                    <div class="kpi-label mt-1">Staff On Duty</div>
                    <div class="kpi-strip" style="background:#10b981;"></div>
                </div>
            </div>
        </div>

        {# ── Shift timer bar ── #}
        <div class="card mb-4 p-3 shadow-sm border-0" style="background:linear-gradient(135deg, #1e293b 0%, #0f172a 100%);color:#f8fafc; border-radius: 12px;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;opacity:0.7;">Current Shift</div>
                    <div style="font-size:1.1rem;font-weight:700;">{{ current_shift }}</div>
                </div>
                <div class="text-center">
                    <div style="font-size:0.72rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Elapsed</div>
                    <div id="shiftTimer" style="font-size:1.75rem;font-weight:800;font-variant-numeric:tabular-nums; color: #38bdf8;">00:00:00</div>
                </div>
                <div class="d-flex gap-2">
                    {% if is_granted('ROLE_MANAGER') and not is_granted('ROLE_SUB_ADMIN') %}
                        <button class="btn btn-sm btn-success fw-bold" id="clockInBtn">
                            <i class="fa-solid fa-clock me-1"></i> Clock In
                        </button>
                        <button class="btn btn-sm btn-outline-light">
                            <i class="fa-solid fa-plane-departure me-1"></i> Request Leave
                        </button>
                    {% endif %}
                    <button class="btn btn-sm" style="background:rgba(239,68,68,0.2);color:#fca5a5;border:none;">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Report Issue
                    </button>
                </div>
            </div>
        </div>

        {# ── Charts and Main Layout ── #}
        <div class="row g-4 mb-4">
            {# Left Column: Charts and Logs #}
            <div class="col-lg-8">
                
                <div class="card mb-4 border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3">
                        <h6 class="section-title fw-bold mb-0"><i class="fa-solid fa-chart-line text-primary me-2"></i> Attendance Overview</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="attendanceChart" height="100"></canvas>
                    </div>
                </div>

                {# Shift Handover Notes #}
                <div class="card mb-4 border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3">
                        <h6 class="section-title fw-bold mb-0"><i class="fa-solid fa-comments text-info me-2"></i> Shift Handover Log</h6>
                    </div>
                    <div class="card-body">
                        <div class="chat-log" style="max-height: 250px; overflow-y: auto;">
                            {% for note in shift_notes|default([]) %}
                            <div class="mb-3">
                                <div class="chat-bubble {{ note.sender }} p-2 rounded-3 shadow-sm d-inline-block" style="background: {% if note.sender=='staff' %}#f1f5f9{% else %}#e0f2fe{% endif %}; max-width: 80%;">
                                    {{ note.msg }}
                                </div>
                                <div style="font-size:0.7rem;color:#94a3b8;margin-top:4px;{% if note.sender=='staff' %}text-align:right;{% endif %}">
                                    <strong>{{ note.name }}</strong> &bull; {{ note.time }}
                                </div>
                            </div>
                            {% else %}
                                <div class="text-center text-muted py-4">
                                    <i class="fa-solid fa-ghost fs-3 mb-2 text-secondary opacity-25"></i><br>
                                    No handover notes.
                                </div>
                            {% endfor %}
                        </div>
                        
                        {% if is_granted('ROLE_MANAGER') and not is_granted('ROLE_SUB_ADMIN') %}
                        <div class="d-flex gap-2 mt-3 pt-3 border-top">
                            <input type="text" class="form-control form-control-sm" placeholder="Add a shift note…" id="shiftNoteInput">
                            <button class="btn btn-sm btn-primary" style="white-space:nowrap;">Send</button>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Right Column: Tasks, Checklist, Announcements #}
            <div class="col-lg-4">
                
                {# Today's Task List #}
                {% set doneCount = 0 %}
                {% for t in task_list|default([]) %}{% if t.done %}{% set doneCount = doneCount + 1 %}{% endif %}{% endfor %}
                <div class="card mb-4 border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 d-flex align-items-center justify-content-between">
                        <h6 class="section-title fw-bold mb-0"><i class="fa-solid fa-list-check text-success me-2"></i> Today's Tasks</h6>
                        <span class="badge bg-light text-secondary border">{{ doneCount }} / {{ task_list|length }} done</span>
                    </div>
                    <div class="card-body pt-0">
                        <div class="progress mb-3 bg-light" style="height:6px; border-radius:3px;">
                            <div class="progress-bar bg-success" style="width:{{ (task_list|length > 0) ? (doneCount / task_list|length * 100)|round : 0 }}%;"></div>
                        </div>
                        {% for task in task_list|default([]) %}
                        <div class="task-item {{ task.done ? 'done' : '' }} d-flex align-items-start mb-2">
                            <i class="fa-solid {{ task.done ? 'fa-circle-check text-success' : 'fa-circle text-muted opacity-25' }} mt-1 me-2" style="font-size:0.9rem; flex-shrink:0;"></i>
                            <span style="font-size:0.95rem; {{ task.done ? 'text-decoration: line-through; color: #94a3b8;' : 'color: #334155;' }}">{{ task.label }}</span>
                        </div>
                        {% else %}
                            <div class="text-center text-muted py-3">No assigned tasks.</div>
                        {% endfor %}
                    </div>
                </div>

                {# Safety Checklist #}
                {% set safeOk = 0 %}
                {% for s in safety_checklist|default([]) %}{% if s.ok %}{% set safeOk = safeOk + 1 %}{% endif %}{% endfor %}
                <div class="card mb-4 border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 d-flex align-items-center justify-content-between">
                        <h6 class="section-title fw-bold mb-0"><i class="fa-solid fa-shield-halved text-danger me-2"></i> Safety Checklist</h6>
                        <span class="badge bg-light text-secondary border">{{ safeOk }} / {{ safety_checklist|length }}</span>
                    </div>
                    <div class="card-body pt-0">
                        {% for item in safety_checklist|default([]) %}
                        <div class="task-item {{ item.ok ? 'done' : '' }} d-flex align-items-start mb-2">
                            <i class="fa-solid {{ item.ok ? 'fa-circle-check text-success' : 'fa-circle-xmark text-danger' }} mt-1 me-2" style="font-size:0.9rem; flex-shrink:0;"></i>
                            <span style="font-size:0.95rem; color: #334155;">{{ item.label }}</span>
                        </div>
                        {% else %}
                            <div class="text-center text-muted py-3">Checklist complete.</div>
                        {% endfor %}
                    </div>
                </div>

                {# Sticky Notes / Announcements #}
                <div class="card mb-4 border-0 shadow-sm rounded-3 bg-gradient" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
                    <div class="card-body">
                        <h6 class="card-title fw-bold text-warning-emphasis mb-3"><i class="fa-solid fa-bullhorn me-2 text-warning"></i> Announcements</h6>
                        <div class="mb-3 pb-2 border-bottom border-warning border-opacity-25" style="font-size: 0.95rem; color: #78350f;">
                            <span class="badge bg-danger mb-1">HOT</span><br>
                            Price change at 00:00 — update boards!
                        </div>
                        <div style="font-size: 0.95rem; color: #78350f;">
                            <span class="badge bg-primary mb-1">Reminder</span><br>
                            Filter change due this Friday.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    // Timer logic
    const timerEl = document.getElementById('shiftTimer');
    let seconds = 0;
    if (timerEl) {
        setInterval(() => {
            seconds++;
            const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            timerEl.textContent = `${h}:${m}:${s}`;
        }, 1000);
    }

    // Chart logic
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('attendanceChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Attendance Rate %',
                        data: [95, 98, 92, 100, 96, 90, 85],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: false, min: 70, max: 100, grid: { borderDash: [4, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    });
</script>
{% endblock %}
