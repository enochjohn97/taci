{# templates/pos/transactions.html.twig #}
{% extends "base.html.twig" %}

{% block title %}POS Transactions – {{ app_name }}{% endblock %}

{% block content %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title mt-4">
                    <i class="fa-solid fa-credit-card me-2"></i>POS Transactions
                </h2>
                <p class="text-muted mt-2">View all digital transactions processed through Paystack (Card, Transfer, etc.)</p>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h3 class="card-title text-dark">Transaction History</h3>
            </div>
            <div class="table-responsive p-0">
                <table class="table table-vcenter card-table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Reference</th>
                            <th>Source</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tx in transactions %}
                            <tr>
                                <td class="text-muted">
                                    <i class="fa-regular fa-clock me-1"></i> {{ tx.date|date('M d, Y h:i A') }}
                                </td>
                                <td><span class="text-muted font-monospace" style="font-size: 0.85rem;">{{ tx.reference }}</span></td>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ tx.source }}</span>
                                </td>
                                <td>
                                    {% if tx.method == 'card' %}
                                        <i class="fa-regular fa-credit-card text-primary me-1"></i> Card
                                    {% elseif tx.method == 'transfer' %}
                                        <i class="fa-solid fa-money-bill-transfer text-success me-1"></i> Transfer
                                    {% else %}
                                        <i class="fa-solid fa-money-check text-info me-1"></i> {{ tx.method|capitalize }}
                                    {% endif %}
                                </td>
                                <td class="fw-bold text-dark">₦{{ tx.amount|number_format(2) }}</td>
                                <td>
                                    {% if tx.status == 'completed' or tx.status == 'success' %}
                                        <span class="badge bg-success-lt text-success"><i class="fa-solid fa-check me-1"></i> Success</span>
                                    {% elseif tx.status == 'pending' %}
                                        <span class="badge bg-warning-lt text-warning"><i class="fa-solid fa-hourglass-half me-1"></i> Pending</span>
                                    {% elseif tx.status == 'failed' or tx.status == 'declined' or tx.status == 'cancelled' %}
                                        <span class="badge bg-danger-lt text-danger"><i class="fa-solid fa-xmark me-1"></i> Failed</span>
                                    {% else %}
                                        <span class="badge bg-secondary-lt text-secondary">{{ tx.status|capitalize }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="fa-solid fa-inbox fa-3x mb-3 text-light"></i><br>
                                    No digital transactions found.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-muted text-center pt-3 pb-3 border-top-0">
                <small><i class="fa-solid fa-info-circle me-1"></i> Statuses are updated automatically by Paystack webhooks when money enters the account.</small>
            </div>
        </div>
    </div>
</div>

<style>
/* POS Transactions Custom Styles */
.bg-success-lt { background-color: rgba(16, 185, 129, 0.1) !important; }
.bg-warning-lt { background-color: rgba(245, 158, 11, 0.1) !important; }
.bg-danger-lt { background-color: rgba(239, 68, 68, 0.1) !important; }
.bg-secondary-lt { background-color: rgba(108, 117, 125, 0.1) !important; }

.badge {
    padding: 0.5em 0.75em;
    font-weight: 600;
    letter-spacing: 0.02em;
}
</style>
{% endblock %}
