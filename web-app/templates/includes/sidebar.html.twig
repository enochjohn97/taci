{# templates/includes/sidebar.html.twig #}
{% set roleColor = '#0d6efd' %}
{% if is_granted('ROLE_SUPER_ADMIN') %}
    {% set roleColor = '#0d9488' %}
{% elseif is_granted('ROLE_SUB_ADMIN') %}
    {% set roleColor = '#7f1d1d' %}
{% elseif is_granted('ROLE_MANAGER') %}
    {% set roleColor = '#14532d' %}
{% elseif is_granted('ROLE_STAFF') %}
    {% set roleColor = '#1e3a8a' %}
{% endif %}

<nav class="sidebar sticky-top p-3" style="width: 250px; min-height: 100vh;">
    <div class="mb-4">
        <h5 class="text-white mb-3">
            <i class="bi bi-fuel-pump"></i> {{ app_name }}
        </h5>
    </div>

    <ul class="nav flex-column">
        {# Overview Dashboard #}
        <li class="nav-item">
            <a class="nav-link {% if app.request.get('_route') starts with 'app_dashboard' %}active{% endif %}" 
               href="{{ path('app_dashboard') }}">
                <i class="bi bi-speedometer2"></i> Overview
            </a>
        </li>

        {# Fuel Management (Super/Sub Admin/Manager) #}
        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_SUB_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_fuel' %}active{% endif %}" 
                   data-bs-toggle="collapse" href="#fuelMenu">
                    <i class="bi bi-droplet-fill"></i> Fuel Management
                    <i class="bi bi-chevron-down float-end"></i>
                </a>
                <div class="collapse {% if app.request.get('_route') starts with 'app_fuel' %}show{% endif %}" id="fuelMenu">
                    <ul class="nav flex-column ms-3">
                        <li><a class="nav-link" href="{{ path('app_fuel_dashboard') }}">Dashboard</a></li>
                        <li><a class="nav-link" href="{{ path('app_fuel_entry_new') }}">Log Fuel Entry</a></li>
                        <li><a class="nav-link" href="{{ path('app_fuel_price_history') }}">Price History</a></li>
                    </ul>
                </div>
            </li>
        {% endif %}

        {# Inventory (All business roles) #}
        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_SUB_ADMIN') or is_granted('ROLE_MANAGER') or is_granted('ROLE_STAFF') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_inventory' %}active{% endif %}" 
                   data-bs-toggle="collapse" href="#inventoryMenu">
                    <i class="bi bi-box-seam"></i> Inventory
                    <i class="bi bi-chevron-down float-end"></i>
                </a>
                <div class="collapse {% if app.request.get('_route') starts with 'app_inventory' %}show{% endif %}" id="inventoryMenu">
                    <ul class="nav flex-column ms-3">
                        <li><a class="nav-link" href="{{ path('app_inventory_dashboard') }}">Dashboard</a></li>
                        <li><a class="nav-link" href="{{ path('app_inventory_products') }}">Products</a></li>
                        {% if not is_granted('ROLE_STAFF') %}
                            <li><a class="nav-link" href="{{ path('app_inventory_alerts') }}">Low Stock Alerts</a></li>
                            <li><a class="nav-link" href="{{ path('app_inventory_audit') }}">Audit Trail</a></li>
                        {% else %}
                            <li><a class="nav-link" href="{{ path('app_receptionist') }}">Receptionist</a></li>
                        {% endif %}
                    </ul>
                </div>
            </li>
        {% endif %}

        {# POS/Store (All roles) #}
        <li class="nav-item">
            <a class="nav-link {% if app.request.get('_route') starts with 'app_pos' %}active{% endif %}" 
               data-bs-toggle="collapse" href="#posMenu">
                <i class="bi bi-cash-register"></i> POS
                <i class="bi bi-chevron-down float-end"></i>
            </a>
            <div class="collapse {% if app.request.get('_route') starts with 'app_pos' %}show{% endif %}" id="posMenu">
                <ul class="nav flex-column ms-3">
                    <li><a class="nav-link" href="{{ path('app_pos_dashboard') }}">Dashboard</a></li>
                    <li><a class="nav-link" href="{{ path('app_pos_register') }}">Register</a></li>
                    <li><a class="nav-link" href="{{ path('app_pos_daily_summary') }}">Daily Summary</a></li>
                </ul>
            </div>
        </li>

        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_MANAGER') or is_granted('ROLE_STAFF') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_engagement' %}active{% endif %}"
                   data-bs-toggle="collapse" href="#engagementMenu">
                    <i class="bi bi-gem"></i> Customer Rewards
                    <i class="bi bi-chevron-down float-end"></i>
                </a>
                <div class="collapse {% if app.request.get('_route') starts with 'app_engagement' %}show{% endif %}" id="engagementMenu">
                    <ul class="nav flex-column ms-3">
                        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_MANAGER') %}
                            <li><a class="nav-link" href="{{ path('app_engagement_dashboard') }}">Hub Dashboard</a></li>
                            <li><a class="nav-link" href="{{ path('app_engagement_tiers') }}">Reward Tiers</a></li>
                        {% endif %}
                        <li><a class="nav-link" href="{{ path('app_engagement_wallet') }}">My Wallet</a></li>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <li><a class="nav-link" href="{{ path('app_engagement_promotions') }}">Promotions</a></li>
                            <li><a class="nav-link" href="{{ path('app_engagement_reports') }}">Reports</a></li>
                        {% endif %}
                    </ul>
                </div>
            </li>
        {% endif %}

        <li class="nav-item">
            <a class="nav-link {% if app.request.get('_route') starts with 'app_memo' %}active{% endif %}" 
               data-bs-toggle="collapse" href="#memoMenu">
                <i class="bi bi-envelope"></i> Memos
                <i class="bi bi-chevron-down float-end"></i>
            </a>
            <div class="collapse {% if app.request.get('_route') starts with 'app_memo' %}show{% endif %}" id="memoMenu">
                <ul class="nav flex-column ms-3">
                    <li><a class="nav-link" href="{{ path('app_memo_dashboard') }}">Dashboard</a></li>
                    <li><a class="nav-link" href="{{ path('app_memo_new') }}">New Memo</a></li>
                </ul>
            </div>
        </li>

        {# Reports (Super/Sub Admin/Manager) #}
        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_SUB_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_reports' %}active{% endif %}" 
                   data-bs-toggle="collapse" href="#reportsMenu">
                    <i class="bi bi-graph-up"></i> Reports
                    <i class="bi bi-chevron-down float-end"></i>
                </a>
                <div class="collapse {% if app.request.get('_route') starts with 'app_reports' %}show{% endif %}" id="reportsMenu">
                    <ul class="nav flex-column ms-3">
                        <li><a class="nav-link" href="{{ path('app_reports_dashboard') }}">Dashboard</a></li>
                        <li><a class="nav-link" href="{{ path('app_reports_sales') }}">Sales</a></li>
                        <li><a class="nav-link" href="{{ path('app_reports_inventory') }}">Inventory</a></li>
                        <li><a class="nav-link" href="{{ path('app_reports_profit_loss') }}">Profit/Loss</a></li>
                    </ul>
                </div>
            </li>
        {% endif %}

        {# Tracking (Super/Sub Admin/Manager) #}
        {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_SUB_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_tracking' %}active{% endif %}" 
                   href="{{ path('app_tracking') }}">
                    <i class="bi bi-geo-alt-fill"></i> Tracking
                </a>
            </li>
        {% endif %}
    </ul>

</nav>

<style>
.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 250px;
    height: 100vh;
    overflow-y: auto;
    z-index: 100;
    background-color: {{ roleColor }};
}

.sidebar .nav-link {
    color: rgba(255, 255, 255, 0.7);
    border-radius: 5px;
    transition: all 0.3s;
}

.sidebar .nav-link:hover,
.sidebar .nav-link.active {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
}

.sidebar .nav-link.active {
    background-color: rgba(255, 255, 255, 0.25);
} 

@media (max-width: 768px) {
    .sidebar {
        width: 200px;
    }
}
</style>
