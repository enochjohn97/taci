<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_dashboard') }}">
            <i class="bi bi-droplet-fill me-2"></i>
            <span>{{ app_name }}</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar" aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topNavbar">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">

                {# Notification Bell #}
                <li class="nav-item me-2">
                    <a class="nav-link position-relative" href="{{ path('app_notifications') }}" title="Notifications">
                        <i class="bi bi-bell-fill fs-5"></i>
                        <span id="nav-notification-badge-container">
                            {% if unread_notifications_count is defined and unread_notifications_count > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                    {{ unread_notifications_count > 99 ? '99+' : unread_notifications_count }}
                                </span>
                            {% endif %}
                        </span>
                    </a>
                </li>

                {# User Profile Dropdown #}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar avatar-sm rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                            <i class="bi bi-person-fill text-white" style="font-size:1rem;"></i>
                        </div>
                        <span class="d-none d-md-inline">{{ app.user.username }}</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-semibold text-dark">{{ app.user.username }}</div>
                            <div class="small text-muted">{{ app.user.email }}</div>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_settings_profile') }}">
                                <i class="bi bi-person me-2 text-secondary"></i> My Profile
                            </a>
                        </li>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_delegates_index') }}">
                                    <i class="bi bi-people me-2 text-secondary"></i> Delegates
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_settings_admin') }}">
                                    <i class="bi bi-shield-lock me-2 text-secondary"></i> Admin Panel
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_settings_audit_log') }}">
                                    <i class="bi bi-journal-text me-2 text-secondary"></i> Audit Log
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_settings_sub_admins') }}">
                                    <i class="bi bi-person-badge me-2 text-secondary"></i> Sub-Admins
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_settings_system_info') }}">
                                    <i class="bi bi-cpu me-2 text-secondary"></i> System Info
                                </a>
                            </li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', () => {
    fetch('{{ path("app_notifications_unread_count") }}')
        .then(res => res.json())
        .then(data => {
            if (data && typeof data.unread_count !== 'undefined' && data.unread_count > 0) {
                const container = document.getElementById('nav-notification-badge-container');
                if (container) {
                    const badgeText = data.unread_count > 99 ? '99+' : data.unread_count;
                    container.innerHTML = `
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                            \${badgeText}
                        </span>
                    `;
                }
            }
        })
        .catch(err => console.error('Error fetching notification count:', err));
});
</script>
