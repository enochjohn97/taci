{% extends 'base.html.twig' %}

{% block title %}Low Stock Alerts{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Low Stock Alerts</h2>
            <p class="text-muted">Products that have reached or fallen below their reorder levels</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Product</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Category</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Current Stock</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Reorder Level</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Status</th>
                            <th class="px-4 py-3 text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr>
                                <td class="px-4 py-3 fw-bold">{{ product.name }}</td>
                                <td class="px-4 py-3 text-muted">{{ product.category }}</td>
                                <td class="px-4 py-3 text-danger fw-bold fs-5">{{ product.stockQuantity }}</td>
                                <td class="px-4 py-3 text-muted">{{ product.reorderLevel }}</td>
                                <td class="px-4 py-3">
                                    {% if product.stockQuantity == 0 %}
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Out of Stock</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Low Stock</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <a href="{{ path('app_inventory_product_view', {'id': product.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Details</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-5 text-center">
                                    <i class="bi bi-check-circle-fill text-success display-1 d-block mb-3 opacity-50"></i>
                                    <h4 class="text-muted">All clear!</h4>
                                    <p class="text-muted">No products are currently low on stock.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
