{% extends 'base.html.twig' %}

{% block title %}Product Details - {{ product.name }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark mb-0">
                <a href="{{ path('app_inventory_products') }}" class="text-muted me-2"><i class="bi bi-arrow-left-circle"></i></a>
                {{ product.name }}
            </h2>
            <p class="text-muted mb-0 ms-5">Barcode: {{ product.barcode }} | Category: {{ product.category }}</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
                <i class="bi bi-plus-slash-minus me-2"></i>Adjust Stock
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Current Stock</h6>
                    <div class="d-flex align-items-center mb-3">
                        <div class="display-3 fw-bold me-3 text-{% if product.stockQuantity <= product.reorderLevel %}danger{% else %}success{% endif %}">
                            {{ product.stockQuantity }}
                        </div>
                        <div>
                            <span class="badge bg-light text-dark border">Units Available</span><br>
                            <small class="text-muted">Reorder Level: {{ product.reorderLevel }}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">Pricing Info</h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Unit Price</span>
                        <span class="fw-bold fs-5">${{ product.unitPrice|number_format(2) }}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Cost Price</span>
                        <span class="fw-bold fs-5">${{ product.costPrice|number_format(2) }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-3">Total Value</h6>
                    <div class="display-5 fw-bold">${{ (product.stockQuantity * (product.costPrice ?: product.unitPrice))|number_format(2) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <h5 class="fw-bold mb-0">Recent Activity</h5>
        </div>
        <div class="card-body p-0 mt-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Date</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Action</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Quantity</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">User</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td class="px-4 py-3 text-muted small">{{ log.timestamp|date('Y-m-d H:i') }}</td>
                                <td class="px-4 py-3">
                                    <span class="badge rounded-pill {% if log.actionType == 'in' %}bg-success{% elseif log.actionType == 'out' %}bg-danger{% else %}bg-warning text-dark{% endif %}">
                                        {{ log.actionType|upper }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 fw-bold">{{ log.quantityChanged }}</td>
                                <td class="px-4 py-3">{{ log.performedBy ? log.performedBy.username : 'System' }}</td>
                                <td class="px-4 py-3 text-muted small">{{ log.notes }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="px-4 py-4 text-center text-muted">No recent activity.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Adjust Stock: {{ product.name }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="adjustForm">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Quantity to Adjust (use negative to reduce)</label>
                        <input type="number" class="form-control form-control-lg bg-light border-0" id="adjustQuantity" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Notes / Reason</label>
                        <textarea class="form-control form-control-lg bg-light border-0" id="adjustNotes" rows="2"></textarea>
                    </div>
                    <button type="button" onclick="submitAdjustment()" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">Submit Adjustment</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function submitAdjustment() {
    const qty = document.getElementById('adjustQuantity').value;
    const notes = document.getElementById('adjustNotes').value;
    
    if(!qty) return alert('Enter a quantity');

    fetch(`{{ path('app_inventory_adjust', {'id': product.id}) }}`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({quantity: parseInt(qty), notes: notes})
    })
    .then(r => r.json())
    .then(data => {
        if(data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to adjust stock');
        }
    });
}
</script>
{% endblock %}
