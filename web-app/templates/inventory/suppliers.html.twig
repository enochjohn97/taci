{# templates/inventory/suppliers.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Suppliers - {{ app_name }}{% endblock %}

{% block content %}
<div class="page-header d-print-none mb-4">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <div class="mb-1">
                    <ol class="breadcrumb" aria-label="breadcrumbs">
                        <li class="breadcrumb-item"><a href="{{ path('app_inventory_dashboard') }}">Inventory</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><a href="#">Suppliers</a></li>
                    </ol>
                </div>
                <h2 class="page-title text-primary fw-bold">
                    <i class="bi bi-truck me-2"></i> Suppliers
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="d-flex gap-2">
                    {% if is_granted('ROLE_MANAGER') and not is_granted('ROLE_SUB_ADMIN') %}
                    <button class="btn btn-primary shadow-sm hover-elevate" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
                        <i class="bi bi-plus-lg me-2"></i> New Supplier
                    </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper">
    <div class="container-xl">
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-uppercase fw-bold text-muted small mb-1">Total Suppliers</div>
                                <div class="h2 mb-0 fw-bold text-dark">{{ total|default(0) }}</div>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                                <i class="bi bi-people-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-uppercase fw-bold text-muted small mb-1">Active Deliveries</div>
                                <div class="h2 mb-0 fw-bold text-success">{{ active_deliveries|default(0) }}</div>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                                <i class="bi bi-truck fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0" style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-uppercase fw-bold text-muted small mb-1">Pending Invoices</div>
                                <div class="h2 mb-0 fw-bold text-warning">{{ pending_invoices|default(0) }}</div>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                                <i class="bi bi-file-earmark-text fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-white" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">All Suppliers</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bg-white custom-table" id="suppliersTable">
                    <thead class="table-light text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4">Supplier Name</th>
                            <th>Contact Info</th>
                            <th>Address</th>
                            <th>Fuel / Product Types</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for s in suppliers %}
                        <tr data-id="{{ s.id }}">
                            <td class="ps-4 fw-bold">
                                <a href="{{ path('inventory_supplier_view', {'id': s.id}) }}" class="text-decoration-none text-dark hover-primary">{{ s.name }}</a>
                            </td>
                            <td>{{ s.contact ?: '<span class="text-muted small">N/A</span>'|raw }}</td>
                            <td><span class="text-muted small">{{ s.address ?: 'N/A' }}</span></td>
                            <td>
                                {% if s.fuelTypes %}
                                    <span class="badge bg-light text-secondary border px-2 py-1">{{ s.fuelTypes }}</span>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                            <td class="pe-4 text-end">
                                {% if is_granted('ROLE_MANAGER') and not is_granted('ROLE_SUB_ADMIN') %}
                                <button class="btn btn-sm btn-light border rounded-pill px-3 edit-supplier-btn hover-elevate" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 ms-2 delete-supplier-btn hover-elevate" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-light"></i>
                                No suppliers found in the database.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <nav class="mt-4" aria-label="Suppliers pagination">
            <ul class="pagination justify-content-end">
                {% set prev = page - 1 %}
                <li class="page-item {% if page <= 1 %}disabled{% endif %}"><a class="page-link shadow-sm border-0 rounded-start-pill" href="?page={{ prev }}">Previous</a></li>
                {% for p in 1..(last|default(1)) %}
                    <li class="page-item {% if p == page %}active{% endif %}"><a class="page-link shadow-sm border-0" href="?page={{ p }}">{{ p }}</a></li>
                {% endfor %}
                <li class="page-item {% if page >= (last|default(1)) %}disabled{% endif %}"><a class="page-link shadow-sm border-0 rounded-end-pill" href="?page={{ page + 1 }}">Next</a></li>
            </ul>
        </nav>
    </div>
</div>

<!-- Create/Edit Supplier Modal -->
<div class="modal fade" id="createSupplierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Supplier</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="supplierForm">
        <div class="modal-body">
          <input type="hidden" name="id" value="">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Contact</label>
            <input name="contact" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Address</label>
            <textarea name="address" class="form-control" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Fuel Types (comma-separated)</label>
            <input name="fuelTypes" class="form-control">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const supplierForm = document.getElementById('supplierForm');
  const modalEl = document.getElementById('createSupplierModal');
  const bsModal = new bootstrap.Modal(modalEl);

  // handle create/edit submit
  supplierForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const fd = new FormData(supplierForm);
    const id = fd.get('id');
    const url = id ? `/inventory/supplier/${id}/edit` : '/inventory/supplier/new';
    try {
      const res = await fetch(url, { method: 'POST', body: fd });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed');
      toast.success('Supplier saved');
      // reload
      window.location.reload();
    } catch (err) {
      toast.error('Failed to save supplier: ' + err.message);
    }
  });

  // Edit button
  document.querySelectorAll('.edit-supplier-btn').forEach(btn => btn.addEventListener('click', function() {
    const tr = this.closest('tr');
    const id = tr.dataset.id;
    const name = tr.children[0].textContent.trim();
    const contact = tr.children[1].textContent.trim();
    const address = tr.children[2].textContent.trim();
    const fuelTypes = tr.children[3].textContent.trim();
    supplierForm['id'].value = id;
    supplierForm['name'].value = name;
    supplierForm['contact'].value = contact;
    supplierForm['address'].value = address;
    supplierForm['fuelTypes'].value = fuelTypes;
    bsModal.show();
  }));

  document.querySelectorAll('.delete-supplier-btn').forEach(btn => btn.addEventListener('click', async function() {
    const isConfirmed = await Swal.fire({
      title: 'Are you sure?',
      text: 'Delete this supplier?',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      confirmButtonText: 'Yes, delete it!'
    }).then(r => r.isConfirmed);
    if (!isConfirmed) return;
    const tr = this.closest('tr');
    const id = tr.dataset.id;
    try {
      const res = await fetch(`/inventory/supplier/${id}/delete`, { method: 'POST' });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed');
      toast.success('Supplier deleted');
      tr.remove();
    } catch (err) {
      toast.error('Delete failed: ' + err.message);
    }
  }));
});
</script>

<style>
    .hover-elevate { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-elevate:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important; }
    .custom-table tbody tr { transition: background-color 0.2s ease; }
    .custom-table tbody tr:hover { background-color: rgba(13, 110, 253, 0.02); }
</style>

{% endblock %}
