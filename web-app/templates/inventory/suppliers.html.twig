{# templates/inventory/suppliers.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Suppliers - {{ app_name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Suppliers</h3>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSupplierModal">New Supplier</button>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover" id="suppliersTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Address</th>
            <th>Fuel Types</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for s in suppliers %}
          <tr data-id="{{ s.id }}">
            <td><a href="{{ path('inventory_supplier_view', {'id': s.id}) }}">{{ s.name }}</a></td>
            <td>{{ s.contact }}</td>
            <td>{{ s.address }}</td>
            <td>{{ s.fuelTypes }}</td>
            <td class="text-end">
              <button class="btn btn-sm btn-outline-secondary edit-supplier-btn">Edit</button>
              <button class="btn btn-sm btn-outline-danger ms-2 delete-supplier-btn">Delete</button>
            </td>
          </tr>
          {% else %}
          <tr><td colspan="5" class="text-center text-muted">No suppliers found.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<nav class="mt-3" aria-label="Suppliers pagination">
  <ul class="pagination justify-content-end">
    {% set prev = page - 1 %}
    <li class="page-item {% if page <= 1 %}disabled{% endif %}"><a class="page-link" href="?page={{ prev }}">Previous</a></li>
    {% for p in 1..(last|default(1)) %}
      <li class="page-item {% if p == page %}active{% endif %}"><a class="page-link" href="?page={{ p }}">{{ p }}</a></li>
    {% endfor %}
    <li class="page-item {% if page >= (last|default(1)) %}disabled{% endif %}"><a class="page-link" href="?page={{ page + 1 }}">Next</a></li>
  </ul>
</nav>

<!-- Create/Edit Supplier Modal -->
<div class="modal fade" id="createSupplierModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Supplier</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="supplierForm">
        <div class="modal-body">
          <input type="hidden" name="id" value="">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Contact</label>
            <input name="contact" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Address</label>
            <textarea name="address" class="form-control" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Fuel Types (comma-separated)</label>
            <input name="fuelTypes" class="form-control">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const supplierForm = document.getElementById('supplierForm');
  const modalEl = document.getElementById('createSupplierModal');
  const bsModal = new bootstrap.Modal(modalEl);

  // handle create/edit submit
  supplierForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const fd = new FormData(supplierForm);
    const id = fd.get('id');
    const url = id ? `/inventory/supplier/${id}/edit` : '/inventory/supplier/new';
    try {
      const res = await fetch(url, { method: 'POST', body: fd });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed');
      toast.success('Supplier saved');
      // reload
      window.location.reload();
    } catch (err) {
      toast.error('Failed to save supplier: ' + err.message);
    }
  });

  // Edit button
  document.querySelectorAll('.edit-supplier-btn').forEach(btn => btn.addEventListener('click', function() {
    const tr = this.closest('tr');
    const id = tr.dataset.id;
    const name = tr.children[0].textContent.trim();
    const contact = tr.children[1].textContent.trim();
    const address = tr.children[2].textContent.trim();
    const fuelTypes = tr.children[3].textContent.trim();
    supplierForm['id'].value = id;
    supplierForm['name'].value = name;
    supplierForm['contact'].value = contact;
    supplierForm['address'].value = address;
    supplierForm['fuelTypes'].value = fuelTypes;
    bsModal.show();
  }));

  // Delete button
  document.querySelectorAll('.delete-supplier-btn').forEach(btn => btn.addEventListener('click', async function() {
    if (!confirm('Delete this supplier?')) return;
    const tr = this.closest('tr');
    const id = tr.dataset.id;
    try {
      const res = await fetch(`/inventory/supplier/${id}/delete`, { method: 'POST' });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Failed');
      toast.success('Supplier deleted');
      tr.remove();
    } catch (err) {
      toast.error('Delete failed: ' + err.message);
    }
  }));
});
</script>

{% endblock %}
