{# templates/inventory/dashboard.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Inventory Dashboard – {{ app_name }}{% endblock %}

{% block content %}
<div class="page-header d-print-none mb-4">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary fw-bold" style="font-size: 1.75rem;">
                    <i class="bi bi-box-seam me-2"></i> Inventory Dashboard
                </h2>
                <div class="text-muted mt-1">Overview of your current stock, value, and recent activities.</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="d-flex gap-2">
                    <a href="{{ path('app_inventory_products') }}" class="btn btn-primary shadow-sm hover-elevate">
                        <i class="bi bi-list-ul me-2"></i> Manage Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-wrapper mt-4">
    <div class="container-xl">

        {# KPI Cards #}
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm border-0 shadow-sm kpi-card-premium p-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 16px;">
                    <div class="d-flex align-items-center">
                        <div class="kpi-icon-wrapper rounded-circle p-3 me-3" style="background: rgba(13, 110, 253, 0.1); color: #0d6efd;">
                            <i class="bi bi-box fs-2"></i>
                        </div>
                        <div>
                            <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Total Products</div>
                            <div class="h2 mb-0 fw-bold text-dark">{{ total_products }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm border-0 shadow-sm kpi-card-premium p-4" style="background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%); border-radius: 16px;">
                    <div class="d-flex align-items-center">
                        <div class="kpi-icon-wrapper rounded-circle p-3 me-3" style="background: rgba(220, 53, 69, 0.1); color: #dc3545;">
                            <i class="bi bi-exclamation-triangle fs-2"></i>
                        </div>
                        <div>
                            <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Low Stock Alerts</div>
                            <div class="h2 mb-0 fw-bold text-danger">{{ low_stock_count }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card card-sm border-0 shadow-sm kpi-card-premium p-4" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 16px;">
                    <div class="d-flex align-items-center">
                        <div class="kpi-icon-wrapper rounded-circle p-3 me-3" style="background: rgba(25, 135, 84, 0.1); color: #198754;">
                            <i class="bi bi-cash-coin fs-2"></i>
                        </div>
                        <div>
                            <div class="text-muted fw-semibold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Total Stock Value</div>
                            <div class="h2 mb-0 fw-bold text-success">₦{{ total_stock_value|number_format(0) }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Main Content #}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex align-items-center justify-content-between">
                        <h4 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i> Recently Added Products</h4>
                        <a href="{{ path('app_inventory_products') }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0 custom-table">
                            <thead class="table-light text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                <tr>
                                    <th class="ps-4">Product Name</th>
                                    <th>Category</th>
                                    <th>Stock Level</th>
                                    <th>Unit Price</th>
                                    <th class="pe-4 text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for product in products|slice(0, 8) %}
                                    <tr style="cursor: pointer; transition: background 0.2s;" onclick="window.location.href='{{ path('app_inventory_products') }}'">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar bg-light text-primary me-3 rounded" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="bi bi-box"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">{{ product.name }}</div>
                                                    <div class="text-muted small">{{ product.barcode }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border px-2 py-1">{{ product.category }}</span></td>
                                        <td>
                                            <div class="fw-bold {{ product.stockQuantity <= product.reorderLevel ? 'text-danger' : 'text-dark' }}">
                                                {{ product.stockQuantity }} units
                                            </div>
                                        </td>
                                        <td class="fw-semibold">₦{{ product.unitPrice|number_format(2) }}</td>
                                        <td class="pe-4 text-end">
                                            {% if product.stockQuantity <= product.reorderLevel %}
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2"><i class="bi bi-exclamation-circle me-1"></i> Low Stock</span>
                                            {% else %}
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> In Stock</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <div class="mb-3"><i class="bi bi-inbox fs-1 text-light"></i></div>
                                            No products found in the inventory.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                        <h4 class="card-title mb-0 fw-bold"><i class="bi bi-graph-up me-2 text-success"></i> Quick Actions</h4>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="d-grid gap-3">
                            <a href="{{ path('app_inventory_products') }}" class="btn btn-light text-start p-3 rounded-3 hover-elevate border d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded me-3"><i class="bi bi-search fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">Search Inventory</div>
                                    <div class="text-muted small">Find products quickly</div>
                                </div>
                            </a>
                            {% if is_granted('ROLE_MANAGER') and not is_granted('ROLE_SUB_ADMIN') %}
                            <a href="{{ path('app_inventory_product_new') }}" class="btn btn-light text-start p-3 rounded-3 hover-elevate border d-flex align-items-center">
                                <div class="bg-success bg-opacity-10 text-success p-2 rounded me-3"><i class="bi bi-plus-lg fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">Add New Product</div>
                                    <div class="text-muted small">Register a new item</div>
                                </div>
                            </a>
                            {% endif %}
                            <a href="{{ path('app_inventory_valuation') }}" class="btn btn-light text-start p-3 rounded-3 hover-elevate border d-flex align-items-center">
                                <div class="bg-warning bg-opacity-10 text-warning p-2 rounded me-3"><i class="bi bi-file-earmark-bar-graph fs-5"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">Valuation Report</div>
                                    <div class="text-muted small">View stock valuation</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white;">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-shield-check fs-1 text-success mb-3"></i>
                        <h5 class="fw-bold mb-2">Inventory Sync Active</h5>
                        <p class="text-muted small mb-0" style="color: #94a3b8 !important;">Your database is fully synced and up to date.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-elevate:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important;
    }
    .kpi-card-premium {
        transition: all 0.3s ease;
    }
    .kpi-card-premium:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,.05)!important;
    }
    .custom-table tbody tr:hover {
        background-color: rgba(0,0,0,.02);
    }
</style>
{% endblock %}
