{# templates/inventory/supplier-view.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Supplier - {{ supplier.name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">{{ supplier.name }}</h3>
    <div class="text-muted">Contact: {{ supplier.contact ?: 'N/A' }} &middot; Address: {{ supplier.address ?: 'N/A' }}</div>
  </div>
  <div>
    <a href="{{ path('inventory_suppliers_manage') }}" class="btn btn-light me-2">Back to Suppliers</a>
    <button class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#createDeliveryModal">Schedule Delivery</button>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">Create Invoice</button>
  </div>
</div>

<!-- Create Invoice Modal -->
<div class="modal fade" id="createInvoiceModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Invoice for {{ supplier.name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="createInvoiceForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Amount (NGN)</label>
            <input type="number" step="0.01" name="amount" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Reference</label>
            <input name="reference" class="form-control">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Create Delivery Modal -->
<div class="modal fade" id="createDeliveryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Schedule Delivery for {{ supplier.name }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="createDeliveryForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Scheduled At</label>
            <input type="datetime-local" name="scheduledAt" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Assigned Driver</label>
            <input name="assignedDriver" class="form-control">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Schedule</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Overview</div>
      <div class="card-body">
        <p><strong>Fuel Types:</strong> {{ supplier.fuelTypes ?: '—' }}</p>
        <p><strong>Created:</strong> {{ supplier.createdAt.format('Y-m-d H:i') }}</p>
        <p><strong>Last updated:</strong> {{ supplier.updatedAt.format('Y-m-d H:i') }}</p>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">Recent Deliveries</div>
      <div class="card-body">
        {% if deliveries is defined and deliveries|length > 0 %}
          <ul class="list-unstyled mb-0">
            {% for del in deliveries %}
              <li>
                <strong>{{ del.scheduledAt.format('Y-m-d H:i') }}</strong> — {{ del.status|capitalize }}
                {% if del.assignedDriver %} &middot; Driver: {{ del.assignedDriver }}{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="text-muted">No deliveries recorded yet.</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Invoices & Payments</div>
      <div class="card-body">
        {% if invoices is defined and invoices|length > 0 %}
          <ul class="list-unstyled mb-0">
            {% for inv in invoices %}
              <li class="d-flex justify-content-between align-items-center">
            <div>
              <strong>#{{ inv.id }}</strong> — {{ inv.amount }} NGN &middot; {{ inv.status|capitalize }}
              {% if inv.reference %} &middot; Ref: {{ inv.reference }}{% endif %}
              <div class="text-muted small">{{ inv.createdAt.format('Y-m-d H:i') }}</div>
            </div>
            <div>
              <a href="{{ path('inventory_supplier_invoice_pdf', {'supplierId': supplier.id, 'invoiceId': inv.id}) }}" class="btn btn-sm btn-outline-secondary me-2" target="_blank">PDF</a>
            </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="text-muted">No invoices yet. Use "Create Invoice" to start billing.</div>
        {% endif %}
      </div>

      <div class="card mt-3">
      <div class="card-header">Station Stock (Provided by supplier)</div>
      <div class="card-body text-muted">Integration with station stock view coming in phase-2.</div>
    </div>
  </div>
</div>

<script>
  (function(){
    const supplierId = {{ supplier.id }};

    const invoiceForm = document.getElementById('createInvoiceForm');
    if(invoiceForm){
      invoiceForm.addEventListener('submit', async function(e){
        e.preventDefault();
        const fd = new FormData(this);
        try{
          const res = await fetch(`/inventory/supplier/${supplierId}/invoice/new`, {
            method: 'POST',
            body: fd
          });
          const json = await res.json();
          if(!res.ok) throw new Error(json.error || 'Failed');
          // reload to show invoice
          location.reload();
        }catch(err){
          alert('Error creating invoice: ' + err.message);
        }
      });
    }

    const deliveryForm = document.getElementById('createDeliveryForm');
    if(deliveryForm){
      deliveryForm.addEventListener('submit', async function(e){
        e.preventDefault();
        const fd = new FormData(this);
        try{
          const res = await fetch(`/inventory/supplier/${supplierId}/delivery/new`, {
            method: 'POST',
            body: fd
          });
          const json = await res.json();
          if(!res.ok) throw new Error(json.error || 'Failed');
          location.reload();
        }catch(err){
          alert('Error scheduling delivery: ' + err.message);
        }
      });
    }
  })();
</script>

{% endblock %}
