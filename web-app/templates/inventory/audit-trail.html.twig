{% extends 'base.html.twig' %}

{% block title %}Inventory Audit Trail{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Audit Trail</h2>
            <p class="text-muted mb-0">Complete history of inventory movements and adjustments</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Time</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Product</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Action</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Qty Changed</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Stock After</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">User</th>
                            <th class="px-4 py-3 text-muted small fw-bold text-uppercase">Reference/Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td class="px-4 py-3 text-muted small">{{ log.timestamp|date('Y-m-d H:i') }}</td>
                                <td class="px-4 py-3 fw-bold"><a href="{{ path('app_inventory_product_view', {'id': log.product.id}) }}" class="text-decoration-none">{{ log.product.name }}</a></td>
                                <td class="px-4 py-3">
                                    <span class="badge rounded-pill {% if log.actionType == 'in' %}bg-success{% elseif log.actionType == 'out' %}bg-danger{% else %}bg-warning text-dark{% endif %} px-3">
                                        {{ log.actionType|upper }}
                                    </span>
                                </td>
                                <td class="px-4 py-3 fw-bold {% if log.actionType == 'in' %}text-success{% elseif log.actionType == 'out' %}text-danger{% endif %}">
                                    {% if log.actionType == 'in' %}+{% elseif log.actionType == 'out' %}-{% endif %}{{ log.quantityChanged }}
                                </td>
                                <td class="px-4 py-3">{{ log.stockAfter }}</td>
                                <td class="px-4 py-3">{{ log.performedBy ? log.performedBy.username : 'System' }}</td>
                                <td class="px-4 py-3 text-muted small">{{ log.reference }} {{ log.notes }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="px-4 py-5 text-center text-muted">No audit logs found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
