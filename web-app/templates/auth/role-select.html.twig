{# Role Selection Page #}
{% extends 'base.html.twig' %}

{% block title %}Select Role - TACI Petroleum{% endblock %}

{% block content %}
<div class="container-fluid role-selection-page">
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="role-selection-container">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold mb-3">
                    <svg class="logo-icon" viewBox="0 0 40 40" width="50" height="50" xmlns="http://www.w3.org/2000/svg">
                        <rect width="40" height="40" fill="#F5A623" opacity="0.1"/>
                        <path d="M20 5 L28 25 L20 35 L12 25 Z" fill="#F5A623"/>
                    </svg>
                    TACI Petroleum
                </h1>
                <p class="text-light fs-5">Select Your Role to Continue</p>
            </div>
            
            <div class="role-cards-grid">
                <!-- Super Admin Card -->
                <a href="{{ path('app_login', {'role': 'super-admin'}) }}" class="role-circle role-circle-admin" title="Super Admin">
                    <div class="role-circle-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div class="role-circle-label">Super Admin</div>
                </a>
                
                <!-- Sub Admin Card (Only if exists) -->
                {% if sub_admins_exist %}
                <a href="{{ path('app_login', {'role': 'sub-admin'}) }}" class="role-circle role-circle-subadmin" title="Sub Admin">
                    <div class="role-circle-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="role-circle-label">Sub Admin</div>
                </a>
                {% endif %}
                
                <!-- Manager Card -->
                <a href="{{ path('app_login', {'role': 'manager'}) }}" class="role-circle role-circle-manager" title="Manager">
                    <div class="role-circle-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="role-circle-label">Manager</div>
                </a>
                
                <!-- Staff Card -->
                <a href="{{ path('app_login', {'role': 'staff'}) }}" class="role-circle role-circle-staff" title="Staff">
                    <div class="role-circle-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="role-circle-label">Staff</div>
                </a>
            </div>
            
            <div class="text-center mt-5">
                <p class="text-muted">
                    Need help? <a href="mailto:postmail689@gmail.com" style="color: #fff;">Contact Support</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .role-selection-page {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        min-height: 100vh;
    }

    .role-selection-container {
        width: 100%;
        max-width: 900px;
        padding: 2rem;
    }
    
    .role-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 3.5rem;
        justify-items: center;
        margin: 3rem 0;
    }
    
    .role-circle {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        border: 3px solid transparent;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
        position: relative;
        overflow: hidden;
    }
    
    .role-circle::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, transparent 0%, rgba(0, 0, 0, 0.05) 100%);
        pointer-events: none;
    }
    
    .role-circle:hover {
        transform: translateY(-12px) scale(1.05);
        box-shadow: 0 16px 40px rgba(245, 166, 35, 0.25);
    }
    
    .role-circle-admin {
        border-color: #0d9488;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(13, 148, 136, 0.08) 100%);
    }
    
    .role-circle-admin:hover {
        border-color: #0f766e;
        background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(13, 148, 136, 0.14) 100%);
    }
    
    .role-circle-subadmin {
        border-color: #7f1d1d;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(127, 29, 29, 0.08) 100%);
    }
    
    .role-circle-subadmin:hover {
        border-color: #5f1515;
        background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(127, 29, 29, 0.14) 100%);
    }
    
    .role-circle-manager {
        border-color: #14532d;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(20, 83, 45, 0.08) 100%);
    }
    
    .role-circle-manager:hover {
        border-color: #0f3f23;
        background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(20, 83, 45, 0.14) 100%);
    }
    
    .role-circle-staff {
        border-color: #1e3a8a;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.97) 0%, rgba(30, 58, 138, 0.08) 100%);
    }
    
    .role-circle-staff:hover {
        border-color: #162c68;
        background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(30, 58, 138, 0.14) 100%);
    }
    
    .role-circle-icon {
        font-size: 3.5rem;
        margin-bottom: 0.5rem;
        z-index: 1;
    }
    
    .role-circle-admin .role-circle-icon {
        color: #0d9488;
    }
    
    .role-circle-subadmin .role-circle-icon {
        color: #7f1d1d;
    }
    
    .role-circle-manager .role-circle-icon {
        color: #14532d;
    }
    
    .role-circle-staff .role-circle-icon {
        color: #1e3a8a;
    }
    
    .role-circle-label {
        font-weight: 600;
        font-size: 0.95rem;
        color: #0f172a;
        text-align: center;
        z-index: 1;
        margin-top: 0.5rem;
    }
    
    @media (max-width: 768px) {
        .role-cards-grid {
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 2rem;
        }
        
        .role-circle {
            width: 180px;
            height: 180px;
        }
        
        .role-circle-icon {
            font-size: 3rem;
        }
        
        .role-circle-label {
            font-size: 0.95rem;
        }
    }
</style>
{% endblock %}
