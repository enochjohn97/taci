{# templates/auth/login.html.twig #}
{% extends "base.html.twig" %}
{% set role_primary = '#0d9488' %}
{% if role == 'super-admin' %}
    {% set role_primary = '#0A192F' %}
{% elseif role == 'sub-admin' %}
    {% set role_primary = '#3b82f6' %} {# Using blue since D0E8FF is too light for buttons #}
{% elseif role == 'manager' %}
    {% set role_primary = '#0F4C3A' %}
{% elseif role == 'staff' %}
    {% set role_primary = '#6B2E4A' %}
{% endif %}

{% block title %}{{ role_display }} Login - TACI Petroleum{% endblock %}

{% block content %}
<div class="login-page-wrapper" style="--role-color: {{ role_primary }};">
    <div class="login-card shadow-lg">
        <h2 class="login-title">Login</h2>
        
        <div class="px-2">
            {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert" data-toast-type="success">
                <strong>Success!</strong> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert" data-toast-type="error">
                <strong>Error!</strong> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert" data-toast-type="error">
                    <strong>Login Failed!</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}
        </div>

        <form method="post" id="login-form" action="{{ path('app_login', {'role': role}) }}" class="px-2 mt-4">
            
            <div class="mb-4 position-relative custom-input-group">
                <input type="text" 
                       id="username" 
                       name="username" 
                       class="form-control custom-input" 
                       value=""
                       autocomplete="off"
                       required 
                       autofocus
                       placeholder="Username">
                <i class="bi bi-person icon-right"></i>
            </div>

            <div class="mb-3 position-relative custom-input-group">
                <input type="password" 
                       id="password" 
                       name="password" 
                       class="form-control custom-input" 
                       autocomplete="new-password"
                       required
                       placeholder="Password">
                <i class="bi bi-key icon-right" style="cursor:pointer;" id="togglePasswordIcon"></i>
            </div>

            <div class="d-flex justify-content-start mb-5 ms-3">
                <a href="#" class="forgot-link text-muted small fw-medium">Forgot Password ?</a>
            </div>

            <div class="text-center mb-3">
                <button type="submit" class="btn login-btn">
                    Login
                </button>
            </div>
            <input type="hidden" name="role_attempt_id" id="role_attempt_id" value="">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </form>
        
        <div class="text-center mt-4">
            <a href="{{ path('app_role_select') }}" class="back-link small text-muted"><i class="bi bi-arrow-left"></i> Back to roles</a>
        </div>
    </div>
</div>
{% endblock %}

{% block styles %}
<style>
    .login-page-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8fafc;
        padding: 2rem;
        font-family: 'Inter', sans-serif;
    }

    .login-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 3.5rem 3.5rem 2.5rem 3.5rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        border-top: 5px solid var(--role-color);
    }

    .login-title {
        color: var(--role-color);
        font-weight: 500;
        font-size: 2.2rem;
        margin-bottom: 2rem;
        margin-left: 0.5rem;
        letter-spacing: -0.5px;
    }

    .custom-input-group {
        position: relative;
    }

    .custom-input {
        background-color: #f8fafc;
        border: none;
        border-radius: 99px; /* Pill shape */
        padding: 1.1rem 3rem 1.1rem 1.5rem;
        font-size: 1.05rem;
        color: #334155;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);
        transition: all 0.2s;
    }
    
    .custom-input:focus {
        background-color: #ffffff;
        box-shadow: 0 0 0 3px rgba(0,0,0,0.06), inset 0 2px 4px rgba(0,0,0,0.02);
        outline: none;
    }
    
    .custom-input::placeholder {
        color: #94a3b8;
    }

    .icon-right {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1.3rem;
        z-index: 10;
        transition: color 0.2s;
    }

    .custom-input:focus ~ .icon-right {
        color: var(--role-color);
    }

    .forgot-link {
        text-decoration: none;
        transition: color 0.2s;
    }
    .forgot-link:hover {
        color: var(--role-color) !important;
    }

    .login-btn {
        background-color: var(--role-color);
        color: white;
        border-radius: 99px;
        padding: 0.9rem 4rem;
        font-size: 1.2rem;
        font-weight: 500;
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
    }
    .login-btn:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        opacity: 0.95;
    }
    
    .back-link {
        text-decoration: none;
        transition: color 0.2s;
    }
    .back-link:hover {
        color: var(--role-color) !important;
    }
</style>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Enforce role_attempt_id
        const attemptId = sessionStorage.getItem('role_attempt_id');
        if (!attemptId) {
            window.location.href = "{{ path('app_role_select') }}";
            return;
        }
        document.getElementById('role_attempt_id').value = attemptId;

        // Password toggle
        const toggleIcon = document.getElementById('togglePasswordIcon');
        const passwordInput = document.getElementById('password');

        if (toggleIcon && passwordInput) {
            toggleIcon.addEventListener('click', function() {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                if(isPassword) {
                    this.classList.remove('bi-key');
                    this.classList.add('bi-unlock');
                } else {
                    this.classList.remove('bi-unlock');
                    this.classList.add('bi-key');
                }
            });
        }
    });
</script>
{% endblock %}
