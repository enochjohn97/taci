{# templates/auth/login.html.twig #}
{% extends "base.html.twig" %}

{% block title %}{{ role_display }} Login - TACI Petroleum{% endblock %}

{% block content %}
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg" style="width: 100%; max-width: 450px;">
        <div class="card-header bg-primary text-white text-center py-4">
            <h3 class="mb-0"><i class="bi bi-door-open"></i> {{ role_display }} Login</h3>
        </div>
        <div class="card-body p-5">
            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Login Failed!</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            <form method="post" id="login-form" action="{{ path('app_login', {'role': role}) }}">
                {% if has_delegates and role == 'super-admin' %}
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="delegateToggle">
                        <label class="form-check-label" for="delegateToggle">
                            Login as SubAdmin
                        </label>
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label id="username-label" for="username" class="form-label fw-bold">{{ role == 'super-admin' and delegateToggle == 'checked' ? 'SubAdmin Username' : 'Username' }}</label>
                    <input type="text" 
                           id="username" 
                           name="username" 
                           class="form-control form-control-lg" 
                           value="{{ last_username }}" 
                           required 
                           autofocus
                           placeholder="Enter your username">
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-bold">Password</label>
                    <input type="password" 
                           id="password" 
                           name="password" 
                           class="form-control form-control-lg" 
                           required
                           placeholder="Enter your password">
                </div>

                {% if role != 'super-admin' %}
                <div class="mb-3 form-check">
                    <input type="checkbox" 
                           class="form-check-input" 
                           id="remember_me" 
                           name="_remember_me">
                    <label class="form-check-label" for="remember_me">
                        Remember me
                    </label>
                </div>
                {% endif %}

                <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>

            <hr>

            <div class="text-center">
                <p class="text-muted mb-2">
                    <a href="{{ path('app_password_recovery') }}">Forgot your password?</a>
                </p>
                <p class="text-muted">
                    <small>
                        <a href="{{ path('app_role_select') }}">← Back to Role Selection</a>
                    </small>
                </p>
            </div>
        </div>
        <div class="card-footer text-center text-muted small py-3">
            <small>Contact your administrator to obtain access credentials.</small>
        </div>
    </div>
</div>
{% endblock %}

{% block styles %}
<style>
    .min-vh-100 {
        min-height: 100vh;
    }
    body {
        background: linear-gradient(135deg, #202c44 0%, #0a1628 100%);
    }
    .card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(10px);
    }
    .form-check-label {
        user-select: none;
    }
</style>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const delegateToggle = document.getElementById('delegateToggle');
        const usernameLabel = document.getElementById('username-label');
        const usernameInput = document.getElementById('username');

        if (!delegateToggle) {
            return;
        }

        function updateLoginMode() {
            if (delegateToggle.checked) {
                usernameLabel.textContent = 'SubAdmin Username';
                usernameInput.placeholder = 'Enter SubAdmin username';
            } else {
                usernameLabel.textContent = 'Username';
                usernameInput.placeholder = 'Enter your username';
            }
        }

        delegateToggle.addEventListener('change', updateLoginMode);
        updateLoginMode();
    });
</script>
{% endblock %}
