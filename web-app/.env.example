# TACI Petroleum Web App - Environment Configuration

# Application
APP_NAME=TACI
APP_ENV=dev
APP_SECRET=YOUR_RANDOM_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION
APP_DEBUG=true

# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/taci_petroleum_db?serverVersion=14&charset=utf8"

# Mailer Configuration (Gmail SMTP example)
MAILER_DSN=smtp://your_email@gmail.com:your_app_password@smtp.gmail.com:587?encryption=tls

# Payment Gateway - Paystack
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_API_URL=https://api.paystack.co

# Payment Gateway - Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_YOUR_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_YOUR_KEY
FLUTTERWAVE_API_URL=https://api.flutterwave.com

# Firebase Cloud Messaging (FCM) - Browser Push Notifications
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID

# Real-time Notifications - Mercure
MERCURE_URL=http://localhost:3000
MERCURE_PUBLIC_URL=http://localhost:3000
MERCURE_JWT_SECRET=YOUR_MERCURE_JWT_SECRET

# JWT Token Configuration
JWT_SECRET=YOUR_JWT_SECRET_KEY
JWT_EXPIRATION=86400

# Session Configuration
SESSION_TIMEOUT=1800 # 30 minutes in seconds
REMEMBER_ME_DURATION=2592000 # 30 days in seconds

# Security
CSRF_PROTECTION=true
SECURE_COOKIES=false # Set to true in production (HTTPS only)
ALLOWED_HOSTS=localhost,127.0.0.1,*.tacipetroleum.com

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW=900 # 15 minutes

# File Upload
MAX_FILE_SIZE=10485760 # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,xlsx,png,jpg,jpeg,gif
UPLOAD_DIR=public/uploads

# Features Toggle
ENABLE_BARCODE_SCANNING=true
ENABLE_PAYMENT_GATEWAY=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_AUDIT_LOGGING=true

# Email Notifications
SEND_EMAIL_ON_MEMO_APPROVAL=true
SEND_EMAIL_ON_LOW_STOCK=true
SEND_EMAIL_ON_PAYMENT_RECEIVED=true

# API Configuration
API_RATE_LIMIT=100 # requests per minute
API_PAGINATION_LIMIT=50

# Logging
LOG_LEVEL=info
LOG_FILE=var/log/app.log
AUDIT_LOG_FILE=var/log/audit.log

# Cache Configuration (Redis example)
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue/Jobs (for background processing)
MESSENGER_TRANSPORT_DSN=doctrine://default

# URLs
APP_URL=http://localhost:8000
ADMIN_EMAIL=admin@tacipetroleum.com
SUPPORT_EMAIL=support@tacipetroleum.com
